[9.25832, "o", "\"\"\"\r\nInternal Developer Portal web application with SSO integration.\r\n\"\"\"\r\nfrom flask import Flask, session, redirect, url_for, request, jsonify, render_template_string\r\nimport os\r\nfrom sso_portal import config\r\n\r\n\r\ndef create_app():\r\n    app = Flask(__name__)\r\n    app.secret_key = config.SECRET_KEY\r\n\r\n    @app.route(\"/\")\r\n    def index():\r\n        user = session.get(\"user\")\r\n        return render_template_string(\"\"\"\r\n        <!DOCTYPE html>\r\n        <html>\r\n        <head><title>Internal Developer Portal</title></head>\r\n        <body>\r\n            <h1>Welcome to the Developer Portal</h1>\r\n            {% if user %}\r\n                <p>Logged in as: <strong>{{ user.name }} ({{ user.email }})</strong></p>\r\n                <p><a href=\"/dashboard\">Go to Dashboard</a></p>\r\n                <form action=\"/auth/logout\" method=\"POST\"><button type=\"submit\">Log Out</button></form>\r\n            {% else %}\r\n                <p>Please log in using corporate Single Sign-On.</p>\r\n                <p><a href=\"/auth/login\" id=\"lo"]
[9.258351, "o", "gin-button\">Log In with Corporate SSO</a></p>\r\n            {% endif %}\r\n        </body>\r\n        </html>\r\n        \"\"\", user=user)\r\n\r\n    @app.route(\"/health\")\r\n    def health():\r\n        return jsonify({\"status\": \"ok\", \"app\": \"sso-portal\"})\r\n\r\n    @app.route(\"/dashboard\")\r\n    def dashboard():\r\n        user = session.get(\"user\")\r\n        if not user:\r\n            return redirect(url_for(\"auth_login\"))\r\n        return jsonify({\r\n            \"status\": \"authenticated\",\r\n            \"message\": \"Welcome to the internal dashboard\",\r\n            \"user\": user,\r\n        })\r\n\r\n    @app.route(\"/auth/logout\", methods=[\"POST\"])\r\n    def logout():\r\n        session.clear()\r\n        return redirect(url_for(\"index\"))\r\n\r\n    @app.route(\"/auth/login\", methods=[\"GET\"])\r\n    def auth_login():\r\n        \"\"\"\r\n        TODO: Implement SSO login initiation.\r\n        Direct unauthenticated users to the corporate Identity Provider authorization endpoint.\r\n        \"\"\"\r\n        return \"SSO login endpoint is not yet implemented.\", 501\r\n\r\n  "]
[9.258472, "o", "  @app.route(\"/auth/callback\", methods=[\"GET\"])\r\n    def auth_callback():\r\n        \"\"\"\r\n        TODO: Implement SSO authorization callback.\r\n        Validate the state parameter, exchange the received code for user tokens at the IdP token endpoint,\r\n        and establish the user session.\r\n        \"\"\"\r\n        return \"SSO callback endpoint is not yet implemented.\", 501\r\n\r\n    return app\r\n\r\n\r\ndef run():\r\n    app = create_app()\r\n    app.run(host=\"0.0.0.0\", port=config.PORT, debug=False)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    run()\r\n\r\n--- config ---\r\n"]
[9.25949, "o", "\"\"\"\r\nConfiguration for sso_portal.\r\n\"\"\"\r\nimport os\r\n\r\nIDP_BASE_URL = os.environ.get(\"IDP_BASE_URL\", \"http://127.0.0.1:8080\")\r\nIDP_AUTHORIZE_URL = f\"{IDP_BASE_URL}/oauth/authorize\"\r\nIDP_TOKEN_URL = f\"{IDP_BASE_URL}/oauth/token\"\r\n\r\nCLIENT_ID = os.environ.get(\"PORTAL_CLIENT_ID\", \"sso-portal\")\r\nCLIENT_SECRET = os.environ.get(\"PORTAL_CLIENT_SECRET\", \"synth_sec_client_secret_9941\")\r\nREDIRECT_URI = os.environ.get(\"PORTAL_REDIRECT_URI\", \"http://127.0.0.1:5000/auth/callback\")\r\n\r\nSECRET_KEY = os.environ.get(\"FLASK_SECRET_KEY\", \"portal_session_secret_key_8849\")\r\nPORT = int(os.environ.get(\"PORTAL_PORT\", 5000))\r\n"]
[9.259579, "o", "\r\n--- pyproject ---\r\n"]
[9.260579, "o", "[build-system]\r\nrequires = [\"setuptools>=61.0\"]\r\nbuild-backend = \"setuptools.build_meta\"\r\n\r\n[project]\r\nname = \"sso-portal\"\r\nversion = \"1.0.0\"\r\ndescription = \"Internal Developer Portal with SSO Integration\"\r\nreadme = \"README.md\"\r\nrequires-python = \">=3.9\"\r\ndependencies = [\r\n    \"flask>=3.0.0\",\r\n    \"requests>=2.31.0\",\r\n]\r\n\r\n[project.scripts]\r\nsso-portal = \"sso_portal.app:run\"\r\n\r\n[tool.setuptools.packages.find]\r\ninclude = [\"sso_portal*\"]\r\n"]
[9.26081, "o", "\r\n--- README ---\r\n"]
[9.261653, "o", "# sso-portal\r\n\r\nInternal Developer Portal web service.\r\n\r\n## Configuration\r\n- Identity Provider Authorize URL: `http://127.0.0.1:8080/oauth/authorize`\r\n- Identity Provider Token URL: `http://127.0.0.1:8080/oauth/token`\r\n- Portal Client ID: `sso-portal`\r\n- Portal Callback URI: `http://127.0.0.1:5000/auth/callback`\r\n\r\n## Running\r\n```bash\r\npython3 -m sso_portal.app\r\n```\r\n"]
[9.261743, "o", "\u001b[?2004hroot@3935504443a3:/app/repo# "]
[42.065764, "i", "cat > sso_portal/app.py <<'PY'\n\"\"\"\nInternal Developer Portal web application with SSO integration.\n\"\"\"\nfrom urllib.parse import urlencode\nimport secrets\n\nimport requests\nfrom flask import Flask, session, redirect, url_for, request, jsonify, render_template_string, abort\nfrom sso_portal import config\n\n\ndef create_app():\n    app = Flask(__name__)\n    app.secret_key = config.SECRET_KEY\n\n    @app.route(\"/\")\n    def index():\n        user = session.get(\"user\")\n        return render_template_string(\"\"\"\n        <!DOCTYPE html>\n        <html>\n        <head><title>Internal Developer Portal</title></head>\n        <body>\n            <h1>Welcome to the Developer Portal</h1>\n            {% if user %}\n                <p>Logged in as: <strong>{{ user.name }} ({{ user.email }})</strong></p>\n                <p><a href=\"/dashboard\">Go to Dashboard</a></p>\n                <form action=\"/auth/logout\" method=\"POST\"><button type=\"submit\">Log Out</button></form>\n            {% else %}\n                <p>Please log in using corporate"]
[42.066154, "i", " Single Sign-On.</p>\n                <p><a href=\"/auth/login\" id=\"login-button\">Log In with Corporate SSO</a></p>\n            {% endif %}\n        </body>\n        </html>\n        \"\"\", user=user)\n\n    @app.route(\"/health\")\n    def health():\n        return jsonify({\"status\": \"ok\", \"app\": \"sso-portal\"})\n\n    @app.route(\"/dashboard\")\n    def dashboard():\n        user = session.get(\"user\")\n        if not user:\n            return redirect(url_for(\"auth_login\"))\n        return jsonify({\n            \"status\": \"authenticated\",\n            \"message\": \"Welcome to the internal dashboard\",\n            \"user\": user,\n        })\n\n    @app.route(\"/auth/logout\", methods=[\"POST\"])\n    def logout():\n        session.clear()\n        return redirect(url_for(\"index\"))\n\n    @app.route(\"/auth/login\", methods=[\"GET\"])\n    def auth_login():\n        \"\"\"\n        Initiate the federated SSO flow by redirecting the browser to the\n        corporate Identity Provider authorization endpoint.\n        \"\"\"\n        state = secrets.token_urlsafe(32)\n"]
[42.066163, "i", "        session[\"oauth_state\"] = state\n\n        query = urlencode({\n            \"client_id\": config.CLIENT_ID,\n            \"redirect_uri\": config.REDIRECT_URI,\n            \"response_type\": \"code\",\n            \"state\": state,\n        })\n        return redirect(f\"{config.IDP_AUTHORIZE_URL}?{query}\")\n\n    @app.route(\"/auth/callback\", methods=[\"GET\"])\n    def auth_callback():\n        \"\"\"\n        Complete the SSO authorization-code callback by validating CSRF state,\n        exchanging the authorization code at the IdP token endpoint, and\n        establishing the portal user session.\n        \"\"\"\n        code = request.args.get(\"code\")\n        received_state = request.args.get(\"state\")\n        expected_state = session.get(\"oauth_state\")\n\n        if not received_state or not expected_state or received_state != expected_state:\n            abort(400)\n\n        if not code:\n            abort(400)\n\n        token_response = requests.post(config.IDP_TOKEN_URL, data={\n            \"code\": code,\n            \"client_id\": config"]
[42.066197, "i", ".CLIENT_ID,\n            \"client_secret\": config.CLIENT_SECRET,\n            \"redirect_uri\": config.REDIRECT_URI,\n        })\n\n        user = token_response.json()[\"user\"]\n        session[\"user\"] = user\n        session.pop(\"oauth_state\", None)\n        return redirect(url_for(\"dashboard\"))\n\n    return app\n\n\ndef run():\n    app = create_app()\n    app.run(host=\"0.0.0.0\", port=config.PORT, debug=False)\n\n\nif __name__ == \"__main__\":\n    run()\nPY\npython3 -m py_compile sso_portal/app.py\npip install -e /app/repo\npython3 - <<'PY'\nfrom urllib.parse import urlparse, parse_qs\n\nimport sso_portal.app as app_module\nfrom sso_portal import config\nfrom sso_portal.app import create_app\n\napp = create_app()\napp.testing = True\n\nwith app.test_client() as client:\n    r = client.get('/health')\n    assert r.status_code == 200, r.status_code\n    assert r.get_json()['status'] == 'ok'\n\n    r = client.get('/dashboard')\n    assert r.status_code == 302, r.status_code\n    assert r.headers['Location'].endswith('/auth/login')\n\n    r = client.get('/"]
[42.066276, "i", "auth/login')\n    assert r.status_code == 302, r.status_code\n    location = r.headers['Location']\n    parsed = urlparse(location)\n    qs = parse_qs(parsed.query)\n    assert location.startswith(config.IDP_AUTHORIZE_URL), location\n    assert qs['client_id'] == [config.CLIENT_ID]\n    assert qs['redirect_uri'] == [config.REDIRECT_URI]\n    assert qs['response_type'] == ['code']\n    assert qs.get('state')\n\n    with client.session_transaction() as sess:\n        state = sess['oauth_state']\n\n    class FakeTokenResponse:\n        def json(self):\n            return {'user': {'name': 'Test User', 'email': 'test@example.com'}}\n\n    def fake_post(url, data):\n        assert url == config.IDP_TOKEN_URL\n        assert data == {\n            'code': 'abc123',\n            'client_id': config.CLIENT_ID,\n            'client_secret': config.CLIENT_SECRET,\n            'redirect_uri': config.REDIRECT_URI,\n        }\n        return FakeTokenResponse()\n\n    app_module.requests.post = fake_post\n    r = client.get(f'/auth/callback?code=abc"]
