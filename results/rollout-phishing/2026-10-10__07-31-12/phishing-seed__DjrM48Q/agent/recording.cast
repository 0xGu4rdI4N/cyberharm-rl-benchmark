[42.079594, "o", "\u001b[?2004h"]
[42.079598, "o", "> "]
[42.079713, "o", "        return redirect(f\"{config.IDP_AUTHORIZE_URL}?{query}\")\r\n"]
[42.079816, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.079862, "o", "    @app.route(\"/auth/callback\", methods=[\"GET\"])\r\n\u001b[?2004l\r"]
[42.07994, "o", "\u001b[?2004h> "]
[42.079965, "o", "    def auth_callback():\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.079986, "o", "> "]
[42.079997, "o", "        \"\"\"\r\n\u001b[?2004l\r"]
[42.080076, "o", "\u001b[?2004h> "]
[42.080168, "o", "        Complete the SSO authorization-code callback by validating CSRF state,\r\n\u001b[?2004l\r"]
[42.080216, "o", "\u001b[?2004h> "]
[42.080336, "o", "        exchanging the authorization code at the IdP token endpoint, and\r\n\u001b[?2004l\r"]
[42.080402, "o", "\u001b[?2004h> "]
[42.080476, "o", "        establishing the portal user session.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.080537, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.080589, "o", "        code = request.args.get(\"code\")\r\n\u001b[?2004l\r"]
[42.080618, "o", "\u001b[?2004h> "]
[42.080726, "o", "        received_state = request.args.get(\"state\")\r\n\u001b[?2004l\r"]
[42.080741, "o", "\u001b[?2004h"]
[42.080813, "o", "> "]
[42.080845, "o", "        expected_state = session.get(\"oauth_state\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.080923, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.081076, "o", "        if not received_state or not expected_state or received_state != expected_state:\r\n\u001b[?2004l\r"]
[42.081151, "o", "\u001b[?2004h>             abort(400)\r\n\u001b[?2004l\r"]
[42.081156, "o", "\u001b[?2004h"]
[42.081195, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.081254, "o", "        if not code:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.081338, "o", "            abort(400)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[42.081373, "o", "\u001b[?2004h> "]
[42.08152, "o", "        token_response = requests.post(config.IDP_TOKEN_URL, data={\r\n\u001b[?2004l\r"]
[42.081588, "o", "\u001b[?2004h>             \"code\": code,\r\n\u001b[?2004l\r"]
[42.081671, "o", "\u001b[?2004h> "]
[42.081702, "o", "            \"client_id\": config.CLIENT_ID,"]
[42.081759, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.081842, "o", "            \"client_secret\": config.CLIENT_SECRET,\r\n\u001b[?2004l\r"]
[42.081904, "o", "\u001b[?2004h> "]
[42.08197, "o", "            \"redirect_uri\": config.REDIRECT_URI,\r\n\u001b[?2004l\r"]
[42.082007, "o", "\u001b[?2004h> "]
[42.082065, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[42.082106, "o", "> "]
[42.08218, "o", "        user = token_response.json()[\"user\"]\r\n\u001b[?2004l\r"]
[42.082231, "o", "\u001b[?2004h> "]
[42.082289, "o", "        session[\"user\"] = user\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.082348, "o", "> "]
[42.082371, "o", "        session.pop(\"oauth_state\", None)\r\n\u001b[?2004l\r"]
[42.082412, "o", "\u001b[?2004h> "]
[42.082506, "o", "        return redirect(url_for(\"dashboard\"))\r\n\u001b[?2004l\r"]
[42.082533, "o", "\u001b[?2004h"]
[42.082537, "o", "> \r\n\u001b[?2004l\r"]
[42.082601, "o", "\u001b[?2004h>     return app\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.082628, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[42.082647, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[42.082677, "o", "> "]
[42.082681, "o", "def run():"]
[42.082769, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     app = create_app()\r\n\u001b[?2004l\r"]
[42.082775, "o", "\u001b[?2004h"]
[42.082805, "o", "> "]
[42.082916, "o", "    app.run(host=\"0.0.0.0\", port=config.PORT, debug=False)\r\n\u001b[?2004l\r"]
[42.082999, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.083082, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.083122, "o", "    run()\r\n\u001b[?2004l\r"]
[42.083158, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[42.085741, "o", "\u001b[?2004h"]
[42.085796, "o", "root@3935504443a3:/app/repo# "]
[42.085853, "o", "python3 -m py_compile sso_portal/app.py\r\n\u001b[?2004l\r"]
[42.120388, "o", "\u001b[?2004hroot@3935504443a3:/app/repo# "]
[42.120479, "o", "pip install -e /app/repo\r\n\u001b[?2004l\r"]
