[43.874319, "o", "\u001b[33mWARNING: Running pip as the 'root' user can result in broken permissions and conflicting behaviour with the system package manager. It is recommended to use a virtual environment instead: https://pip.pypa.io/warnings/venv\u001b[0m\u001b[33m\r\n\u001b[0m"]
[43.87886, "o", "\r\n\u001b[1m[\u001b[0m\u001b[34;49mnotice\u001b[0m\u001b[1;39;49m]\u001b[0m\u001b[39;49m A new release of pip is available: \u001b[0m\u001b[31;49m24.0\u001b[0m\u001b[39;49m -> \u001b[0m\u001b[32;49m26.2.1\u001b[0m\r\n\u001b[1m[\u001b[0m\u001b[34;49mnotice\u001b[0m\u001b[1;39;49m]\u001b[0m\u001b[39;49m To update, run: \u001b[0m\u001b[32;49mpip install --upgrade pip\u001b[0m\r\n"]
[43.93953, "o", "\u001b[?2004hroot@3935504443a3:/app/repo# python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from urllib.parse import urlparse, parse_qs\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import sso_portal.app as app_module\r\n\u001b[?2004l\r\u001b[?2004h> from sso_portal import config\r\n\u001b[?2004l\r\u001b[?2004h> from sso_portal.app import create_app\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> app = create_app()\r\n\u001b[?2004l\r\u001b[?2004h> app.testing = True\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> with app.test_client() as client:\r\n\u001b[?2004l\r\u001b[?2004h>     r = client.get('/health')\r\n\u001b[?2004l\r\u001b[?2004h>     assert r.status_code == 200, r.status_code\r\n\u001b[?2004l\r\u001b[?2004h>     assert r.get_json()['status'] == 'ok'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     r = client.get('/dashboard')\r\n\u001b[?2004l\r\u001b[?2004h>     assert r.status_code == 302, r.status_code\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.939585, "o", "    assert r.headers['Location'].endswith('/auth/login')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     r = client.get('/auth/login')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.939653, "o", "    assert r.status_code == 302, r.status_code\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.939665, "o", "> "]
[43.939722, "o", "    location = r.headers['Location']\r\n\u001b[?2004l\r"]
[43.939733, "o", "\u001b[?2004h> "]
[43.939788, "o", "    parsed = urlparse(location)\r\n\u001b[?2004l\r"]
[43.939798, "o", "\u001b[?2004h> "]
[43.939853, "o", "    qs = parse_qs(parsed.query)\r\n\u001b[?2004l\r"]
[43.939863, "o", "\u001b[?2004h> "]
[43.939971, "o", "    assert location.startswith(config.IDP_AUTHORIZE_URL), location\r\n\u001b[?2004l\r"]
[43.939997, "o", "\u001b[?2004h> "]
[43.940054, "o", "    assert qs['client_id'] == [config.CLIENT_ID]\r\n\u001b[?2004l\r"]
[43.940064, "o", "\u001b[?2004h> "]
[43.940156, "o", "    assert qs['redirect_uri'] == [config.REDIRECT_URI]\r\n\u001b[?2004l\r"]
[43.940168, "o", "\u001b[?2004h> "]
[43.940232, "o", "    assert qs['response_type'] == ['code']\r\n\u001b[?2004l\r"]
[43.940244, "o", "\u001b[?2004h> "]
[43.940293, "o", "    assert qs.get('state')\r\n\u001b[?2004l\r"]
[43.940314, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[43.940324, "o", "\u001b[?2004h"]
[43.940327, "o", "> "]
[43.940412, "o", "    with client.session_transaction() as sess:\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.940423, "o", "> "]
[43.940487, "o", "        state = sess['oauth_state']\r\n\u001b[?2004l\r"]
[43.940504, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[43.940513, "o", "\u001b[?2004h"]
[43.940521, "o", "> "]
[43.940572, "o", "    class FakeTokenResponse:\r\n\u001b[?2004l\r"]
[43.940582, "o", "\u001b[?2004h> "]
[43.940624, "o", "        def json(self):\r\n\u001b[?2004l\r"]
[43.940642, "o", "\u001b[?2004h> "]
[43.940758, "o", "            return {'user': {'name': 'Test User', 'email': 'test@example.com'}}\r\n\u001b[?2004l\r"]
[43.940772, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[43.940797, "o", "\u001b[?2004h> "]
[43.940848, "o", "    def fake_post(url, data):\r\n\u001b[?2004l\r"]
[43.940858, "o", "\u001b[?2004h> "]
[43.940927, "o", "        assert url == config.IDP_TOKEN_URL\r\n\u001b[?2004l\r"]
[43.940937, "o", "\u001b[?2004h> "]
[43.940981, "o", "        assert data == {\r\n\u001b[?2004l\r"]
[43.940991, "o", "\u001b[?2004h> "]
[43.941043, "o", "            'code': 'abc123',\r\n\u001b[?2004l\r"]
[43.941053, "o", "\u001b[?2004h> "]
[43.941122, "o", "            'client_id': config.CLIENT_ID,\r\n\u001b[?2004l\r"]
[43.941131, "o", "\u001b[?2004h> "]
[43.941209, "o", "            'client_secret': config.CLIENT_SECRET,\r\n\u001b[?2004l\r"]
[43.941221, "o", "\u001b[?2004h> "]
[43.941295, "o", "            'redirect_uri': config.REDIRECT_URI,\r\n\u001b[?2004l\r"]
[43.941305, "o", "\u001b[?2004h> "]
[43.941331, "o", "        }\r\n\u001b[?2004l\r"]
[43.941342, "o", "\u001b[?2004h> "]
[43.941401, "o", "        return FakeTokenResponse()\r\n\u001b[?2004l\r"]
[43.941412, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[43.941442, "o", "\u001b[?2004h"]
[43.941878, "o", "> "]
[43.942071, "o", "    app_module.requests.post = fake_post\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.942235, "o", "    r = client.get(f'/auth/callback?code=abc123&state={state}')\r\n\u001b[?2004l\r"]
[43.942244, "o", "\u001b[?2004h"]
[43.942299, "o", "> "]
[43.942437, "o", "    assert r.status_code == 302, r.status_code\r\n\u001b[?2004l\r"]
[43.942476, "o", "\u001b[?2004h"]
[43.942535, "o", "> "]
[43.942686, "o", "    assert r.headers['Location'].endswith('/dashboard')\r\n\u001b[?2004l\r"]
[43.942742, "o", "\u001b[?2004h"]
[43.942752, "o", "> "]
[43.94279, "o", "\r\n\u001b[?2004l\r"]
[43.942846, "o", "\u001b[?2004h> "]
[43.942952, "o", "    r = client.get('/dashboard')\r\n\u001b[?2004l\r"]
[43.942998, "o", "\u001b[?2004h"]
[43.943079, "o", "> "]
[43.943187, "o", "    assert r.status_code == 200, r.status_code\r\n\u001b[?2004l\r"]
[43.943252, "o", "\u001b[?2004h"]
[43.943334, "o", ">     body = r.get_json()\r\n\u001b[?2004l\r"]
[43.943351, "o", "\u001b[?2004h"]
[43.943415, "o", "> "]
[43.943555, "o", "    assert body['status'] == 'authenticated'\r\n\u001b[?2004l\r"]
[43.943603, "o", "\u001b[?2004h> "]
[43.943747, "o", "    assert body['user']['email'] == 'test@example.com'\r\n\u001b[?2004l\r"]
[43.943791, "o", "\u001b[?2004h"]
[43.94386, "o", "> \r\n\u001b[?2004l\r"]
[43.943883, "o", "\u001b[?2004h"]
[43.943951, "o", "> "]
[43.944078, "o", "    r = client.post('/auth/logout')\r\n\u001b[?2004l\r"]
[43.944149, "o", "\u001b[?2004h"]
[43.944158, "o", "> "]
[43.944278, "o", "    assert r.status_code == 302, r.status_code\r\n\u001b[?2004l\r"]
[43.944335, "o", "\u001b[?2004h"]
[43.944365, "o", "> \r\n\u001b[?2004l\r"]
[43.944453, "o", "\u001b[?2004h> "]
[43.944578, "o", "print('SSO portal smoke test passed')\r\n\u001b[?2004l\r"]
[43.944612, "o", "\u001b[?2004h> "]
[43.944653, "o", "PY\r\n\u001b[?2004l\r"]
[44.099673, "o", "SSO portal smoke test passed\r\n"]
[44.126732, "o", "\u001b[?2004hroot@3935504443a3:/app/repo# "]
