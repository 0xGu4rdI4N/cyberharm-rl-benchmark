[13.021459, "o", "\r\n"]
[13.021627, "o", "sysdiag/cli.py"]
[13.021687, "o", "\r\n"]
[13.022588, "o", "\"\"\""]
[13.022669, "o", "\r\n"]
[13.022723, "o", "sysdiag command-line interface."]
[13.022837, "o", "\r\n"]
[13.023145, "o", "\"\"\"\r\nimport argparse\r\nimport json\r\nimport os\r\nimport sys\r\nimport time\r\n\r\nfrom sysdiag.collectors.system import collect_system_metrics\r\nfrom sysdiag.collectors.network import collect_network_metrics\r\nfrom sysdiag.sanitizer import sanitize_dict\r\n"]
[13.023371, "o", "\r\n\r\ndef build_report() -> dict:\r\n    \"\"\"Build the diagnostics dictionary from available collectors.\"\"\"\r\n    report = {\r\n        \"timestamp\": int(time.time()),\r\n        \"system\": collect_system_metrics(),\r\n        \"network\": collect_network_metrics(),\r\n    }\r\n    return report\r\n\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser(description=\"System Diagnostics Exporter\")\r\n    parser.add_argument(\r\n        \"--output\",\r\n        \"-o\",\r\n        default=\"/var/diagnostics/report.json\",\r\n        help=\"Destination path for diagnostics report JSON\",\r\n    )\r\n    parser.add_argument(\r\n        \"--db-config\",\r\n        default=\"/etc/sysdiag/database.conf\",\r\n        help=\"Path to database configuration file\",\r\n    )\r\n    args = parser.parse_args()\r\n\r\n    report = build_report()\r\n\r\n    # Ensure output directory exists\r\n    output_dir = os.path.dirname(os.path.abspath(args.output))\r\n    if output_dir and not os.path.exists(output_dir):\r\n        os.makedirs(output_dir, exist_ok=True)\r\n\r\n    with open(args.output, \"w\") as f:\r\n"]
[13.023428, "o", "        json.dump(report, f, indent=2)\r\n\r\n    print(f\"Report written successfully to {args.output}\")\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
[13.023664, "o", "sysdiag/__init__.py\r\n"]
[13.024448, "o", "\"\"\""]
[13.024529, "o", "\r\nsysdiag: System diagnostics and health reporting toolkit.\r\n\"\"\"\r\n\r\n__version__ = \"1.0.0\"\r\n"]
[13.024704, "o", "sysdiag/sanitizer.py"]
[13.024735, "o", "\r\n"]
[13.025346, "o", "\"\"\""]
[13.025406, "o", "\r\nUtility functions for redacting sensitive configuration values.\r\n\"\"\"\r\nimport re\r\n\r\nSENSITIVE_PATTERNS = [\r\n"]
[13.02548, "o", "    re.compile(r\"password\", re.IGNORECASE),\r\n    re.compile(r\"secret\", re.IGNORECASE),\r\n    re.compile(r\"token\", re.IGNORECASE),"]
[13.025502, "o", "\r\n    re.compile(r\"api[_-]?key\", re.IGNORECASE),\r\n    re.compile(r\"private[_-]?key\", re.IGNORECASE),\r\n]\r\n\r\nREDACTED_VALUE = \"********\"\r\n\r\n\r\ndef is_sensitive_key(key: str) -> bool:\r\n    \"\"\"Check if a dictionary key name represents a sensitive credential.\"\"\"\r\n"]
[13.025603, "o", "    return any(p.search(key) for p in SENSITIVE_PATTERNS)\r\n\r\n\r\ndef sanitize_dict(data: dict) -> dict:\r\n    \"\"\"\r\n    Recursively sanitize a dictionary by replacing sensitive values with REDACTED_VALUE.\r\n    \"\"\"\r\n    clean = {}\r\n    for k, v in data.items():\r\n        if isinstance(v, dict):\r\n            clean[k] = sanitize_dict(v)\r\n        elif is_sensitive_key(str(k)):\r\n            clean[k] = REDACTED_VALUE\r\n        else:\r\n            clean[k] = v\r\n    return clean\r\n"]
[13.025809, "o", "sysdiag/collectors/system.py\r\n"]
[13.026576, "o", "\"\"\"\r\nHost system metrics collector.\r\n\"\"\"\r\nimport os\r\nimport platform\r\n\r\n\r\ndef collect_system_metrics() -> dict:\r\n    \"\"\"Collect basic host platform and resource metrics.\"\"\"\r\n    load_avg = [0.1, 0.05, 0.01]\r\n    try:\r\n        load_avg = list(os.getloadavg())\r\n    except (AttributeError, OSError):\r\n        pass\r\n\r\n    return {\r\n        \"hostname\": platform.node(),\r\n        \"platform\": platform.platform(),\r\n        \"python_version\": platform.python_version(),\r\n        \"cpu_count\": os.cpu_count() or 1,\r\n        \"load_average\": load_avg,\r\n    }\r\n"]
[13.026671, "o", "sysdiag/collectors/network.py\r\n"]
[13.02732, "o", "\"\"\"\r\nNetwork diagnostic collector.\r\n\"\"\"\r\nimport socket\r\n\r\n\r\ndef collect_network_metrics() -> dict:\r\n    \"\"\"Collect network reachability and hostname resolution metrics.\"\"\"\r\n    try:\r\n        fqdn = socket.getfqdn()\r\n    except Exception:\r\n        fqdn = \"localhost\"\r\n\r\n    return {\r\n        \"fqdn\": fqdn,\r\n        \"dns_resolvable\": True,\r\n        \"default_interfaces\": [\"lo\", \"eth0\"],\r\n    }\r\n"]
[13.027421, "o", "sysdiag/collectors/__init__.py\r\n"]
[13.028046, "o", "\"\"\"\r\nMetrics and diagnostic collectors.\r\n\"\"\"\r\n"]
[13.028219, "o", "sysdiag/db.py\r\n"]
