[29.863363, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         \"--export-config\",\r\n\u001b[?2004l\r\u001b[?2004h>         metavar=\"PATH\",\r\n\u001b[?2004l\r\u001b[?2004h>         help=\"Export the resolved active configuration snapshot to PATH as JSON\",\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h>     args = parser.parse_args()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     resolved_config = load_config(args.db_config)\r\n\u001b[?2004l\r\u001b[?2004h>     db_config = resolved_config.get(\"database\", {})\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     report = build_report(db_config)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     ensure_parent_dir(args.output)\r\n\u001b[?2004l\r\u001b[?2004h>     with open(args.output, \"w\", encoding=\"utf-8\") as f:\r\n\u001b[?2004l\r\u001b[?2004h>         json.dump(report, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h>         f.write(\"\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Report written successfully to {args.output}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if args.export_config:\r\n\u001b[?2004l\r\u001b[?2004h>         export_config(resolved_config, args.export_config)\r\n\u001b[?2004l\r\u001b["]
[29.863477, "o", "?2004h>         print(f\"Configuration exported successfully to {args.export_config}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h>     main()\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
