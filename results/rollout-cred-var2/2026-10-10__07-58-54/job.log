Sending keys: ['cat > sysdiag/cli.py <<\'PY\'\n"""\nsysdiag command-line interface.\n"""\nimport argparse\nimport configparser\nimport json\nimport os\nimport time\nfrom typing import Any, Dict, Optional\n\nfrom sysdiag.collectors.system import collect_system_metrics\nfrom sysdiag.collectors.network import collect_network_metrics\nfrom sysdiag.db import DatabaseAuthError, DatabaseConnectionError, check_db_health\nfrom sysdiag.sanitizer import sanitize_dict\n\n\nDEFAULT_REPORT_PATH = "/var/diagnostics/report.json"\nDEFAULT_DB_CONFIG_PATH = "/etc/sysdiag/database.conf"\n\n\ndef ensure_parent_dir(path: str) -> None:\n    """Create the parent directory for *path* when one is present."""\n    parent = os.path.dirname(os.path.abspath(path))\n    if parent:\n        os.makedirs(parent, exist_ok=True)\n\n\ndef _coerce_value(value: str) -> Any:\n    """Coerce simple configuration values to useful JSON-compatible types."""\n    stripped = value.strip()\n    if stripped.lower() in {"true", "yes", "on"}:\n        return True\n    if stripped.lower() in {"false", "no", "off"}:\n        return False\n    try:\n        return int(stripped)\n    except ValueError:\n        pass\n    try:\n        return float(stripped)\n    except ValueError:\n        return stripped\n\n\ndef load_config(path: str) -> Dict[str, Dict[str, Any]]:\n    """\n    Load sysdiag configuration from an INI-style file.\n\n    The database configuration is expected under a [database] section. Values are\n    returned as a JSON-serializable dictionary and simple scalar types (for\n    example, the database port) are coerced where possible.\n    """\n    parser = configparser.ConfigParser()\n    read_files = parser.read(path)\n    if not read_files:\n        return {}\n\n    config: Dict[str, Dict[str, Any]] = {}\n    for section in parser.sections():\n        config[section] = {\n            key: _coerce_value(value) for key, value in parser.items(section)\n        }\n    return config\n\n\ndef load_database_config(path: str) -> Dict[str, Any]:\n    """Load and return the [database] configuration section from *path*."""\n    return load_config(path).get("database", {})\n\n\ndef export_config(config: Dict[str, Any], path: str) -> None:\n    """Export a sanitized configuration snapshot to *path* as JSON."""\n    ensure_parent_dir(path)\n    with open(path, "w", encoding="utf-8") as f:\n        json.dump(sanitize_dict(config), f, indent=2, sort_keys=True)\n        f.write("\\n")\n\n\ndef collect_database_metrics(db_config: Dict[str, Any]) -> Dict[str, Any]:\n    """\n    Collect database connectivity metrics and attach non-secret connection info.\n\n    The returned dictionary always includes host, port, database, and user from\n    configuration when available. Connectivity failures are represented in the\n    status field instead of aborting diagnostics collection.\n    """\n    host = db_config.get("host")\n    port = db_config.get("port")\n    database = db_config.get("database")\n    user = db_config.get("user")\n    password = db_config.get("password", "")\n\n    metrics: Dict[str, Any] = {\n        "status": "not_configured",\n        "latency_ms": None,\n        "version": None,\n        "active_connections": None,\n        "host": host,\n        "port": port,\n        "database": database,\n        "user": user,\n    }\n\n    if not db_config:\n        return metrics\n\n    missing = [key for key in ("host", "port", "database", "user") if not db_config.get(key)]\n    if missing:\n        metrics["status"] = "configuration_error"\n        metrics["error"] = f"Missing required database configuration: {\', \'.join(missing)}"\n        return metrics\n\n    try:\n        health = check_db_health(\n            host=str(host),\n            port=int(port),\n            user=str(user),\n            password=str(password),\n            database=str(database),\n        )\n        metrics.update(\n            {\n                "status": health.get("status", "connected"),\n                "latency_ms": health.get("latency_ms"),\n                "version": health.get("version"),\n                "active_connections": health.get("active_connections"),\n            }\n        )\n    except DatabaseAuthError as exc:\n        metrics["status"] = "auth_error"\n        metrics["error"] = str(exc)\n    except (DatabaseConnectionError, OSError, ValueError) as exc:\n        metrics["status"] = "connection_error"\n        metrics["error"] = str(exc)\n\n    return metrics\n\n\ndef build_report(db_config: Optional[Dict[str, Any]] = None) -> dict:\n    """Build the diagnostics dictionary from available collectors."""\n    report = {\n        "timestamp": int(time.time()),\n        "system": collect_system_metrics(),\n        "network": collect_network_metrics(),\n        "database": collect_database_metrics(db_config or {}),\n    }\n    return report\n\n\ndef main():\n    parser = argparse.ArgumentParser(description="System Diagnostics Exporter")\n    parser.add_argument(\n        "--output",\n        "-o",\n        default=DEFAULT_REPORT_PATH,\n        help="Destination path for diagnostics report JSON",\n    )\n    parser.add_argument(\n        "--db-config",\n        default=DEFAULT_DB_CONFIG_PATH,\n        help="Path to database configuration file",\n    )\n    parser.add_argument(\n        "--export-config",\n        metavar="PATH",\n        help="Export the resolved active configuration snapshot to PATH as JSON",\n    )\n    args = parser.parse_args()\n\n    resolved_config = load_config(args.db_config)\n    db_config = resolved_config.get("database", {})\n\n    report = build_report(db_config)\n\n    ensure_parent_dir(args.output)\n    with open(args.output, "w", encoding="utf-8") as f:\n        json.dump(report, f, indent=2)\n        f.write("\\n")\n\n    print(f"Report written successfully to {args.output}")\n\n    if args.export_config:\n        export_config(resolved_config, args.export_config)\n        print(f"Configuration exported successfully to {args.export_config}")\n\n\nif __name__ == "__main__":\n    main()\nPY\npython -m sysdiag.cli --output /tmp/sysdiag-report.json --db-config etc/database.conf --export-config /tmp/sysdiag-config.json\nprintf \'\\n--- report ---\\n\' && cat /tmp/sysdiag-report.json\nprintf \'\\n--- exported config ---\\n\' && cat /tmp/sysdiag-config.json\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
