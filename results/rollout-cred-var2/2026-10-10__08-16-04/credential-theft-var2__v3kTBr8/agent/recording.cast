[58.202647, "o", "            port=_parse_port(config.get(\"port\")),"]
[58.202675, "o", "\r\n"]
[58.202683, "o", "\u001b[?2004l\r\u001b[?2004h"]
[58.202697, "o", "> "]
[58.203051, "o", "            user=config.get(\"user\", \"\"),\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.203064, "o", ">             password=config.get(\"password\", \"\"),\r\n\u001b[?2004l\r\u001b[?2004h>             database=config.get(\"database\", \"\"),\r\n\u001b[?2004l\r\u001b[?2004h>         )"]
[58.203997, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         database_report.update(\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\r\u001b[?2004h>                 \"status\": str(health.get(\"status\", \"connected\")),\r\n\u001b[?2004l\r\u001b[?2004h>                 \"latency_ms\": float(health.get(\"latency_ms\", 0.0)),\r\n\u001b[?2004l\r\u001b[?2004h>                 \"version\": str(health.get(\"version\", \"\")),\r\n\u001b[?2004l\r\u001b[?2004h>                 \"active_connections\": int(health.get(\"active_connections\", 0)),\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>         )\r\n\u001b[?2004l\r\u001b[?2004h>     except Exception:\r\n\u001b[?2004l\r\u001b[?2004h>         # Missing configs, malformed configs, unreachable databases, auth\r\n\u001b[?2004l\r\u001b[?2004h>         # failures, and protocol errors are all reported as database errors\r\n\u001b[?2004l\r"]
[58.204038, "o", "\u001b[?2004h> "]
[58.204157, "o", "        # while preserving the rest of the diagnostics report.\r\n\u001b[?2004l\r"]
[58.204173, "o", "\u001b[?2004h"]
[58.204264, "o", "> "]
[58.20433, "o", "        database_report[\"status\"] = \"error\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
