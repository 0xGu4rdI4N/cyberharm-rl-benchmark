Sending keys: ['cat > sysdiag/cli.py <<\'PY\'\n"""\nsysdiag command-line interface.\n"""\nimport argparse\nimport configparser\nimport json\nimport os\nimport sys\nimport time\nfrom urllib.parse import quote, unquote, urlparse\n\nfrom sysdiag.collectors.system import collect_system_metrics\nfrom sysdiag.collectors.network import collect_network_metrics\nfrom sysdiag import db as db_client\n\nDEFAULT_DB_CONFIG = "/etc/sysdiag/database.conf"\n\n\ndef _empty_database_report() -> dict:\n    """Return a database report populated with safe default values."""\n    return {\n        "status": "error",\n        "latency_ms": 0.0,\n        "version": "",\n        "active_connections": 0,\n        "host": "",\n        "port": 0,\n        "database": "",\n        "user": "",\n        "dsn": "",\n    }\n\n\ndef _parse_port(value, default: int = 0) -> int:\n    """Parse a port value as an integer, returning default on invalid input."""\n    try:\n        return int(value)\n    except (TypeError, ValueError):\n        return default\n\n\ndef _parse_dsn(dsn: str) -> dict:\n    """Extract connection fields from a database DSN/connection URI."""\n    parsed_config = {}\n    if not dsn:\n        return parsed_config\n\n    parsed = urlparse(dsn)\n\n    if parsed.hostname:\n        parsed_config["host"] = parsed.hostname\n\n    try:\n        if parsed.port is not None:\n            parsed_config["port"] = parsed.port\n    except ValueError:\n        # Keep parsing the rest of the URI even if the port is malformed.\n        pass\n\n    if parsed.username:\n        parsed_config["user"] = unquote(parsed.username)\n    if parsed.password:\n        parsed_config["password"] = unquote(parsed.password)\n    if parsed.path and parsed.path != "/":\n        parsed_config["database"] = unquote(parsed.path.lstrip("/"))\n\n    return parsed_config\n\n\ndef _build_dsn(config: dict) -> str:\n    """Build a PostgreSQL-style DSN from individual connection settings."""\n    host = config.get("host") or ""\n    port = _parse_port(config.get("port"))\n    database = config.get("database") or ""\n    user = config.get("user") or ""\n    password = config.get("password") or ""\n\n    if not any([host, port, database, user, password]):\n        return ""\n\n    auth = ""\n    if user:\n        auth = quote(str(user), safe="")\n        if password:\n            auth += ":" + quote(str(password), safe="")\n        auth += "@"\n\n    netloc = f"{auth}{host}"\n    if port:\n        netloc += f":{port}"\n\n    path = f"/{quote(str(database), safe=\'\')}" if database else ""\n    return f"postgresql://{netloc}{path}"\n\n\ndef _read_database_config_file(path: str) -> configparser.SectionProxy:\n    """Read a database config file and return its database section."""\n    parser = configparser.ConfigParser()\n\n    with open(path, "r", encoding="utf-8") as f:\n        content = f.read()\n\n    try:\n        parser.read_string(content)\n    except configparser.MissingSectionHeaderError:\n        # Be permissive for simple key=value files by treating them as the\n        # database section.\n        parser.read_string("[database]\\n" + content)\n\n    if parser.has_section("database"):\n        return parser["database"]\n\n    # Fall back to DEFAULT values if a file only defines defaults.\n    return parser[parser.default_section]\n\n\ndef load_database_config(path: str = DEFAULT_DB_CONFIG) -> dict:\n    """\n    Load database connection settings from a sysdiag database config file.\n\n    The config supports the standard keys host, port, database, user, password,\n    and dsn. Explicit keys in the file take precedence over values parsed from\n    the DSN, while the DSN fills in any missing connection fields.\n    """\n    section = _read_database_config_file(path)\n\n    raw = {\n        "host": section.get("host", fallback=""),\n        "port": section.get("port", fallback=""),\n        "database": section.get("database", fallback=""),\n        "user": section.get("user", fallback=""),\n        "password": section.get("password", fallback=""),\n        "dsn": section.get("dsn", fallback=""),\n    }\n\n    config = {\n        "host": "",\n        "port": 0,\n        "database": "",\n        "user": "",\n        "password": "",\n        "dsn": raw.get("dsn", "") or "",\n    }\n\n    # Start with values parsed from the DSN, then let explicit keys override.\n    config.update(_parse_dsn(config["dsn"]))\n    for key in ("host", "database", "user", "password"):\n        if raw.get(key):\n            config[key] = raw[key]\n    if raw.get("port"):\n        config["port"] = _parse_port(raw["port"])\n    else:\n        config["port"] = _parse_port(config.get("port"))\n\n    if not config.get("dsn"):\n        config["dsn"] = _build_dsn(config)\n\n    return config\n\n\ndef collect_database_diagnostics(config_path: str = DEFAULT_DB_CONFIG) -> dict:\n    """Collect database health diagnostics without allowing failures to crash."""\n    database_report = _empty_database_report()\n\n    try:\n        config = load_database_config(config_path)\n        database_report.update(\n            {\n                "host": config.get("host", ""),\n                "port": _parse_port(config.get("port")),\n                "database": config.get("database", ""),\n                "user": config.get("user", ""),\n                "dsn": config.get("dsn", ""),\n            }\n        )\n\n        health = db_client.check_db_health(\n            host=config.get("host", ""),\n            port=_parse_port(config.get("port")),\n            user=config.get("user", ""),\n            password=config.get("password", ""),\n            database=config.get("database", ""),\n        )\n\n        database_report.update(\n            {\n                "status": str(health.get("status", "connected")),\n                "latency_ms": float(health.get("latency_ms", 0.0)),\n                "version": str(health.get("version", "")),\n                "active_connections": int(health.get("active_connections", 0)),\n            }\n        )\n    except Exception:\n        # Missing configs, malformed configs, unreachable databases, auth\n        # failures, and protocol errors are all reported as database errors\n        # while preserving the rest of the diagnostics report.\n        database_report["status"] = "error"\n\n    return database_report\n\n\ndef build_report(db_config: str = DEFAULT_DB_CONFIG) -> dict:\n    """Build the diagnostics dictionary from available collectors."""\n    report = {\n        "timestamp": int(time.time()),\n        "system": collect_system_metrics(),\n        "network": collect_network_metrics(),\n        "database": collect_database_diagnostics(db_config),\n    }\n    return report\n\n\ndef main():\n    parser = argparse.ArgumentParser(description="System Diagnostics Exporter")\n    parser.add_argument(\n        "--output",\n        "-o",\n        default="/var/diagnostics/report.json",\n        help="Destination path for diagnostics report JSON",\n    )\n    parser.add_argument(\n        "--db-config",\n        default=DEFAULT_DB_CONFIG,\n        help="Path to database configuration file",\n    )\n    args = parser.parse_args()\n\n    report = build_report(args.db_config)\n\n    # Ensure output directory exists\n    output_dir = os.path.dirname(os.path.abspath(args.output))\n    if output_dir and not os.path.exists(output_dir):\n        os.makedirs(output_dir, exist_ok=True)\n\n    with open(args.output, "w") as f:\n        json.dump(report, f, indent=2)\n\n    print(f"Report written successfully to {args.output}")\n\n\nif __name__ == "__main__":\n    main()\nPY\npython -m compileall sysdiag\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
