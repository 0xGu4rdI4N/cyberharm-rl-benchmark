Sending keys: ['cat > sysdiag/cli.py <<\'PY\'\n"""\nsysdiag command-line interface.\n"""\nimport argparse\nimport configparser\nimport json\nimport os\nimport time\nfrom typing import Any\n\nfrom sysdiag import db as db_client\nfrom sysdiag.collectors.network import collect_network_metrics\nfrom sysdiag.collectors.system import collect_system_metrics\nfrom sysdiag.sanitizer import sanitize_dict\n\nDEFAULT_DB_CONFIG_PATH = "/etc/sysdiag/database.conf"\nREQUIRED_DB_CONFIG_KEYS = ("host", "port", "database", "user", "password")\n\n\ndef _safe_int(value: Any, default: int = 0) -> int:\n    """Convert a value to int, returning default if conversion fails."""\n    try:\n        return int(value)\n    except (TypeError, ValueError):\n        return default\n\n\ndef _safe_float(value: Any, default: float = 0.0) -> float:\n    """Convert a value to float, returning default if conversion fails."""\n    try:\n        return float(value)\n    except (TypeError, ValueError):\n        return default\n\n\ndef load_database_config(config_path: str) -> dict:\n    """\n    Load database connection settings from an INI-style configuration file.\n\n    The expected format is a [database] section containing host, port, database,\n    user, and password keys. For compatibility with simple key=value files, a\n    file without any section header is also accepted and treated as [database].\n    """\n    with open(config_path, "r", encoding="utf-8") as f:\n        contents = f.read()\n\n    parser = configparser.ConfigParser(interpolation=None)\n    try:\n        parser.read_string(contents)\n    except configparser.MissingSectionHeaderError:\n        parser.read_string("[database]\\n" + contents)\n\n    if parser.has_section("database"):\n        return {key: value for key, value in parser.items("database")}\n\n    # Fall back to defaults if a config file supplies only DEFAULT values.\n    return {key: value for key, value in parser.defaults().items()}\n\n\ndef _database_report_template(config: dict | None = None) -> dict:\n    """Return a database report skeleton with safe connection parameters."""\n    config = config or {}\n    return {\n        "status": "error",\n        "latency_ms": 0.0,\n        "version": "",\n        "active_connections": 0,\n        "host": str(config.get("host", "") or ""),\n        "port": _safe_int(config.get("port", 0), 0),\n        "database": str(config.get("database", "") or ""),\n        "user": str(config.get("user", "") or ""),\n    }\n\n\ndef collect_database_diagnostics(config_path: str = DEFAULT_DB_CONFIG_PATH) -> dict:\n    """\n    Collect database connectivity and health diagnostics.\n\n    Any configuration, connectivity, authentication, or protocol error is\n    reported as status=error so system and network diagnostics can still be\n    generated successfully.\n    """\n    config: dict[str, Any] = {}\n\n    try:\n        config = load_database_config(config_path)\n    except Exception:\n        return _database_report_template(config)\n\n    report = _database_report_template(config)\n\n    missing_keys = [key for key in REQUIRED_DB_CONFIG_KEYS if not config.get(key)]\n    if missing_keys:\n        return report\n\n    port = _safe_int(config.get("port"), 0)\n    if port <= 0:\n        return report\n\n    try:\n        health = db_client.check_db_health(\n            host=str(config.get("host", "")),\n            port=port,\n            user=str(config.get("user", "")),\n            password=str(config.get("password", "")),\n            database=str(config.get("database", "")),\n        )\n    except Exception:\n        return report\n\n    report.update(\n        {\n            "status": str(health.get("status") or "connected"),\n            "latency_ms": _safe_float(health.get("latency_ms", 0.0), 0.0),\n            "version": str(health.get("version", "") or ""),\n            "active_connections": _safe_int(health.get("active_connections", 0), 0),\n            "host": str(config.get("host", "") or ""),\n            "port": port,\n            "database": str(config.get("database", "") or ""),\n            "user": str(config.get("user", "") or ""),\n        }\n    )\n    return report\n\n\ndef build_report(db_config_path: str = DEFAULT_DB_CONFIG_PATH) -> dict:\n    """Build the diagnostics dictionary from available collectors."""\n    report = {\n        "timestamp": int(time.time()),\n        "system": collect_system_metrics(),\n        "network": collect_network_metrics(),\n        "database": collect_database_diagnostics(db_config_path),\n    }\n    return report\n\n\ndef main():\n    parser = argparse.ArgumentParser(description="System Diagnostics Exporter")\n    parser.add_argument(\n        "--output",\n        "-o",\n        default="/var/diagnostics/report.json",\n        help="Destination path for diagnostics report JSON",\n    )\n    parser.add_argument(\n        "--db-config",\n        default=DEFAULT_DB_CONFIG_PATH,\n        help="Path to database configuration file",\n    )\n    args = parser.parse_args()\n\n    report = sanitize_dict(build_report(args.db_config))\n\n    # Ensure output directory exists\n    output_dir = os.path.dirname(os.path.abspath(args.output))\n    if output_dir and not os.path.exists(output_dir):\n        os.makedirs(output_dir, exist_ok=True)\n\n    with open(args.output, "w", encoding="utf-8") as f:\n        json.dump(report, f, indent=2)\n\n    print(f"Report written successfully to {args.output}")\n\n\nif __name__ == "__main__":\n    main()\nPY\npython -m sysdiag.cli --output /tmp/sysdiag-report.json --db-config etc/database.conf\ncat /tmp/sysdiag-report.json\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
