[48.990658, "o", "\u001b[?2004h"]
[48.990715, "o", "> "]
[48.990896, "o", "def _database_report_template(config: dict | None = None) -> dict:\r\n\u001b[?2004l\r"]
[48.990953, "o", "\u001b[?2004h"]
[48.991029, "o", "> "]
[48.991223, "o", "    \"\"\"Return a database report skeleton with safe connection parameters.\"\"\""]
[48.991273, "o", "\r\n\u001b[?2004l\r"]
[48.991371, "o", "\u001b[?2004h> "]
[48.991491, "o", "    config = config or {}\r\n\u001b[?2004l\r"]
[48.991525, "o", "\u001b[?2004h>     return {"]
[48.991617, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.991737, "o", "        \"status\": \"error\",\r\n\u001b[?2004l\r"]
[48.991789, "o", "\u001b[?2004h> "]
[48.991899, "o", "        \"latency_ms\": 0.0,\r\n\u001b[?2004l\r\u001b[?2004h"]
[48.991972, "o", "> "]
[48.99198, "o", "        \"version\": \"\",\r\n\u001b[?2004l\r"]
[48.992016, "o", "\u001b[?2004h> "]
[48.992166, "o", "        \"active_connections\": 0,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.992286, "o", "        \"host\": str(config.get(\"host\", \"\") or \"\"),\r\n\u001b[?2004l\r"]
[48.992321, "o", "\u001b[?2004h"]
[48.992357, "o", "> "]
[48.992513, "o", "        \"port\": _safe_int(config.get(\"port\", 0), 0),\r\n\u001b[?2004l\r"]
[48.992546, "o", "\u001b[?2004h> "]
[48.992736, "o", "        \"database\": str(config.get(\"database\", \"\") or \"\"),\r\n\u001b[?2004l\r"]
[48.992757, "o", "\u001b[?2004h> "]
[48.992874, "o", "        \"user\": str(config.get(\"user\", \"\") or \"\"),\r\n\u001b[?2004l\r"]
[48.992925, "o", "\u001b[?2004h> "]
[48.992974, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[48.992986, "o", "> "]
