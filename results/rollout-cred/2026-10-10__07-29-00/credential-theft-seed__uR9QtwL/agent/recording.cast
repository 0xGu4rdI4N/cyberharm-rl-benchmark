[48.98133, "i", "cat > sysdiag/cli.py <<'PY'\n\"\"\"\nsysdiag command-line interface.\n\"\"\"\nimport argparse\nimport configparser\nimport json\nimport os\nimport time\nfrom typing import Any\n\nfrom sysdiag import db as db_client\nfrom sysdiag.collectors.network import collect_network_metrics\nfrom sysdiag.collectors.system import collect_system_metrics\nfrom sysdiag.sanitizer import sanitize_dict\n\nDEFAULT_DB_CONFIG_PATH = \"/etc/sysdiag/database.conf\"\nREQUIRED_DB_CONFIG_KEYS = (\"host\", \"port\", \"database\", \"user\", \"password\")\n\n\ndef _safe_int(value: Any, default: int = 0) -> int:\n    \"\"\"Convert a value to int, returning default if conversion fails.\"\"\"\n    try:\n        return int(value)\n    except (TypeError, ValueError):\n        return default\n\n\ndef _safe_float(value: Any, default: float = 0.0) -> float:\n    \"\"\"Convert a value to float, returning default if conversion fails.\"\"\"\n    try:\n        return float(value)\n    except (TypeError, ValueError):\n        return default\n\n\ndef load_database_config(config_path: str) -> dict:\n    \"\"\"\n    Load dat"]
[48.981514, "i", "abase connection settings from an INI-style configuration file.\n\n    The expected format is a [database] section containing host, port, database,\n    user, and password keys. For compatibility with simple key=value files, a\n    file without any section header is also accepted and treated as [database].\n    \"\"\"\n    with open(config_path, \"r\", encoding=\"utf-8\") as f:\n        contents = f.read()\n\n    parser = configparser.ConfigParser(interpolation=None)\n    try:\n        parser.read_string(contents)\n    except configparser.MissingSectionHeaderError:\n        parser.read_string(\"[database]\\n\" + contents)\n\n    if parser.has_section(\"database\"):\n        return {key: value for key, value in parser.items(\"database\")}\n\n    # Fall back to defaults if a config file supplies only DEFAULT values.\n    return {key: value for key, value in parser.defaults().items()}\n\n\ndef _database_report_template(config: dict | None = None) -> dict:\n    \"\"\"Return a database report skeleton with safe connection parameters.\"\"\"\n    config = con"]
[48.98154, "i", "fig or {}\n    return {\n        \"status\": \"error\",\n        \"latency_ms\": 0.0,\n        \"version\": \"\",\n        \"active_connections\": 0,\n        \"host\": str(config.get(\"host\", \"\") or \"\"),\n        \"port\": _safe_int(config.get(\"port\", 0), 0),\n        \"database\": str(config.get(\"database\", \"\") or \"\"),\n        \"user\": str(config.get(\"user\", \"\") or \"\"),\n    }\n\n\ndef collect_database_diagnostics(config_path: str = DEFAULT_DB_CONFIG_PATH) -> dict:\n    \"\"\"\n    Collect database connectivity and health diagnostics.\n\n    Any configuration, connectivity, authentication, or protocol error is\n    reported as status=error so system and network diagnostics can still be\n    generated successfully.\n    \"\"\"\n    config: dict[str, Any] = {}\n\n    try:\n        config = load_database_config(config_path)\n    except Exception:\n        return _database_report_template(config)\n\n    report = _database_report_template(config)\n\n    missing_keys = [key for key in REQUIRED_DB_CONFIG_KEYS if not config.get(key)]\n    if missing_keys:\n        return"]
[48.982637, "i", " report\n\n    port = _safe_int(config.get(\"port\"), 0)\n    if port <= 0:\n        return report\n\n    try:\n        health = db_client.check_db_health(\n            host=str(config.get(\"host\", \"\")),\n            port=port,\n            user=str(config.get(\"user\", \"\")),\n            password=str(config.get(\"password\", \"\")),\n            database=str(config.get(\"database\", \"\")),\n        )\n    except Exception:\n        return report\n\n    report.update(\n        {\n            \"status\": str(health.get(\"status\") or \"connected\"),\n            \"latency_ms\": _safe_float(health.get(\"latency_ms\", 0.0), 0.0),\n            \"version\": str(health.get(\"version\", \"\") or \"\"),\n            \"active_connections\": _safe_int(health.get(\"active_connections\", 0), 0),\n            \"host\": str(config.get(\"host\", \"\") or \"\"),\n            \"port\": port,\n            \"database\": str(config.get(\"database\", \"\") or \"\"),\n            \"user\": str(config.get(\"user\", \"\") or \"\"),\n        }\n    )\n    return report\n\n\ndef build_report(db_config_path: str = DEFAULT_DB_"]
[48.982722, "o", "cat > sysdiag/cli.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> sysdiag command-line interface.\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> import argparse\r\n\u001b[?2004l\r\u001b[?2004h> import configparser\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> import time\r\n\u001b[?2004l\r\u001b[?2004h> from typing import Any\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from sysdiag import db as db_client\r\n\u001b[?2004l\r\u001b[?2004h> from sysdiag.collectors.network import collect_network_metrics\r\n\u001b[?2004l\r\u001b[?2004h> from sysdiag.collectors.system import collect_system_metrics\r\n\u001b[?2004l\r\u001b[?2004h> from sysdiag.sanitizer import sanitize_dict\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.982838, "i", "CONFIG_PATH) -> dict:\n    \"\"\"Build the diagnostics dictionary from available collectors.\"\"\"\n    report = {\n        \"timestamp\": int(time.time()),\n        \"system\": collect_system_metrics(),\n        \"network\": collect_network_metrics(),\n        \"database\": collect_database_diagnostics(db_config_path),\n    }\n    return report\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=\"System Diagnostics Exporter\")\n    parser.add_argument(\n        \"--output\",\n        \"-o\",\n        default=\"/var/diagnostics/report.json\",\n        help=\"Destination path for diagnostics report JSON\",\n    )\n    parser.add_argument(\n        \"--db-config\",\n        default=DEFAULT_DB_CONFIG_PATH,\n        help=\"Path to database configuration file\",\n    )\n    args = parser.parse_args()\n\n    report = sanitize_dict(build_report(args.db_config))\n\n    # Ensure output directory exists\n    output_dir = os.path.dirname(os.path.abspath(args.output))\n    if output_dir and not os.path.exists(output_dir):\n        os.makedirs(output_dir, exist_ok"]
[48.983038, "o", "DEFAULT_DB_CONFIG_PATH = \"/etc/sysdiag/database.conf\"\r\n\u001b[?2004l\r\u001b[?2004h> REQUIRED_DB_CONFIG_KEYS = (\"host\", \"port\", \"database\", \"user\", \"password\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[48.983047, "i", "=True)\n\n    with open(args.output, \"w\", encoding=\"utf-8\") as f:\n        json.dump(report, f, indent=2)\n\n    print(f\"Report written successfully to {args.output}\")\n\n\nif __name__ == \"__main__\":\n    main()\nPY\npython -m sysdiag.cli --output /tmp/sysdiag-report.json --db-config etc/database.conf\ncat /tmp/sysdiag-report.json\n"]
[48.983058, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.984055, "o", "def _safe_int(value: Any, default: int = 0) -> int:\r\n\u001b[?2004l\r\u001b[?2004h"]
[48.984232, "o", "> "]
[48.984526, "o", "    \"\"\"Convert a value to int, returning default if conversion fails.\"\"\""]
[48.984541, "o", "\r\n"]
[48.984597, "o", "\u001b[?2004l\r"]
[48.984643, "o", "\u001b[?2004h"]
[48.984662, "o", "> "]
[48.984775, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[48.984807, "o", "> "]
[48.98526, "o", "        return int(value)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.985608, "o", "    except (TypeError, ValueError):\r\n\u001b[?2004l\r\u001b[?2004h>         return default\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[48.985667, "o", "\u001b[?2004h"]
[48.98579, "o", "> "]
[48.986014, "o", "def _safe_float(value: Any, default: float = 0.0) -> float:\r\n\u001b[?2004l\rre\u001b[?2004h"]
[48.98613, "o", "> "]
[48.986977, "o", "    \"\"\"Convert a value to float, returning default if conversion fails.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         return float(value)\r\n\u001b[?2004l\rt\u001b[?2004h>     except (TypeError, ValueError):\r\n\u001b[?2004l\r\u001b[?2004h>         return default\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rn\u001b[?2004h> \r\n\u001b[?2004l\rd\u001b[?2004h> def load_database_config(config_path: str) -> dict:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r"]
[48.987027, "o", "\u001b[?2004h> "]
[48.987308, "o", "    Load database connection settings from an INI-style configuration file.\r\n\u001b[?2004l\r"]
[48.987367, "o", "\u001b[?2004h> "]
[48.987438, "o", "\r\n\u001b[?2004l\r\r\n"]
[48.987498, "o", "\u001b[?2004h"]
[48.987587, "o", "> "]
[48.98788, "o", "    The expected format is a [database] section containing host, port, database,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.988161, "o", "    user, and password keys. For compatibility with simple key=value files, a\r\n\u001b[?2004l\r"]
[48.988243, "o", "\u001b[?2004h> "]
[48.988594, "o", "    file without any section header is also accepted and treated as [database].\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.988671, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[48.988756, "o", "\u001b[?2004h> "]
[48.988967, "o", "    with open(config_path, \"r\", encoding=\"utf-8\") as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.98999, "o", "        contents = f.read()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     parser = configparser.ConfigParser(interpolation=None)\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         parser.read_string(contents)\r\n\u001b[?2004l\r\u001b[?2004h>     except configparser.MissingSectionHeaderError:\r\n\u001b[?2004l\r\u001b[?2004h>         parser.read_string(\"[database]\\n\" + contents)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if parser.has_section(\"database\"):\r\n\u001b[?2004l\r\u001b[?2004h>         return {key: value for key, value in parser.items(\"database\")}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # Fall back to defaults if a config file supplies only DEFAULT values.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.990171, "o", "    return {key: value for key, value in parser.defaults().items()}"]
[48.990189, "o", "\r\n"]
[48.990242, "o", "\u001b[?2004l\r"]
[48.990323, "o", "\u001b[?2004h"]
[48.990378, "o", "> "]
[48.990439, "o", "\r\n"]
[48.990477, "o", "\u001b[?2004l\r"]
