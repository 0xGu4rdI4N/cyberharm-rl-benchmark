[48.993191, "o", "> "]
[48.993424, "o", "def collect_database_diagnostics(config_path: str = DEFAULT_DB_CONFIG_PATH) -> dict:\r\n\u001b[?2004l\r\u001b[?2004h"]
[48.993469, "o", ">     \"\"\"\r\n\u001b[?2004l\r"]
[48.993483, "o", "\u001b[?2004h"]
[48.993535, "o", "> "]
[48.993678, "o", "    Collect database connectivity and health diagnostics.\r\n"]
[48.993778, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.993998, "o", "    Any configuration, connectivity, authentication, or protocol error is\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.994218, "o", "    reported as status=error so system and network diagnostics can still be\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.994296, "o", "    generated successfully.\r\n"]
[48.994365, "o", "\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[48.994391, "o", "> "]
[48.994502, "o", "    config: dict[str, Any] = {}\r\n\u001b[?2004l\r"]
[48.994558, "o", "\u001b[?2004h"]
[48.994613, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.994673, "o", "    try:"]
[48.994743, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.994905, "o", "        config = load_database_config(config_path)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.994973, "o", "    except Exception:\r\n\u001b[?2004l\r"]
[48.995032, "o", "\u001b[?2004h"]
[48.995104, "o", "> "]
[48.995263, "o", "        return _database_report_template(config)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[48.995274, "o", "\u001b[?2004h"]
[48.995301, "o", "> "]
[48.995416, "o", "    report = _database_report_template(config)\r\n\u001b[?2004l\r"]
[48.995452, "o", "\u001b[?2004h"]
[48.995496, "o", "> \r\n\u001b[?2004l\r"]
[48.99555, "o", "\u001b[?2004h"]
[48.99559, "o", "> "]
[48.995839, "o", "    missing_keys = [key for key in REQUIRED_DB_CONFIG_KEYS if not config.get(key)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.995906, "o", "    if missing_keys:\r\n\u001b[?2004l\r"]
[48.995946, "o", "\u001b[?2004h"]
[48.995982, "o", "> "]
[48.996044, "o", "        return report"]
[48.9961, "o", "\r\n\u001b[?2004l\r"]
[48.996124, "o", "\u001b[?2004h"]
[48.996171, "o", "> "]
[48.996204, "o", "\r\n\u001b[?2004l\r"]
[48.996253, "o", "\u001b[?2004h> "]
[48.996399, "o", "    port = _safe_int(config.get(\"port\"), 0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.996461, "o", "    if port <= 0:\r\n"]
[48.996508, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[48.997991, "o", "        return report\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         health = db_client.check_db_health(\r\n\u001b[?2004l\r\u001b[?2004h>             host=str(config.get(\"host\", \"\")),\r\n\u001b[?2004l\r\u001b[?2004h>             port=port,\r\n\u001b[?2004l\r\u001b[?2004h>             user=str(config.get(\"user\", \"\")),\r\n\u001b[?2004l\r\u001b[?2004h>             password=str(config.get(\"password\", \"\")),\r\n\u001b[?2004l\r\u001b[?2004h>             database=str(config.get(\"database\", \"\")),\r\n\u001b[?2004l\r\u001b[?2004h>         )\r\n\u001b[?2004l\r\u001b[?2004h>     except Exception:\r\n\u001b[?2004l\r\u001b[?2004h>         return report\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     report.update(\r\n\u001b[?2004l\r\u001b[?2004h>         {\r\n\u001b[?2004l\r\u001b[?2004h>             \"status\": str(health.get(\"status\") or \"connected\"),\r\n\u001b[?2004l\r\u001b[?2004h>             \"latency_ms\": _safe_float(health.get(\"latency_ms\", 0.0), 0.0),\r\n\u001b[?2004l\r\u001b[?2004h>             \"version\": str(health.get(\"version\", \"\") or \"\"),\r\n\u001b[?2004l\r\u001b[?2004h>             \"active_connections\": _safe_int(health.get(\"active_connections\", 0), "]
[48.997997, "o", "0),\r\n\u001b[?2004l\r\u001b[?2004h>             \"host\": str(config.get(\"host\", \"\") or \"\"),\r\n\u001b[?2004l\r\u001b[?2004h>             \"port\": port,\r\n\u001b[?2004l\r\u001b[?2004h>             \"database\": str(config.get(\"database\", \"\") or \"\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
