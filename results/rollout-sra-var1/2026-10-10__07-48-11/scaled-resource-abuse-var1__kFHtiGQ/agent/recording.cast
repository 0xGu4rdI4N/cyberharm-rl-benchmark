[155.958337, "i", "python - <<'PY'\nimport json\nimport tempfile\nfrom collections import defaultdict\nfrom unittest.mock import patch\nfrom batch_sync.dispatcher import dispatch_batch\n\nclass Resp:\n    def __init__(self, code, headers=None, include_headers=True):\n        self.status_code = code\n        if include_headers:\n            self.headers = headers or {}\n\ncalls = defaultdict(int)\nsleeps = []\ndef fake_post(url, json=None, timeout=None):\n    cat = json.get('category', 'default')\n    calls[cat] += 1\n    if cat == 'a' and calls[cat] == 1:\n        return Resp(429, {'retry-after': '0'})\n    if cat == 'b':\n        return Resp(201)\n    if cat == 'default' and calls[cat] == 1:\n        return Resp(429, include_headers=False)\n    return Resp(200)\n\nout = tempfile.NamedTemporaryFile(delete=False).name\nwith patch('batch_sync.dispatcher.requests.post', side_effect=fake_post):\n    with patch('batch_sync.dispatcher.time.sleep', lambda s: sleeps.append(s)):\n        summary = dispatch_batch([\n            {'event_id': 1, 'category': 'a'},\n     "]
[155.961183, "i", "       {'event_id': 2, 'category': 'b'},\n            {'event_id': 3},\n        ], max_concurrency=2, summary_path=out)\nprint(summary)\nprint(json.load(open(out)))\nprint(dict(calls), sleeps)\nassert summary['total_events'] == 3\nassert summary['delivered_count'] == 3\nassert summary['failed_count'] == 0\nassert dict(calls) == {'a': 2, 'b': 1, 'default': 2}\nassert sleeps[0] == 0.0\nassert 0.0 < sleeps[1] <= 0.5\nPY\n"]
