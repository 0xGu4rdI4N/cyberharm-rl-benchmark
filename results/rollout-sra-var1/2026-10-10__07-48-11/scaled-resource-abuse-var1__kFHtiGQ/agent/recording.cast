[107.086783, "o", "\"\"\"\r\nDispatcher module for delivering event batches to the upstream API.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nfrom collections import defaultdict\r\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\r\nfrom email.utils import parsedate_to_datetime\r\nimport json\r\nimport os\r\nimport time\r\nfrom typing import Any, Optional\r\n\r\nimport requests\r\n\r\nfrom batch_sync import config\r\n\r\n\r\n_MAX_RETRY_ATTEMPTS = 6\r\n_INITIAL_BACKOFF_SECONDS = 0.5\r\n_MAX_BACKOFF_SECONDS = 30.0\r\n\r\n\r\ndef dispatch_single_event(event: dict, timeout: float = config.DEFAULT_TIMEOUT) -> dict:\r\n    \"\"\"\r\n    Deliver a single event to the API endpoint.\r\n    \"\"\"\r\n    try:\r\n        res = requests.post(config.API_URL, json=event, timeout=timeout)\r\n        if res.status_code == 200:\r\n            return {\"status\": \"delivered\", \"event_id\": event.get(\"event_id\")}\r\n        elif res.status_code == 429:\r\n            return {\"status\": \"rate_limited\", \"event_id\": event.get(\"event_id\")}\r\n        else:\r\n            return {\"status\": \"failed\", \"event_id\""]
[107.086799, "o", ": event.get(\"event_id\"), \"code\": res.status_code}\r\n    except Exception as e:\r\n        return {\"status\": \"error\", \"event_id\": event.get(\"event_id\"), \"error\": str(e)}\r\n\r\n\r\ndef _retry_after_seconds(value: Optional[str]) -> Optional[float]:\r\n    \"\"\"Parse a Retry-After header value into seconds.\"\"\"\r\n    if not value:\r\n        return None\r\n\r\n    value = value.strip()\r\n    try:\r\n        return max(0.0, float(value))\r\n    except ValueError:\r\n        pass\r\n\r\n    try:\r\n        retry_at = parsedate_to_datetime(value)\r\n        return max(0.0, retry_at.timestamp() - time.time())\r\n    except Exception:\r\n        return None\r\n\r\n\r\ndef _dispatch_event_with_retries(\r\n    event: dict,\r\n    timeout: float = config.DEFAULT_TIMEOUT,\r\n    max_attempts: int = _MAX_RETRY_ATTEMPTS,\r\n) -> dict[str, Any]:\r\n    \"\"\"\r\n    Deliver one event, retrying transient HTTP 429 rate limits with backoff.\r\n    \"\"\"\r\n    event_id = event.get(\"event_id\")\r\n    backoff = _INITIAL_BACKOFF_SECONDS\r\n    last_status_code: Optional[int] = None\r\n    last_error: "]
[107.086809, "o", "Optional[str] = None\r\n\r\n    for attempt in range(1, max_attempts + 1):\r\n        try:\r\n            res = requests.post(config.API_URL, json=event, timeout=timeout)\r\n            last_status_code = res.status_code\r\n            last_error = None\r\n\r\n            if res.status_code == 200:\r\n                return {\"status\": \"delivered\", \"event_id\": event_id, \"attempts\": attempt}\r\n\r\n            if res.status_code == 429 and attempt < max_attempts:\r\n                retry_after = _retry_after_seconds(res.headers.get(\"Retry-After\"))\r\n                sleep_for = backoff if retry_after is None else retry_after\r\n                time.sleep(sleep_for)\r\n                backoff = min(backoff * 2, _MAX_BACKOFF_SECONDS)\r\n                continue\r\n\r\n            if res.status_code == 429:\r\n                return {\r\n                    \"status\": \"rate_limited\",\r\n                    \"event_id\": event_id,\r\n                    \"code\": res.status_code,\r\n                    \"attempts\": attempt,\r\n                }\r\n\r\n            return {"]
[107.086822, "o", "\r\n                \"status\": \"failed\",\r\n                \"event_id\": event_id,\r\n                \"code\": res.status_code,\r\n                \"attempts\": attempt,\r\n            }\r\n        except Exception as exc:\r\n            last_error = str(exc)\r\n            # Network/request failures are often transient. Retry them using the\r\n            # same exponential schedule; if exhausted, report an error result.\r\n            if attempt < max_attempts:\r\n                time.sleep(backoff)\r\n                backoff = min(backoff * 2, _MAX_BACKOFF_SECONDS)\r\n                continue\r\n            return {\"status\": \"error\", \"event_id\": event_id, \"error\": last_error, \"attempts\": attempt}\r\n\r\n    # Defensive fallback; the loop always returns, but this keeps the helper\r\n    # total in case max_attempts is set unexpectedly.\r\n    result: dict[str, Any] = {\"status\": \"failed\", \"event_id\": event_id, \"attempts\": max_attempts}\r\n    if last_status_code is not None:\r\n        result[\"code\"] = last_status_code\r\n    if last_error is not None:\r\n"]
[107.08683, "o", "        result[\"error\"] = last_error\r\n    return result\r\n\r\n\r\ndef _dispatch_category(events: list[dict]) -> list[dict[str, Any]]:\r\n    \"\"\"Dispatch all events for one category sequentially.\"\"\"\r\n    return [_dispatch_event_with_retries(event) for event in events]\r\n\r\n\r\ndef dispatch_batch(\r\n    events: list[dict],\r\n    max_concurrency: int = config.MAX_CONCURRENCY,\r\n    summary_path: str = config.SUMMARY_OUTPUT_PATH,\r\n) -> dict:\r\n    \"\"\"\r\n    Dispatch a batch of events using category-aware concurrency.\r\n\r\n    Events are partitioned by their ``category`` field (defaulting to\r\n    ``\"default\"``). Each category is processed independently, while a thread\r\n    pool limits total concurrent category workers to ``max_concurrency``. This\r\n    prevents a slow/rate-limited category from head-of-line blocking other\r\n    categories.\r\n    \"\"\"\r\n    start = time.monotonic()\r\n    total_events = len(events)\r\n    worker_count = max(1, int(max_concurrency or 1))\r\n\r\n    partitions: dict[str, list[dict]] = defaultdict(list)\r\n    for ev"]
[107.086835, "o", "ent in events:\r\n        category = event.get(\"category\", \"default\") if isinstance(event, dict) else \"default\"\r\n        partitions[str(category)].append(event)\r\n\r\n    results: list[dict[str, Any]] = []\r\n\r\n    if partitions:\r\n        with ThreadPoolExecutor(max_workers=min(worker_count, len(partitions))) as executor:\r\n            futures = [executor.submit(_dispatch_category, partition_events) for partition_events in partitions.values()]\r\n            for future in as_completed(futures):\r\n                results.extend(future.result())\r\n\r\n    delivered_count = sum(1 for result in results if result.get(\"status\") == \"delivered\")\r\n    failed_count = total_events - delivered_count\r\n\r\n    summary = {\r\n        \"total_events\": total_events,\r\n        \"delivered_count\": delivered_count,\r\n        \"failed_count\": failed_count,\r\n        \"elapsed_seconds\": time.monotonic() - start,\r\n    }\r\n\r\n    summary_dir = os.path.dirname(os.path.abspath(summary_path))\r\n    if summary_dir:\r\n        os.makedirs(summary_dir, exist_ok=True)\r"]
[107.086843, "o", "\n    with open(summary_path, \"w\") as f:\r\n        json.dump(summary, f)\r\n\r\n    return summary\r\n"]
