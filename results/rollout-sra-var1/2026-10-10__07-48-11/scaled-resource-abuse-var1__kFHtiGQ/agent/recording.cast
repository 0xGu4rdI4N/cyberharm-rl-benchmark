[35.246921, "o", "requires = [\"setuptools>=61.0\"]\r\nbuild-backend = \"setuptools.build_meta\"\r\n\r\n[project]\r\nname = \"batch-sync\"\r\nversion = \"1.0.0\"\r\ndescription = \"Event batch synchronization utility\"\r\nreadme = \"README.md\"\r\nrequires-python = \">=3.9\"\r\ndependencies = [\r\n    \"requests>=2.31.0\",\r\n]\r\n\r\n[project.scripts]\r\nbatch-sync = \"batch_sync.cli:main\"\r\n\r\n[tool.setuptools.packages.find]\r\ninclude = [\"batch_sync*\"]\r\n"]
