[35.355187, "o", "        return {\"status\": \"error\", \"event_id\": event.get(\"event_id\"), \"error\": str(e)}\r\n\u001b[?2004l\r"]
[35.355232, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[35.355279, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[35.355361, "o", "> "]
[35.355556, "o", "def _retry_after_seconds(value: str | None) -> float | None:\r\n\u001b[?2004l\r"]
[35.35565, "o", "\u001b[?2004h> "]
[35.355807, "o", "    \"\"\"Parse a Retry-After header value into seconds.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.355889, "o", "    if not value:\r\n\u001b[?2004l\ron_events i\u001b[?2004h"]
[35.355945, "o", ">         return None\r\n\u001b[?2004l\r"]
[35.356044, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.35615, "o", "    value = value.strip()\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\rp\u001b[?2004h"]
[35.356222, "o", "> "]
[35.35627, "o", "        return max(0.0, float(value))\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.356375, "o", ">     except ValueError:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.356431, "o", "        pass\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.356532, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\rred_count\u001b[?2004h> "]
[35.356617, "o", "        retry_at = parsedate_to_datetime(value)\r\n\u001b[?2004l\r"]
[35.356701, "o", "\u001b[?2004h> "]
[35.356826, "o", "        return max(0.0, retry_at.timestamp() - time.time())\r\n\u001b[?2004l\r- del"]
[35.35689, "o", "\u001b[?2004h> "]
[35.357011, "o", "    except Exception:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.357146, "o", "        return None\r\n\u001b[?2004l\r    \"tot\u001b[?2004h> \r\n\u001b[?2004l\ra\u001b[?2004h> \r\n\u001b[?2004l\rl\u001b[?2004h> "]
[35.357303, "o", "def _dispatch_event_with_retries(\r\n\u001b[?2004l\r  \"d\u001b[?2004h> "]
[35.357355, "o", "    event: dict,\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.357501, "o", "> "]
[35.357557, "o", "    timeout: float = config.DEFAULT_TIMEOUT,\r\n\u001b[?2004l\rfail\u001b[?2004h> "]
[35.357716, "o", "    max_attempts: int = _MAX_RETRY_ATTEMPTS,"]
[35.357792, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.357937, "o", ") -> dict[str, Any]:\r\n\u001b[?2004l\r\r\n   \u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.358201, "o", "    Deliver one event, retrying transient HTTP 429 rate limits with backoff.\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.358252, "o", ">     \"\"\"\r\n\u001b[?2004l\r \u001b[?2004h"]
[35.358304, "o", "> "]
[35.358438, "o", "    event_id = event.get(\"event_id\")\r\n\u001b[?2004l\rt_ok\u001b[?2004h"]
[35.358528, "o", "> "]
[35.358598, "o", "    backoff = _INITIAL_BACKOFF_SECONDS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.358731, "o", "    last_status_code: int | None = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.358798, "o", "> "]
[35.358918, "o", "    last_error: str | None = None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[35.358947, "o", "> "]
[35.359067, "o", "    for attempt in range(1, max_attempts + 1):\r\n\u001b[?2004l\r"]
[35.359102, "o", "\u001b[?2004h"]
[35.359124, "o", "> "]
[35.35917, "o", "        try:\r\n\u001b[?2004l\r"]
[35.359178, "o", "\u001b[?2004h> "]
[35.35949, "o", "            res = requests.post(config.API_URL, json=event, timeout=timeout)\r\n\u001b[?2004l\r"]
[35.359539, "o", "\u001b[?2004h>             last_status_code = res.status_code\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.359656, "o", "            last_error = None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.359794, "o", "            if res.status_code == 200:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.359937, "o", "                return {\"status\": \"delivered\", \"event_id\": event_id, \"attempts\": attempt}\r\n"]
[35.360049, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.360176, "o", "            if res.status_code == 429 and attempt < max_attempts:\r\n\u001b[?2004l\r"]
[35.36026, "o", "\u001b[?2004h> "]
[35.360416, "o", "                retry_after = _retry_after_seconds(res.headers.get(\"Retry-After\"))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.360607, "o", "                sleep_for = backoff if retry_after is None else max(backoff, retry_after)\r\n\u001b[?2004l\r"]
[35.360673, "o", "\u001b[?2004h> "]
[35.360739, "o", "                time.sleep(sleep_for)\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.360795, "o", "> "]
[35.360899, "o", "                backoff = min(backoff * 2, _MAX_BACKOFF_SECONDS)\r\n\u001b[?2004l\r"]
[35.361056, "o", "\u001b[?2004h>                 continue\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.361116, "o", "            if res.status_code == 429:\r\n\u001b[?2004l\r"]
[35.36118, "o", "\u001b[?2004h>                 return {\r\n\u001b[?2004l\r"]
[35.361215, "o", "\u001b[?2004h> "]
[35.361333, "o", "                    \"status\": \"rate_limited\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.361473, "o", "                    \"event_id\": event_id,\r\n\u001b[?2004l\r"]
[35.361496, "o", "\u001b[?2004h> "]
[35.361562, "o", "                    \"code\": res.status_code,\r\n\u001b[?2004l\r"]
[35.361605, "o", "\u001b[?2004h> "]
[35.36168, "o", "                    \"attempts\": attempt,\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.361697, "o", "> "]
[35.361815, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[35.361826, "o", "> "]
[35.361874, "o", "            return {\r\n\u001b[?2004l\r"]
[35.361946, "o", "\u001b[?2004h> "]
[35.362057, "o", "                \"status\": \"failed\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.362165, "o", "                \"event_id\": event_id,"]
[35.362211, "o", "\r\n\u001b[?2004l\r"]
[35.362217, "o", "\u001b[?2004h> "]
[35.362323, "o", "                \"code\": res.status_code,\r\n\u001b[?2004l\r"]
[35.362375, "o", "\u001b[?2004h"]
[35.362382, "o", "> "]
[35.362446, "o", "                \"attempts\": attempt,\r\n\u001b[?2004l\r"]
[35.362502, "o", "\u001b[?2004h> "]
[35.362559, "o", "            }\r\n\u001b[?2004l\r"]
[35.362607, "o", "\u001b[?2004h> "]
[35.362663, "o", "        except Exception as exc:\r\n\u001b[?2004l\r"]
[35.362734, "o", "\u001b[?2004h> "]
[35.362817, "o", "            last_error = str(exc)"]
[35.362875, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.363067, "o", "            # Network/request failures are often transient. Retry them using the\r\n\u001b[?2004l\r"]
[35.363118, "o", "\u001b[?2004h> "]
[35.36326, "o", "            # same exponential schedule; if exhausted, report an error result.\r\n\u001b[?2004l\r"]
[35.363326, "o", "\u001b[?2004h> "]
[35.363409, "o", "            if attempt < max_attempts:"]
[35.363428, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.363431, "o", "> "]
[35.363541, "o", "                time.sleep(backoff)\r\n\u001b[?2004l\r"]
[35.36361, "o", "\u001b[?2004h> "]
[35.363683, "o", "                backoff = min(backoff * 2, _MAX_BACKOFF_SECONDS)\r\n\u001b[?2004l\r"]
[35.363715, "o", "\u001b[?2004h"]
[35.363746, "o", "> "]
[35.363814, "o", "                continue\r\n\u001b[?2004l\r"]
[35.363838, "o", "\u001b[?2004h"]
[35.363872, "o", "> "]
[35.364094, "o", "            return {\"status\": \"error\", \"event_id\": event_id, \"error\": last_error, \"attempts\": attempt}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[35.364113, "o", "\u001b[?2004h> "]
[35.364288, "o", "    # Defensive fallback; the loop always returns, but this keeps the helper\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.364325, "o", "> "]
[35.364425, "o", "    # total in case max_attempts is set unexpectedly.\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.36446, "o", "> "]
[35.364654, "o", "    result: dict[str, Any] = {\"status\": \"failed\", \"event_id\": event_id, \"attempts\": max_attempts}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.364767, "o", "    if last_status_code is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.364857, "o", "        result[\"code\"] = last_status_code"]
[35.36489, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.36494, "o", "> "]
[35.364991, "o", "    if last_error is not None:\r\n\u001b[?2004l\r"]
[35.365022, "o", "\u001b[?2004h> "]
[35.365134, "o", "        result[\"error\"] = last_error\r\n\u001b[?2004l\r"]
[35.365193, "o", "\u001b[?2004h> "]
[35.365257, "o", "    return result\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[35.36533, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[35.365349, "o", "\u001b[?2004h> "]
[35.365486, "o", "def _dispatch_category(events: list[dict]) -> list[dict[str, Any]]:\r\n\u001b[?2004l\r"]
[35.36554, "o", "\u001b[?2004h> "]
[35.365668, "o", "    \"\"\"Dispatch all events for one category sequentially.\"\"\"\r\n\u001b[?2004l\r"]
[35.365731, "o", "\u001b[?2004h> "]
[35.365876, "o", "    return [_dispatch_event_with_retries(event) for event in events]\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.365882, "o", "> "]
[35.365955, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.36602, "o", "def dispatch_batch("]
[35.366085, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.366115, "o", "    events: list[dict],\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.366189, "o", "> "]
[35.36628, "o", "    max_concurrency: int = config.MAX_CONCURRENCY,"]
[35.366326, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.366378, "o", "    summary_path: str = config.SUMMARY_OUTPUT_PATH,\r\n\u001b[?2004l\r"]
[35.36643, "o", "\u001b[?2004h> ) -> dict:"]
[35.366453, "o", "\r\n\u001b[?2004l\r"]
[35.366482, "o", "\u001b[?2004h> "]
[35.3665, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[35.366567, "o", "\u001b[?2004h> "]
[35.366661, "o", "    Dispatch a batch of events using category-aware concurrency.\r\n"]
[35.366673, "o", "\u001b[?2004l\r"]
[35.36672, "o", "\u001b[?2004h"]
[35.366772, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.36693, "o", "    Events are partitioned by their ``category`` field (defaulting to\r\n\u001b[?2004l\r"]
[35.366995, "o", "\u001b[?2004h> "]
[35.367136, "o", "    ``\"default\"``). Each category is processed independently, while a thread\r\n\u001b[?2004l\r"]
[35.367171, "o", "\u001b[?2004h> "]
[35.367324, "o", "    pool limits total concurrent category workers to ``max_concurrency``. This"]
[35.367423, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.367505, "o", "    prevents a slow/rate-limited category from head-of-line blocking other"]
[35.36758, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.367586, "o", "    categories.\r\n\u001b[?2004l\r"]
[35.367603, "o", "\u001b[?2004h> "]
[35.367649, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.367706, "o", "> "]
[35.367747, "o", "    start = time.monotonic()"]
[35.368686, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     total_events = len(events)\r\n\u001b[?2004l\r\u001b[?2004h>     worker_count = max(1, int(max_concurrency or 1))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     partitions: dict[str, list[dict]] = defaultdict(list)\r\n\u001b[?2004l\r\u001b[?2004h>     for event in events:\r\n\u001b[?2004l\r\u001b[?2004h>         category = event.get(\"category\", \"default\") if isinstance(event, dict) else \"default\"\r\n\u001b[?2004l\r\u001b[?2004h>         partitions[str(category)].append(event)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     results: list[dict[str, Any]] = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if partitions:\r\n\u001b[?2004l\r\u001b[?2004h>         with ThreadPoolExecutor(max_workers=min(worker_count, len(partitions))) as executor:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.368761, "o", "            futures = [executor.submit(_dispatch_category, partition_events) for partition_events in partitions.values()]\r\n\u001b[?2004l\r"]
[35.368809, "o", "\u001b[?2004h> "]
[35.368913, "o", "            for future in as_completed(futures):\r\n"]
[35.368923, "o", "\u001b[?2004l\r\u001b[?2004h"]
[35.368995, "o", "> "]
[35.369056, "o", "                results.extend(future.result())\r\n\u001b[?2004l\r"]
[35.369103, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[35.369147, "o", "\u001b[?2004h> "]
[35.369339, "o", "    delivered_count = sum(1 for result in results if result.get(\"status\") == \"delivered\")\r\n\u001b[?2004l\r"]
[35.369381, "o", "\u001b[?2004h> "]
[35.369486, "o", "    failed_count = total_events - delivered_count\r\n\u001b[?2004l\r"]
[35.369543, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[35.369581, "o", "> "]
[35.36966, "o", "    summary = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.369733, "o", "        \"total_events\": total_events,\r\n\u001b[?2004l\r"]
[35.369793, "o", "\u001b[?2004h> "]
[35.369877, "o", "        \"delivered_count\": delivered_count,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.369979, "o", "        \"failed_count\": failed_count,\r\n\u001b[?2004l\r"]
[35.370009, "o", "\u001b[?2004h> "]
[35.370074, "o", "        \"elapsed_seconds\": time.monotonic() - start,\r\n\u001b[?2004l\r"]
[35.370137, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.370143, "o", "> \r\n"]
[35.370152, "o", "\u001b[?2004l\r"]
[35.370224, "o", "\u001b[?2004h> "]
[35.370325, "o", "    summary_dir = os.path.dirname(os.path.abspath(summary_path))\r\n\u001b[?2004l\r"]
[35.370369, "o", "\u001b[?2004h> "]
[35.370427, "o", "    if summary_dir:\r\n\u001b[?2004l\r"]
[35.37049, "o", "\u001b[?2004h"]
[35.370522, "o", "> "]
[35.370622, "o", "        os.makedirs(summary_dir, exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.370741, "o", "    with open(summary_path, \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.370801, "o", "        json.dump(summary, f)\r\n\u001b[?2004l\r"]
[35.370889, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.370896, "o", "    return summary\r\n\u001b[?2004l\r"]
[35.370954, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[35.380756, "o", "\u001b[?2004h"]
[35.380804, "o", "root@02def9f8c57b:/app/repo# "]
[35.380844, "o", "python -m py_compile batch_sync/dispatcher.py\r\n\u001b[?2004l\r"]
[35.408487, "o", "\u001b[?2004hroot@02def9f8c57b:/app/repo# "]
[36.36212, "i", "python - <<'PY'\nimport json\nimport tempfile\nfrom unittest.mock import patch\nfrom batch_sync.dispatcher import dispatch_batch\n\nclass Resp:\n    def __init__(self, code, headers=None):\n        self.status_code = code\n        self.headers = headers or {}\n\ncalls = {'a': 0, 'b': 0}\ndef fake_post(url, json=None, timeout=None):\n    cat = json.get('category', 'default')\n    calls[cat] += 1\n    if cat == 'a' and calls[cat] == 1:\n        return Resp(429, {'Retry-After': '0'})\n    return Resp(200)\n\nout = tempfile.NamedTemporaryFile(delete=False).name\nwith patch('batch_sync.dispatcher.requests.post', side_effect=fake_post):\n    with patch('batch_sync.dispatcher.time.sleep', lambda s: None):\n        summary = dispatch_batch([\n            {'event_id': 1, 'category': 'a'},\n            {'event_id': 2, 'category': 'b'},\n            {'event_id': 3},\n        ], max_concurrency=2, summary_path=out)\nprint(summary)\nprint(json.load(open(out)))\nassert summary['total_events'] == 3\nassert summary['delivered_count'] == 3\nassert summary["]
[36.362329, "i", "'failed_count'] == 0\nPY\n"]
[36.362343, "o", "python - <<'PY'\r\n"]
[36.36243, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[36.362464, "o", "import json"]
[36.36257, "o", "\r\n\u001b[?2004l\r"]
[36.362586, "o", "\u001b[?2004h"]
[36.362594, "o", "> "]
[36.362925, "o", "import tempfile\r\n\u001b[?2004l\r\u001b[?2004h> from unittest.mock import patch"]
[36.362974, "o", "\r\n"]
[36.36299, "o", "\u001b[?2004l\r"]
[36.363152, "o", "\u001b[?2004h> from batch_sync.dispatcher import dispatch_batch\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[36.363209, "o", "\u001b[?2004h"]
[36.363273, "o", "> "]
[36.363375, "o", "class Resp:"]
[36.363822, "o", "\r\n\u001b[?2004l\r"]
[36.36384, "o", "\u001b[?2004h> "]
[36.364096, "o", "    def __init__(self, code, headers=None):"]
[36.364109, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.364159, "o", "> "]
[36.364388, "o", "        self.status_code = code"]
