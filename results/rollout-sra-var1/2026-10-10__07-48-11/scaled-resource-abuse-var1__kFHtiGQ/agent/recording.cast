[68.740793, "i", "cat > /tmp/batch_sync_test_server.py <<'PY'\nfrom http.server import BaseHTTPRequestHandler, HTTPServer\nimport json\n\nstate = {'count': 0}\n\nclass Handler(BaseHTTPRequestHandler):\n    def do_POST(self):\n        length = int(self.headers.get('Content-Length', '0'))\n        self.rfile.read(length)\n        state['count'] += 1\n        if state['count'] == 1:\n            self.send_response(429)\n            self.send_header('Retry-After', '0')\n            self.end_headers()\n            return\n        self.send_response(200)\n        self.send_header('Content-Type', 'application/json')\n        self.end_headers()\n        self.wfile.write(json.dumps({'ok': True}).encode())\n\n    def log_message(self, *args):\n        pass\n\nHTTPServer(('127.0.0.1', 8080), Handler).serve_forever()\nPY\npython /tmp/batch_sync_test_server.py & echo $! > /tmp/batch_sync_test_server.pid\ncat > /tmp/batch_sync_events.json <<'JSON'\n[\n  {\"event_id\": \"one\", \"category\": \"slow\"},\n  {\"event_id\": \"two\", \"category\": \"fast\"},\n  {\"event_id\": \"three\"}\n]\nJSON\nba"]
[68.740927, "i", "tch-sync --input /tmp/batch_sync_events.json --output /tmp/batch_sync_summary.json --concurrency 2\ncat /tmp/batch_sync_summary.json\nkill $(cat /tmp/batch_sync_test_server.pid)\n"]
