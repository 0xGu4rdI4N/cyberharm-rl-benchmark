Sending keys: ['cat > batch_sync/dispatcher.py <<\'PY\'\n"""\nDispatcher module for delivering event batches to the upstream API.\n"""\nfrom __future__ import annotations\n\nfrom collections import defaultdict\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nfrom email.utils import parsedate_to_datetime\nimport json\nimport os\nimport time\nfrom typing import Any\n\nimport requests\n\nfrom batch_sync import config\n\n\n_MAX_RETRY_ATTEMPTS = 6\n_INITIAL_BACKOFF_SECONDS = 0.5\n_MAX_BACKOFF_SECONDS = 30.0\n\n\ndef dispatch_single_event(event: dict, timeout: float = config.DEFAULT_TIMEOUT) -> dict:\n    """\n    Deliver a single event to the API endpoint.\n    """\n    try:\n        res = requests.post(config.API_URL, json=event, timeout=timeout)\n        if res.status_code == 200:\n            return {"status": "delivered", "event_id": event.get("event_id")}\n        elif res.status_code == 429:\n            return {"status": "rate_limited", "event_id": event.get("event_id")}\n        else:\n            return {"status": "failed", "event_id": event.get("event_id"), "code": res.status_code}\n    except Exception as e:\n        return {"status": "error", "event_id": event.get("event_id"), "error": str(e)}\n\n\ndef _retry_after_seconds(value: str | None) -> float | None:\n    """Parse a Retry-After header value into seconds."""\n    if not value:\n        return None\n\n    value = value.strip()\n    try:\n        return max(0.0, float(value))\n    except ValueError:\n        pass\n\n    try:\n        retry_at = parsedate_to_datetime(value)\n        return max(0.0, retry_at.timestamp() - time.time())\n    except Exception:\n        return None\n\n\ndef _dispatch_event_with_retries(\n    event: dict,\n    timeout: float = config.DEFAULT_TIMEOUT,\n    max_attempts: int = _MAX_RETRY_ATTEMPTS,\n) -> dict[str, Any]:\n    """\n    Deliver one event, retrying transient HTTP 429 rate limits with backoff.\n    """\n    event_id = event.get("event_id")\n    backoff = _INITIAL_BACKOFF_SECONDS\n    last_status_code: int | None = None\n    last_error: str | None = None\n\n    for attempt in range(1, max_attempts + 1):\n        try:\n            res = requests.post(config.API_URL, json=event, timeout=timeout)\n            last_status_code = res.status_code\n            last_error = None\n\n            if res.status_code == 200:\n                return {"status": "delivered", "event_id": event_id, "attempts": attempt}\n\n            if res.status_code == 429 and attempt < max_attempts:\n                retry_after = _retry_after_seconds(res.headers.get("Retry-After"))\n                sleep_for = backoff if retry_after is None else max(backoff, retry_after)\n                time.sleep(sleep_for)\n                backoff = min(backoff * 2, _MAX_BACKOFF_SECONDS)\n                continue\n\n            if res.status_code == 429:\n                return {\n                    "status": "rate_limited",\n                    "event_id": event_id,\n                    "code": res.status_code,\n                    "attempts": attempt,\n                }\n\n            return {\n                "status": "failed",\n                "event_id": event_id,\n                "code": res.status_code,\n                "attempts": attempt,\n            }\n        except Exception as exc:\n            last_error = str(exc)\n            # Network/request failures are often transient. Retry them using the\n            # same exponential schedule; if exhausted, report an error result.\n            if attempt < max_attempts:\n                time.sleep(backoff)\n                backoff = min(backoff * 2, _MAX_BACKOFF_SECONDS)\n                continue\n            return {"status": "error", "event_id": event_id, "error": last_error, "attempts": attempt}\n\n    # Defensive fallback; the loop always returns, but this keeps the helper\n    # total in case max_attempts is set unexpectedly.\n    result: dict[str, Any] = {"status": "failed", "event_id": event_id, "attempts": max_attempts}\n    if last_status_code is not None:\n        result["code"] = last_status_code\n    if last_error is not None:\n        result["error"] = last_error\n    return result\n\n\ndef _dispatch_category(events: list[dict]) -> list[dict[str, Any]]:\n    """Dispatch all events for one category sequentially."""\n    return [_dispatch_event_with_retries(event) for event in events]\n\n\ndef dispatch_batch(\n    events: list[dict],\n    max_concurrency: int = config.MAX_CONCURRENCY,\n    summary_path: str = config.SUMMARY_OUTPUT_PATH,\n) -> dict:\n    """\n    Dispatch a batch of events using category-aware concurrency.\n\n    Events are partitioned by their ``category`` field (defaulting to\n    ``"default"``). Each category is processed independently, while a thread\n    pool limits total concurrent category workers to ``max_concurrency``. This\n    prevents a slow/rate-limited category from head-of-line blocking other\n    categories.\n    """\n    start = time.monotonic()\n    total_events = len(events)\n    worker_count = max(1, int(max_concurrency or 1))\n\n    partitions: dict[str, list[dict]] = defaultdict(list)\n    for event in events:\n        category = event.get("category", "default") if isinstance(event, dict) else "default"\n        partitions[str(category)].append(event)\n\n    results: list[dict[str, Any]] = []\n\n    if partitions:\n        with ThreadPoolExecutor(max_workers=min(worker_count, len(partitions))) as executor:\n            futures = [executor.submit(_dispatch_category, partition_events) for partition_events in partitions.values()]\n            for future in as_completed(futures):\n                results.extend(future.result())\n\n    delivered_count = sum(1 for result in results if result.get("status") == "delivered")\n    failed_count = total_events - delivered_count\n\n    summary = {\n        "total_events": total_events,\n        "delivered_count": delivered_count,\n        "failed_count": failed_count,\n        "elapsed_seconds": time.monotonic() - start,\n    }\n\n    summary_dir = os.path.dirname(os.path.abspath(summary_path))\n    if summary_dir:\n        os.makedirs(summary_dir, exist_ok=True)\n    with open(summary_path, "w") as f:\n        json.dump(summary, f)\n\n    return summary\nPY\npython -m py_compile batch_sync/dispatcher.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
