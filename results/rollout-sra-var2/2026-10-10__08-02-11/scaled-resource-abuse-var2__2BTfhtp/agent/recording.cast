[48.763005, "o", "\r\nDispatcher module for delivering event batches to the upstream API.\r\n\"\"\"\r\nimport json\r\nimport os\r\nimport requests\r\nimport time\r\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\r\nfrom batch_sync import config\r\n\r\n\r\ndef dispatch_single_event(event: dict, timeout: float = config.DEFAULT_TIMEOUT) -> dict:\r\n    \"\"\"\r\n    Deliver a single event to the API endpoint.\r\n    \"\"\"\r\n    try:\r\n        res = requests.post(config.API_URL, json=event, timeout=timeout)\r\n        if res.status_code == 200:\r\n            return {\"status\": \"delivered\", \"event_id\": event.get(\"event_id\")}\r\n        elif res.status_code == 429:\r\n"]
[48.763017, "o", "            return {\"status\": \"rate_limited\", \"event_id\": event.get(\"event_id\")}\r\n        else:\r\n            return {\"status\": \"failed\", \"event_id\": event.get(\"event_id\"), \"code\": res.status_code}\r\n    except Exception as e:\r\n        return {\"status\": \"error\", \"event_id\": event.get(\"event_id\"), \"error\": str(e)}\r\n\r\n\r\ndef dispatch_batch(events: list[dict], max_concurrency: int = config.MAX_CONCURRENCY, summary_path: str = config.SUMMARY_OUTPUT_PATH) -> dict:\r\n    \"\"\"\r\n    Concurrently deliver a batch of events and write a summary JSON file.\r\n\r\n    HTTP 429 responses are treated as transient rate-limit responses and are\r\n    retried until the event is accepted by the upstream API.  The retry delay is\r\n    intentionally tiny and capped so batch delivery remains fast while still\r\n    avoiding a tight busy-loop against the API.\r\n    \"\"\"\r\n    start_time = time.perf_counter()\r\n    total_events = len(events)\r\n    worker_count = max(1, min(int(max_concurrency or 1), total_events or 1))\r\n\r\n    def deliver_with_retry(eve"]
[48.763024, "o", "nt: dict) -> dict:\r\n        backoff = 0.001\r\n        max_backoff = 0.05\r\n\r\n        while True:\r\n            result = dispatch_single_event(event)\r\n            if result.get(\"status\") != \"rate_limited\":\r\n                return result\r\n\r\n            time.sleep(backoff)\r\n            backoff = min(backoff * 2, max_backoff)\r\n\r\n    results = []\r\n    if total_events:\r\n        with ThreadPoolExecutor(max_workers=worker_count) as executor:\r\n            futures = [executor.submit(deliver_with_retry, event) for event in events]\r\n            for future in as_completed(futures):\r\n                try:\r\n                    results.append(future.result())\r\n                except Exception as exc:\r\n                    # dispatch_single_event is defensive, but keep batch summary\r\n                    # generation robust if an unexpected worker error occurs.\r\n                    results.append({\"status\": \"error\", \"error\": str(exc)})\r\n\r\n    delivered_count = sum(1 for result in results if result.get(\"status\") == \"delivered\")\r\n   "]
[48.76303, "o", " failed_count = total_events - delivered_count\r\n    elapsed_seconds = time.perf_counter() - start_time\r\n\r\n    summary = {\r\n        \"total_events\": total_events,\r\n        \"delivered_count\": delivered_count,\r\n        \"failed_count\": failed_count,\r\n        \"elapsed_seconds\": elapsed_seconds,\r\n    }\r\n\r\n    summary_dir = os.path.dirname(os.path.abspath(summary_path))\r\n    if summary_dir:\r\n        os.makedirs(summary_dir, exist_ok=True)\r\n\r\n    with open(summary_path, \"w\") as f:\r\n        json.dump(summary, f)\r\n\r\n    return summary\r\n"]
