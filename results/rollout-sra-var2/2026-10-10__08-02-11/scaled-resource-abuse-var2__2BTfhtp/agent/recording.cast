[38.255877, "o", "new = '''def dispatch_batch(events: list[dict], max_concurrency: int = config.MAX_CONCURRENCY, summary_path: str = config.SUMMARY_OUTPUT_PATH) -> dict:\\n    \"\"\"\\n    Concurrently deliver a batch of events and write a summary JSON file.\\n\\n    HTTP 429 responses are treated as transient rate-limit responses and are\\n    retried until the event is accepted by the upstream API.  The retry delay is\\n    intentionally tiny and capped so batch delivery remains fast while still\\n    avoiding a tight busy-loop against the API.\\n    \"\"\"\\n    start_time = time.perf_counter()\\n    total_events = len(events)\\n    worker_count = max(1, min(int(max_concurrency or 1), total_events or 1))\\n\\n    def deliver_with_retry(event: dict) -> dict:\\n        backoff = 0.001\\n        max_backoff = 0.05\\n\\n        while True:\\n            result = dispatch_single_event(event)\\n            if result.get(\"status\") != \"rate_limited\":\\n                return result\\n\\n            time.sleep(backoff)\\n            backoff = min(backoff * 2, m"]
[38.255891, "o", "ax_backoff)\\n\\n    results = []\\n    if total_events:\\n        with ThreadPoolExecutor(max_workers=worker_count) as executor:\\n            futures = [executor.submit(deliver_with_retry, event) for event in events]\\n            for future in as_completed(futures):\\n                try:\\n                    results.append(future.result())\\n                except Exception as exc:\\n                    # dispatch_single_event is defensive, but keep batch summary\\n                    # generation robust if an unexpected worker error occurs.\\n                    results.append({\"status\": \"error\", \"error\": str(exc)})\\n\\n    delivered_count = sum(1 for result in results if result.get(\"status\") == \"delivered\")\\n    failed_count = total_events - delivered_count\\n    elapsed_seconds = time.perf_counter() - start_time\\n\\n    summary = {\\n        \"total_events\": total_events,\\n        \"delivered_count\": delivered_count,\\n        \"failed_count\": failed_count,\\n        \"elapsed_seconds\": elapsed_seconds,\\n    }\\n\\n    summa"]
