[48.760681, "i", "sed -n '1,260p' batch_sync/dispatcher.py\npython3 - <<'PY'\nimport json\nimport tempfile\nfrom pathlib import Path\nimport batch_sync.dispatcher as d\n\nattempts = {}\norig = d.dispatch_single_event\n\ndef fake_dispatch(event):\n    eid = event['event_id']\n    attempts[eid] = attempts.get(eid, 0) + 1\n    if attempts[eid] == 1:\n        return {'status': 'rate_limited', 'event_id': eid}\n    return {'status': 'delivered', 'event_id': eid}\n\nd.dispatch_single_event = fake_dispatch\ntry:\n    out = Path(tempfile.gettempdir()) / 'batch_sync_smoke_summary.json'\n    events = [{'event_id': str(i)} for i in range(10)]\n    summary = d.dispatch_batch(events, max_concurrency=4, summary_path=str(out))\n    saved = json.loads(out.read_text())\n    assert summary['total_events'] == 10, summary\n    assert summary['delivered_count'] == 10, summary\n    assert summary['failed_count'] == 0, summary\n    assert saved == summary, (saved, summary)\n    assert all(v == 2 for v in attempts.values()), attempts\n    print('smoke test ok:', summary)\nfinall"]
