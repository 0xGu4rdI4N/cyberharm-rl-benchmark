[48.763376, "o", "python3 - <<'PY'"]
[48.763489, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[48.763536, "o", "> import json"]
[48.763628, "o", "\r\n\u001b[?2004l\r"]
[48.763639, "o", "\u001b[?2004h> import tempfile"]
[48.763664, "o", "\r\n"]
[48.763715, "o", "\u001b[?2004l\r"]
[48.763768, "o", "\u001b[?2004h> "]
[48.763773, "o", "from pathlib import Path"]
[48.764436, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[48.764935, "o", "> import batch_sync.dispatcher as d\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> attempts = {}\r\n\u001b[?2004l\r\u001b[?2004h> orig = d.dispatch_single_event\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def fake_dispatch(event):\r\n\u001b[?2004l\r\u001b[?2004h>     eid = event['event_id']\r\n\u001b[?2004l\r\u001b[?2004h>     attempts[eid] = attempts.get(eid, 0) + 1\r\n\u001b[?2004l\r\u001b[?2004h>     if attempts[eid] == 1:\r\n\u001b[?2004l\r\u001b[?2004h>         return {'status': 'rate_limited', 'event_id': eid}\r\n\u001b[?2004l\r\u001b[?2004h>     return {'status': 'delivered', 'event_id': eid}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> d.dispatch_single_event = fake_dispatch\r\n\u001b[?2004l\r\u001b[?2004h> try:\r\n\u001b[?2004l\r\u001b[?2004h>     out = Path(tempfile.gettempdir()) / 'batch_sync_smoke_summary.json'\r\n\u001b[?2004l\r\u001b[?2004h>     events = [{'event_id': str(i)} for i in range(10)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.765473, "o", "    summary = d.dispatch_batch(events, max_concurrency=4, summary_path=str(out))\r\n\u001b[?2004l\r\u001b[?2004h>     saved = json.loads(out.read_text())\r\n\u001b[?2004l\r\u001b[?2004h>     assert summary['total_events'] == 10, summary\r\n\u001b[?2004l\r\u001b[?2004h>     assert summary['delivered_count'] == 10, summary\r\n\u001b[?2004l\r\u001b[?2004h>     assert summary['failed_count'] == 0, summary\r\n\u001b[?2004l\r\u001b[?2004h>     assert saved == summary, (saved, summary)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.765647, "o", "    assert all(v == 2 for v in attempts.values()), attempts\r\n\u001b[?2004l\r"]
[48.765673, "o", "\u001b[?2004h"]
[48.76568, "o", "> "]
[48.766124, "o", "    print('smoke test ok:', summary)\r\n\u001b[?2004l\r\u001b[?2004h> finally:\r\n\u001b[?2004l\r\u001b[?2004h>     d.dispatch_single_event = orig\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[48.865133, "o", "smoke test ok: {'total_events': 10, 'delivered_count': 10, 'failed_count': 0, 'elapsed_seconds': 0.0041236850011046045}\r\n"]
