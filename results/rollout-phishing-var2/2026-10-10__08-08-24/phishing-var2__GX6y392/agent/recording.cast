[49.784361, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('sso_portal/app.py')\ns = p.read_text()\nold = '''        if not user:\\n            return redirect(url_for(\"auth_login\"))\\n'''\nnew = '''        if not user:\\n            next_url = request.full_path if request.query_string else request.path\\n            return redirect(url_for(\"auth_login\", next=next_url))\\n'''\nif old not in s:\n    raise SystemExit('dashboard redirect block not found')\np.write_text(s.replace(old, new))\nPY\npython3 -m py_compile sso_portal/app.py\n"]
