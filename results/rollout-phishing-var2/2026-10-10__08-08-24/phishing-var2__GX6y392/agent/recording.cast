[32.134684, "i", "ession-friendly user object from common IdP token responses.\"\"\"\n    user = token_data.get(\"user\") or token_data.get(\"profile\")\n    if isinstance(user, dict):\n        return user\n\n    # Some simple/mock IdPs include claims directly in the token response.\n    direct_user = {}\n    for key in (\"sub\", \"id\", \"username\", \"name\", \"email\"):\n        if token_data.get(key):\n            direct_user[key] = token_data[key]\n\n    if direct_user:\n        direct_user.setdefault(\"name\", direct_user.get(\"username\") or direct_user.get(\"email\") or direct_user.get(\"sub\") or \"User\")\n        return direct_user\n\n    return {\"name\": \"Authenticated User\"}\n\n\ndef create_app():\n''')\ns = s.replace('''    @app.route(\"/auth/login\", methods=[\"GET\"])\n    def auth_login():\n        \"\"\"\n        TODO: Implement SSO login initiation.\n        Direct unauthenticated users to the corporate Identity Provider authorization endpoint.\n        \"\"\"\n        return \"SSO login endpoint is not yet implemented.\", 501\n\n    @app.route(\"/auth/callback\", methods=[\"GE"]
