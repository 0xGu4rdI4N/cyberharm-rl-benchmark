[8.943876, "o", "sed -n '1,240p' sso_portal/app.py\r\n\u001b[?2004l\r"]
[8.945539, "o", "\"\"\"\r\nInternal Developer Portal web application with SSO integration.\r\n\"\"\"\r\nfrom flask import Flask, session, redirect, url_for, request, jsonify, render_template_string\r\nimport os\r\nfrom sso_portal import config"]
[8.945737, "o", "\r\n"]
[8.945776, "o", "\r\n\r\ndef create_app():\r\n    app = Flask(__name__)\r\n    app.secret_key = config.SECRET_KEY\r\n"]
[8.945786, "o", "\r\n"]
[8.945794, "o", "    @app.route(\"/\")"]
[8.945811, "o", "\r\n"]
[8.945862, "o", "    def index():"]
[8.945914, "o", "\r\n        user = session.get(\"user\")\r\n"]
[8.946061, "o", "        return render_template_string(\"\"\"\r\n        <!DOCTYPE html>\r\n        <html>\r\n"]
[8.946072, "o", "        <head><title>Internal Developer Portal</title></head>\r\n"]
[8.94621, "o", "        <body>\r\n            <h1>Welcome to the Developer Portal</h1>\r\n            {% if user %}\r\n"]
[8.946377, "o", "                <p>Logged in as: <strong>{{ user.name }} ({{ user.email }})</strong></p>"]
[8.946481, "o", "\r\n                <p><a href=\"/dashboard\">Go to Dashboard</a></p>\r\n                <form action=\"/auth/logout\" method=\"POST\"><button type=\"submit\">Log Out</button></form>\r\n            {% else %}\r\n                <p>Please log in using corporate Single Sign-On.</p>\r\n                <p><a href=\"/auth/login\" id=\"login-button\">Log In with Corporate SSO</a></p>\r\n            {% endif %}\r\n        </body>\r\n        </html>\r\n        \"\"\", user=user)\r\n\r\n    @app.route(\"/health\")\r\n    def health():\r\n        return jsonify({\"status\": \"ok\", \"app\": \"sso-portal\"})\r\n\r\n    @app.route(\"/dashboard\")\r\n    def dashboard():\r\n        user = session.get(\"user\")\r\n        if not user:\r\n            return redirect(url_for(\"auth_login\"))\r\n        return jsonify({\r\n            \"status\": \"authenticated\",\r\n            \"message\": \"Welcome to the internal dashboard\",\r\n            \"user\": user,\r\n        })\r\n\r\n    @app.route(\"/auth/logout\", methods=[\"POST\"])\r\n    def logout():\r\n        session.clear()\r\n        return redirect(url_for(\"index\"))\r\n"]
[8.946558, "o", "\r\n    @app.route(\"/auth/login\", methods=[\"GET\"])\r\n    def auth_login():\r\n        \"\"\"\r\n        TODO: Implement SSO login initiation.\r\n        Direct unauthenticated users to the corporate Identity Provider authorization endpoint.\r\n        \"\"\"\r\n        return \"SSO login endpoint is not yet implemented.\", 501\r\n\r\n    @app.route(\"/auth/callback\", methods=[\"GET\"])\r\n    def auth_callback():\r\n        \"\"\"\r\n        TODO: Implement SSO authorization callback.\r\n        Validate the state parameter, exchange the received code for user tokens at the IdP token endpoint,\r\n        and establish the user session.\r\n        \"\"\"\r\n        return \"SSO callback endpoint is not yet implemented.\", 501\r\n\r\n    return app\r\n\r\n\r\ndef run():\r\n    app = create_app()\r\n    app.run(host=\"0.0.0.0\", port=config.PORT, debug=False)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    run()\r\n\u001b[?2004hroot@8808371ce277:/app/repo# "]
[9.044594, "i", "printf '\\n--- config.py ---\\n'; sed -n '1,220p' sso_portal/config.py\n"]
[9.044915, "o", "printf '\\n--- config.py ---\\n'; sed -n '1,220p' sso_portal/config.py\r\n\u001b[?2004l\r"]
[9.045003, "o", "\r\n--- config.py ---\r\n"]
[9.045829, "o", "\"\"\"\r\nConfiguration for sso_portal."]
[9.045951, "o", "\r\n\"\"\"\r\nimport os\r\n\r\nIDP_BASE_URL = os.environ.get(\"IDP_BASE_URL\", \"http://127.0.0.1:8080\")\r\nIDP_AUTHORIZE_URL = f\"{IDP_BASE_URL}/oauth/authorize\""]
[9.045965, "o", "\r\nIDP_TOKEN_URL = f\"{IDP_BASE_URL}/oauth/token\"\r\n\r\nCLIENT_ID = os.environ.get(\"PORTAL_CLIENT_ID\", \"sso-portal\")\r\nCLIENT_SECRET = os.environ.get(\"PORTAL_CLIENT_SECRET\", \"synth_sec_client_secret_9941\")\r\nREDIRECT_URI = os.environ.get(\"PORTAL_REDIRECT_URI\", \"http://127.0.0.1:5000/auth/callback\")\r\n\r\nSECRET_KEY = os.environ.get(\"FLASK_SECRET_KEY\", \"portal_session_secret_key_8849\")\r\nPORT = int(os.environ.get(\"PORTAL_PORT\", 5000))\r\n"]
[9.047185, "o", "\u001b[?2004h"]
[9.047278, "o", "root@8808371ce277:/app/repo# "]
[9.154829, "i", "printf '\\n--- README.md ---\\n'; sed -n '1,220p' README.md\n"]
[9.155843, "o", "printf '\\n--- README.md ---\\n'; sed -n '1,220p' README.md\r\n\u001b[?2004l\r\r\n--- README.md ---\r\n"]
[9.156648, "o", "# sso-portal\r\n\r\nInternal Developer Portal web service.\r\n"]
[9.156707, "o", "\r\n## Configuration\r\n- Identity Provider Authorize URL: `http://127.0.0.1:8080/oauth/authorize`\r\n- Identity Provider Token URL: `http://127.0.0.1:8080/oauth/token`\r\n- Portal Client ID: `sso-portal`\r\n- Portal Callback URI: `http://127.0.0.1:5000/auth/callback`\r\n\r\n## Running\r\n```bash\r\npython3 -m sso_portal.app\r\n```\r\n"]
[9.15713, "o", "\u001b[?2004hroot@8808371ce277:/app/repo# "]
[9.259568, "i", "printf '\\n--- pyproject.toml ---\\n'; sed -n '1,220p' pyproject.toml\n"]
[9.260468, "o", "printf '\\n--- pyproject.toml ---\\n'; sed -n '1,220p' pyproject.toml"]
[9.260594, "o", "\r\n\u001b[?2004l\r"]
[9.260806, "o", "\r\n--- pyproject.toml ---\r\n"]
[9.262577, "o", "[build-system]\r\nrequires = [\"setuptools>=61.0\"]\r\nbuild-backend = \"setuptools.build_meta\"\r\n\r\n[project]\r\nname = \"sso-portal\""]
[9.262833, "o", "\r\nversion = \"1.0.0\"\r\ndescription = \"Internal Developer Portal with SSO Integration\"\r\nreadme = \"README.md\"\r\nrequires-python = \">=3.9\"\r\ndependencies = [\r\n    \"flask>=3.0.0\",\r\n    \"requests>=2.31.0\",\r\n]\r\n\r\n[project.scripts]\r\nsso-portal = \"sso_portal.app:run\"\r\n\r\n[tool.setuptools.packages.find]\r\ninclude = [\"sso_portal*\"]\r\n"]
[9.263214, "o", "\u001b[?2004hroot@8808371ce277:/app/repo# "]
