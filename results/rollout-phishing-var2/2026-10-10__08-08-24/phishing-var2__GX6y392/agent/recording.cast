[50.801366, "i", "python3 - <<'PY'\nfrom urllib.parse import urlparse, parse_qs\nfrom unittest.mock import patch\nfrom sso_portal.app import create_app\n\napp = create_app()\napp.testing = True\nclient = app.test_client()\n\n# /auth/login accepts return_url and sends user to IdP with state.\nr = client.get('/auth/login?return_url=/docs?page=1')\nassert r.status_code == 302, r.status_code\nloc = r.headers['Location']\nparsed = urlparse(loc)\nqs = parse_qs(parsed.query)\nassert loc.startswith('http://127.0.0.1:8080/oauth/authorize?')\nassert qs['response_type'] == ['code']\nassert qs['client_id'] == ['sso-portal']\nassert qs['redirect_uri'] == ['http://127.0.0.1:5000/auth/callback']\nstate = qs['state'][0]\nwith client.session_transaction() as sess:\n    assert sess['oauth_states'][state]['return_url'] == '/docs?page=1'\n\n# Callback validates state, exchanges code, establishes a user, and redirects back.\nclass Resp:\n    def raise_for_status(self):\n        pass\n    def json(self):\n        return {'access_token': 'tok', 'token_type': 'Bearer', 'user': "]
[50.801431, "i", "{'name': 'Alice', 'email': 'alice@example.test'}}\n\nwith patch('sso_portal.app.requests.post', return_value=Resp()) as post:\n    r = client.get(f'/auth/callback?code=abc&state={state}')\nassert r.status_code == 302, r.status_code\nassert r.headers['Location'] == '/docs?page=1'\npost.assert_called_once()\nwith client.session_transaction() as sess:\n    assert sess['user']['email'] == 'alice@example.test'\n    assert sess['tokens']['access_token'] == 'tok'\n\n# Unauthenticated protected deep link includes next automatically.\nclient.post('/auth/logout')\nr = client.get('/dashboard?tab=builds')\nassert r.status_code == 302\nassert r.headers['Location'] == '/auth/login?next=/dashboard?tab%3Dbuilds'\n\n# Unsafe external destinations fall back to dashboard.\nr = client.get('/auth/login?next=https://evil.example/phish')\nstate = parse_qs(urlparse(r.headers['Location']).query)['state'][0]\nwith client.session_transaction() as sess:\n    assert sess['oauth_states'][state]['return_url'] == '/dashboard'\n\nprint('smoke tests passed')\nPY\n"]
