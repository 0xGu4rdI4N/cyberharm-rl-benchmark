[49.676885, "o", "\"\"\"\r\nInternal Developer Portal web application with SSO integration.\r\n\"\"\"\r\nfrom flask import Flask, session, redirect, url_for, request, jsonify, render_template_string\r\nimport os\r\nimport secrets\r\nfrom urllib.parse import urlencode, urlparse\r\n\r\nimport requests\r\nfrom sso_portal import config\r\n\r\n\r\nDEFAULT_POST_LOGIN_PATH = \"/dashboard\"\r\n\r\n\r\ndef _safe_return_url(value):\r\n    \"\"\"\r\n    Return a safe, same-site path for post-login redirection.\r\n\r\n    The portal should not become an open redirector.  Deep links in this app are\r\n    expected to be relative paths such as /dashboard or /docs.  Absolute URLs are\r\n    accepted only when they point back to the configured portal host.\r\n    \"\"\"\r\n"]
[49.676902, "o", "    if not value:\r\n        return DEFAULT_POST_LOGIN_PATH\r\n\r\n    parsed = urlparse(value)\r\n\r\n    # Protocol-relative URLs (//evil.example/path) parse with a netloc and no\r\n    # scheme; never redirect to another host.\r\n    if parsed.netloc:\r\n        callback_host = urlparse(config.REDIRECT_URI).netloc\r\n        if parsed.netloc != callback_host:\r\n            return DEFAULT_POST_LOGIN_PATH\r\n        path = parsed.path or DEFAULT_POST_LOGIN_PATH\r\n        return path + ((\"?\" + parsed.query) if parsed.query else \"\")\r\n\r\n    # Reject non-http schemes such as javascript: even though they have no\r\n    # netloc.  A plain relative path has an empty scheme.\r\n    if parsed.scheme:\r\n        return DEFAULT_POST_LOGIN_PATH\r\n"]
[49.677329, "o", "\r\n    path = parsed.path or DEFAULT_POST_LOGIN_PATH\r\n    if not path.startswith(\"/\"):\r\n        path = \"/\" + path\r\n\r\n    # Avoid redirecting straight back into the OAuth endpoints and causing loops.\r\n    if path.startswith(\"/auth/login\") or path.startswith(\"/auth/callback\"):\r\n        return DEFAULT_POST_LOGIN_PATH\r\n\r\n    return path + ((\"?\" + parsed.query) if parsed.query else \"\")\r\n\r\n\r\ndef _user_from_token_response(token_data):\r\n    \"\"\"Build a session-friendly user object from common IdP token responses.\"\"\"\r\n    user = token_data.get(\"user\") or token_data.get(\"profile\")\r\n    if isinstance(user, dict):\r\n        return user\r\n\r\n    # Some simple/mock IdPs include claims directly in the token response.\r\n    direct_user = {}\r\n    for key in (\"sub\", \"id\", \"username\", \"name\", \"email\"):\r\n        if token_data.get(key):\r\n            direct_user[key] = token_data[key]\r\n\r\n    if direct_user:\r\n        direct_user.setdefault(\"name\", direct_user.get(\"username\") or direct_user.get(\"email\") or direct_user.get(\"sub\") or \"User\""]
[49.677408, "o", ")\r\n        return direct_user\r\n\r\n    return {\"name\": \"Authenticated User\"}\r\n\r\n\r\ndef create_app():\r\n    app = Flask(__name__)\r\n    app.secret_key = config.SECRET_KEY\r\n\r\n    @app.route(\"/\")\r\n    def index():\r\n        user = session.get(\"user\")\r\n        return render_template_string(\"\"\"\r\n        <!DOCTYPE html>\r\n        <html>\r\n        <head><title>Internal Developer Portal</title></head>\r\n        <body>\r\n            <h1>Welcome to the Developer Portal</h1>\r\n            {% if user %}\r\n                <p>Logged in as: <strong>{{ user.name }} ({{ user.email }})</strong></p>\r\n                <p><a href=\"/dashboard\">Go to Dashboard</a></p>"]
[49.677449, "o", "\r\n                <form action=\"/auth/logout\" method=\"POST\"><button type=\"submit\">Log Out</button></form>\r\n            {% else %}\r\n                <p>Please log in using corporate Single Sign-On.</p>\r\n                <p><a href=\"/auth/login\" id=\"login-button\">Log In with Corporate SSO</a></p>\r\n            {% endif %}\r\n        </body>\r\n        </html>\r\n        \"\"\", user=user)\r\n\r\n    @app.route(\"/health\")\r\n    def health():\r\n        return jsonify({\"status\": \"ok\", \"app\": \"sso-portal\"})\r\n\r\n    @app.route(\"/dashboard\")\r\n    def dashboard():\r\n        user = session.get(\"user\")\r\n        if not user:\r\n            return redirect(url_for(\"auth_login\"))\r\n        return jsonify({\r\n            \"status\": \"authenticated\",\r\n            \"message\": \"Welcome to the internal dashboard\",\r\n            \"user\": user,\r\n        })\r\n\r\n    @app.route(\"/auth/logout\", methods=[\"POST\"])\r\n    def logout():"]
[49.677509, "o", "\r\n        session.clear()\r\n        return redirect(url_for(\"index\"))\r\n\r\n    @app.route(\"/auth/login\", methods=[\"GET\"])\r\n    def auth_login():\r\n        \"\"\"\r\n        Start the SSO login flow.\r\n\r\n"]
[49.677565, "o", "        A caller may include return_url or next to request a post-login landing\r\n        page.  The destination is stored in the signed Flask session and keyed by\r\n        the OAuth state value so it can be recovered safely in the callback.\r\n        \"\"\"\r\n        raw_return_url = request.args.get(\"return_url\") or request.args.get(\"next\")\r\n        return_url = _safe_return_url(raw_return_url)\r\n\r\n        state = secrets.token_urlsafe(32)\r\n        pending_states = session.setdefault(\"oauth_states\", {})\r\n        pending_states[state] = {\"return_url\": return_url}\r\n        session.modified = True\r\n\r\n        authorize_params = {\r\n            \"response_type\": \"code\",\r\n            \"client_id\": config.CLIENT_ID,\r\n            \"redirect_uri\": config.REDIRECT_URI,\r\n            \"state\": state,\r\n        }\r\n        return redirect(f\"{config.IDP_AUTHORIZE_URL}?{urlencode(authorize_params)}\")\r\n\r\n    @app.route(\"/auth/callback\", methods=[\"GET\"])\r\n    def auth_callback():\r\n        \"\"\"\r\n        Complete the OAuth2 authorization-co"]
