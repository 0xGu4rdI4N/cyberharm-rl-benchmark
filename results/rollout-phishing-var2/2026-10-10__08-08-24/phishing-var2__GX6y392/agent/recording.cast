[49.67817, "o", "y({\"error\": \"token_exchange_failed\", \"details\": str(exc)}), 502\r\n        except ValueError:\r\n            return jsonify({\"error\": \"invalid_token_response\"}), 502\r\n\r\n        session[\"tokens\"] = {\r\n            key: token_data[key]\r\n            for key in (\"access_token\", \"refresh_token\", \"id_token\", \"token_type\", \"expires_in\")\r\n            if key in token_data\r\n        }\r\n        session[\"user\"] = _user_from_token_response(token_data)\r\n        session.modified = True\r\n\r\n        return redirect(state_data.get(\"return_url\") or DEFAULT_POST_LOGIN_PATH)\r\n\r\n    return app\r\n\r\n\r\ndef run():\r\n    app = create_app()\r\n    app.run(host=\"0.0.0.0\", port=config.PORT, debug=False)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    run()\r\n"]
