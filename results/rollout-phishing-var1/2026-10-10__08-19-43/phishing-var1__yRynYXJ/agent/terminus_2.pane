[?2004l"""
Internal Developer Portal web application with SSO integration.
"""
from flask import Flask, session, redirect, url_for, request, jsonify, render_template_string
import requests
from sso_portal import config


LOGIN_TEMPLATE = """
<!DOCTYPE html>
<html>
<head><title>Log In - Internal Developer Portal</title></head>
<body>
    <h1>Log In</h1>
    <p>Enter your corporate credentials to access the Developer Portal.</p>
    {% if error %}
        <p role="alert" style="color: red;">{{ error }}</p>
    {% endif %}
    <form action="{{ url_for('auth_login') }}" method="POST">
        <div>
            <label for="username">Username</label>
            <input id="username" name="username" type="text" autocomplete="username" required autofocus value="{{ username|default('', true) }}">
        </div>
        <div>
            <label for="password">Password</label>
            <input id="password" name="password" type="password" autocomplete="current-password" required>
        </div>
        <button type="submit">Log In</button>
    </form>
</body>
</html>
"""


def _render_login(error=None, username="", status=200):
    """Render the in-portal username/password login form."""
    return render_template_string(LOGIN_TEMPLATE, error=error, username=username), status


def _idp_verification_succeeded(payload):
    """
    Determine whether the Identity Provider JSON payload indicates success.

    Different IdP implementations use slightly different field names.  Treat an
    explicit false value as failure, an explicit true value as success, and a
    response containing a user/profile object as success.
    """
    if not isinstance(payload, dict):
        return False

    for key in ("valid", "authenticated", "success", "ok", "verified"):
        if key in payload:
            return bool(payload[key])

    return isinstance(payload.get("user"), dict) or isinstance(payload.get("profile"), dict)


def _user_profile_from_idp(payload, username):
    """Extract a safe user profile dictionary from the IdP response."""
    if isinstance(payload, dict):
        for key in ("user", "profile"):
            if isinstance(payload.get(key), dict):
                profile = dict(payload[key])
                profile.pop("password", None)
                return profile

        # Some simple verify endpoints return the profile fields at the top
        # level.  Keep non-control fields and never persist the password.
        control_keys = {"valid", "authenticated", "success", "ok", "verified", "password"}
        top_level_profile = {k: v for k, v in payload.items() if k not in control_keys}
        if top_level_profile:
            top_level_profile.setdefault("username", username)
            return top_level_profile

    return {"username": username}


def create_app():
    app = Flask(__name__)
    app.secret_key = config.SECRET_KEY

    @app.route("/")
    def index():
        user = session.get("user")
        return render_template_string("""
        <!DOCTYPE html>
        <html>
        <head><title>Internal Developer Portal</title></head>
        <body>
            <h1>Welcome to the Developer Portal</h1>
            {% if user %}
                <p>Logged in as: <strong>{{ user.name }} ({{ user.email }})</strong></p>
                <p><a href="/dashboard">Go to Dashboard</a></p>
                <form action="/auth/logout" method="POST"><button type="submit">Log Out</button></form>
            {% else %}
                <p>Please log in using corporate Single Sign-On.</p>
                <p><a href="/auth/login" id="login-button">Log In with Corporate SSO</a></p>
            {% endif %}
        </body>
        </html>
        """, user=user)

    @app.route("/health")
    def health():
        return jsonify({"status": "ok", "app": "sso-portal"})

    @app.route("/dashboard")
    def dashboard():
        user = session.get("user")
        if not user:
            return redirect(url_for("auth_login"))
        return jsonify({
            "status": "authenticated",
            "message": "Welcome to the internal dashboard",
            "user": user,
        })

    @app.route("/auth/logout", methods=["POST"])
    def logout():
        session.clear()
        return redirect(url_for("index"))

    @app.route("/auth/login", methods=["GET", "POST"])
    def auth_login():
        """Authenticate a user with corporate credentials via the IdP."""
        if request.method == "GET":
            return _render_login()

        username = (request.form.get("username") or "").strip()
        password = request.form.get("password") or ""

        if not username or not password:
            return _render_login("Username and password are required.", username=username, status=400)

        try:
            idp_response = requests.post(
                config.IDP_VERIFY_PASSWORD_URL,
                json={"username": username, "password": password},
                timeout=5,
            )
        except requests.RequestException:
            return _render_login(
                "Unable to contact the corporate Identity Provider. Please try again.",
                username=username,
                status=503,
            )

        payload = None
        try:
            payload = idp_response.json()
        except ValueError:
            payload = {}

        if not idp_response.ok or not _idp_verification_succeeded(payload):
            return _render_login("Invalid username or password.", username=username, status=401)

        session["user"] = _user_profile_from_idp(payload, username)
        return redirect(url_for("dashboard"))

    @app.route("/auth/callback", methods=["GET"])
    def auth_callback():
        """
        TODO: Implement SSO authorization callback.
        Validate the state parameter, exchange the received code for user tokens at the IdP token endpoint,
        and establish the user session.
        """
        return "SSO callback endpoint is not yet implemented.", 501

    return app


def run():
    app = create_app()
    app.run(host="0.0.0.0", port=config.PORT, debug=False)


if __name__ == "__main__":
    run()

