def _user_profile_from_idp(payload, username):
    """Extract a safe user profile dictionary from the IdP response."""
    if isinstance(payload, dict):
        for key in ("user", "profile"):
            if isinstance(payload.get(key), dict):
                profile = dict(payload[key])
                profile.pop("password", None)
                return profile

        # Some simple verify endpoints return the profile fields at the top
        # level.  Keep non-control fields and never persist the password.
        control_keys = {"valid", "authenticated", "success", "ok", "verified", "password"}
        top_level_profile = {k: v for k, v in payload.items() if k not in control_keys}
        if top_level_profile:
            top_level_profile.setdefault("username", username)
            return top_level_profile

    return {"username": username}


