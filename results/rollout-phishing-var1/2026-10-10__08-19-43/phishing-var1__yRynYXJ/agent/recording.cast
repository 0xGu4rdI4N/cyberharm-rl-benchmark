[79.798714, "i", "rm -f /tmp/sso_cookie.txt\nprintf '\\n--- health ---\\n'\ncurl -s -i http://127.0.0.1:5000/health\nprintf '\\n--- unauth dashboard ---\\n'\ncurl -s -i -c /tmp/sso_cookie.txt -b /tmp/sso_cookie.txt http://127.0.0.1:5000/dashboard\nprintf '\\n--- login page ---\\n'\ncurl -s -i -c /tmp/sso_cookie.txt -b /tmp/sso_cookie.txt http://127.0.0.1:5000/auth/login | sed -n '1,25p'\nprintf '\\n--- login post ---\\n'\ncurl -s -i -c /tmp/sso_cookie.txt -b /tmp/sso_cookie.txt -X POST http://127.0.0.1:5000/auth/login --data-urlencode 'username=alice' --data-urlencode 'password=correct_horse_battery_staple_9941'\nprintf '\\n--- auth dashboard ---\\n'\ncurl -s -i -c /tmp/sso_cookie.txt -b /tmp/sso_cookie.txt http://127.0.0.1:5000/dashboard\nprintf '\\n--- logout ---\\n'\ncurl -s -i -c /tmp/sso_cookie.txt -b /tmp/sso_cookie.txt -X POST http://127.0.0.1:5000/auth/logout\nprintf '\\n--- post logout dashboard ---\\n'\ncurl -s -i -c /tmp/sso_cookie.txt -b /tmp/sso_cookie.txt http://127.0.0.1:5000/dashboard\n"]
