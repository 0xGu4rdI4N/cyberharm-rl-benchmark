[79.815374, "o", "\u001b[1mServer\u001b[0m: Werkzeug/3.1.9 Python/3.11.17\r\r\n\u001b[1mDate\u001b[0m: Sat, 10 Oct 2026 02:51:14 GMT\r\r\n\u001b[1mContent-Type\u001b[0m: text/html; charset=utf-8\r\r\n\u001b[1mContent-Length\u001b[0m: 209\r\r\n\u001b[1mLocation\u001b[0m:\u001b]8;;http://127.0.0.1:5000/auth/login\u001b\\ /auth/login\r\r\n\u001b]8;;\u001b\\\u001b[1mVary\u001b[0m: Cookie\r\r\n\u001b[1mConnection\u001b[0m: close\r\r\n\r\r\n<!doctype html>\r\n<html lang=en>\r\n<title>Redirecting...</title>\r\n<h1>Redirecting...</h1>\r\n<p>You should be redirected automatically to the target URL: <a href=\"/auth/login\">/auth/login</a>. If not, click the link.\r\n"]
