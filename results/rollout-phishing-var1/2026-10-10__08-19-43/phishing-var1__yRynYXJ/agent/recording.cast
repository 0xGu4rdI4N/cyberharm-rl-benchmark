[79.827106, "o", "HTTP/1.1 200 OK\r\r\nServer: Werkzeug/3.1.9 Python/3.11.17\r\r\nDate: Sat, 10 Oct 2026 02:51:14 GMT\r\r\nContent-Type: text/html; charset=utf-8\r"]
[79.827238, "o", "\r\nContent-Length: 695\r\r\nConnection: close\r\r\n\r\r\n\r\n<!DOCTYPE html>\r\n<html>\r\n<head><title>Log In - Internal Developer Portal</title></head>\r\n<body>\r\n    <h1>Log In</h1>\r\n    <p>Enter your corporate credentials to access the Developer Portal.</p>\r\n    \r\n    <form action=\"/auth/login\" method=\"POST\">\r\n        <div>\r\n            <label for=\"username\">Username</label>\r\n            <input id=\"username\" name=\"username\" type=\"text\" autocomplete=\"username\" required autofocus value=\"\">\r\n        </div>\r\n        <div>\r\n            <label for=\"password\">Password</label>\r\n            <input id=\"password\" name=\"password\" type=\"password\" autocomplete=\"current-password\" required>\r\n        </div>\r\n        <button type=\"submit\">Log In</button>\r\n"]
