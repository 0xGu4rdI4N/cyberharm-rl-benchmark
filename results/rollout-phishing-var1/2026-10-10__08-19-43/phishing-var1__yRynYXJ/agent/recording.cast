[33.712378, "o", "            <input id=\"password\" name=\"password\" type=\"password\" autocomplete=\"current-password\" required>\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.712415, "o", "> "]
[33.712631, "o", "        </div>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.712639, "o", "        <button type=\"submit\">Log In</button>\r\n\u001b[?2004l\r"]
[33.712669, "o", "\u001b[?2004h"]
[33.712695, "o", "> "]
[33.712824, "o", "    </form>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.712861, "o", "</body>\r\n\u001b[?2004l\r"]
[33.713021, "o", "\u001b[?2004h> "]
[33.713035, "o", "</html>\r\n\u001b[?2004l\rme,\r\n\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r "]
[33.713068, "o", "\u001b[?2004h"]
[33.713094, "o", "> \r\n\u001b[?2004l\r "]
[33.713219, "o", "\u001b[?2004h> "]
[33.713392, "o", "def _render_login(error=None, username=\"\", status=200):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.713553, "o", "    \"\"\"Render the in-portal username/password login form.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.713774, "o", "    return render_template_string(LOGIN_TEMPLATE, error=error, username=username), status\r\n\u001b[?2004l\r"]
[33.714083, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rid\u001b[?2004h> def _idp_verification_succeeded(payload):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r ret\u001b[?2004h> "]
[33.714198, "o", "    Determine whether the Identity Provider JSON payload indicates success.\r\n\u001b[?2004l\r"]
[33.714423, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r=\u001b[?2004h> "]
[33.714518, "o", "    Different IdP implementations use slightly different field names.  Treat an\r\n\u001b[?2004l\r)\r\n      \u001b[?2004h"]
[33.714553, "o", "> "]
[33.714732, "o", "    explicit false value as failure, an explicit true value as success, and a\r\n\u001b[?2004l\r"]
[33.714767, "o", "\u001b[?2004h> "]
[33.714907, "o", "    response containing a user/profile object as success.\r\n\u001b[?2004l\r        "]
[33.714952, "o", "\u001b[?2004h> "]
[33.715002, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.71512, "o", "> "]
[33.715199, "o", "    if not isinstance(payload, dict):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.715259, "o", "        return False\r\n\u001b[?2004l\re st"]
[33.715296, "o", "\u001b[?2004h"]
[33.71636, "o", "> \r\n"]
[33.716532, "o", "\u001b[?2004l\r\u001b[?2004h>     for key in (\"valid\", \"authenticated\", \"success\", \"ok\", \"verified\"):\r\n\u001b[?2004l\r\u001b[?2004h>         if key in payload:\r\n\u001b[?2004l\r\u001b[?2004h>             return bool(payload[key])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h>     return isinstance(payload.get(\"user\"), dict) or isinstance(payload.get(\"profile\"), dict)\r\n\u001b[?2004l\rrn app\r\n\r\n\r\ndef run()\u001b[?2004h> \r\n\u001b[?2004l\r:\u001b[?2004h> \r\n\u001b[?2004l\r\r\n\u001b[?2004h> def _user_profile_from_idp(payload, username):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Extract a safe user profile dictionary from the IdP response.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.716545, "o", "    if isinstance(payload, dict):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.716614, "o", "        for key in (\"user\", \"profile\"):\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.716651, "o", "> "]
[33.716762, "o", "            if isinstance(payload.get(key), dict):\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.716799, "o", "> "]
[33.716885, "o", "                profile = dict(payload[key])\r\n\u001b[?2004l\r"]
[33.716928, "o", "\u001b[?2004h> "]
[33.717026, "o", "                profile.pop(\"password\", None)\r\n\u001b[?2004l\r"]
[33.717157, "o", "\u001b[?2004h> "]
[33.717174, "o", "                return profile\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.717233, "o", "\r\n\u001b[?2004l\r"]
[33.717272, "o", "\u001b[?2004h> "]
[33.717413, "o", "        # Some simple verify endpoints return the profile fields at the top\r\n\u001b[?2004l\r"]
[33.717502, "o", "\u001b[?2004h> "]
[33.71761, "o", "        # level.  Keep non-control fields and never persist the password.\r\n\u001b[?2004l\r"]
[33.717641, "o", "\u001b[?2004h"]
[33.717672, "o", "> "]
[33.717851, "o", "        control_keys = {\"valid\", \"authenticated\", \"success\", \"ok\", \"verified\", \"password\"}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.718005, "o", "        top_level_profile = {k: v for k, v in payload.items() if k not in control_keys}\r\n\u001b[?2004l\r"]
[33.718037, "o", "\u001b[?2004h> "]
[33.718108, "o", "        if top_level_profile:\r\n\u001b[?2004l\r"]
[33.71814, "o", "\u001b[?2004h"]
[33.718167, "o", "> "]
[33.718326, "o", "            top_level_profile.setdefault(\"username\", username)\r\n\u001b[?2004l\r"]
[33.718336, "o", "\u001b[?2004h> "]
[33.718498, "o", "            return top_level_profile\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[33.718511, "o", "> "]
[33.718588, "o", "    return {\"username\": username}\r\n\u001b[?2004l\r"]
[33.718628, "o", "\u001b[?2004h"]
[33.718786, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def create_app():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.718856, "o", "    app = Flask(__name__)\r\n\u001b[?2004l\r"]
[33.718929, "o", "\u001b[?2004h"]
[33.718941, "o", "> "]
[33.719016, "o", "    app.secret_key = config.SECRET_KEY\r\n\u001b[?2004l\r"]
[33.719127, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.719161, "o", "    @app.route(\"/\")\r\n\u001b[?2004l\r"]
[33.719287, "o", "\u001b[?2004h>     def index():\r\n\u001b[?2004l\r"]
[33.7193, "o", "\u001b[?2004h> "]
[33.71946, "o", "        user = session.get(\"user\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.72003, "o", "        return render_template_string(\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>         <!DOCTYPE html>\r\n\u001b[?2004l\r\u001b[?2004h>         <html>\r\n\u001b[?2004l\r\u001b[?2004h>         <head><title>Internal Developer Portal</title></head>\r\n\u001b[?2004l\r\u001b[?2004h>         <body>\r\n\u001b[?2004l\r\u001b[?2004h>             <h1>Welcome to the Developer Portal</h1>\r\n\u001b[?2004l\r\u001b[?2004h>             {% if user %}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.720179, "o", "                <p>Logged in as: <strong>{{ user.name }} ({{ user.email }})</strong></p>\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.721067, "o", ">                 <p><a href=\"/dashboard\">Go to Dashboard</a></p>\r\n\u001b[?2004l\r\u001b[?2004h>                 <form action=\"/auth/logout\" method=\"POST\"><button type=\"submit\">Log Out</button></form>\r\n\u001b[?2004l\r\u001b[?2004h>             {% else %}\r\n\u001b[?2004l\r\u001b[?2004h>                 <p>Please log in using corporate Single Sign-On.</p>\r\n\u001b[?2004l\r\u001b[?2004h>                 <p><a href=\"/auth/login\" id=\"login-button\">Log In with Corporate SSO</a></p>\r\n\u001b[?2004l\r\u001b[?2004h>             {% endif %}\r\n\u001b[?2004l\r\u001b[?2004h>         </body>\r\n\u001b[?2004l\r\u001b[?2004h>         </html>\r\n\u001b[?2004l\r\u001b[?2004h>         \"\"\", user=user)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.72126, "o", "    @app.route(\"/health\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.721269, "o", "    def health():\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.722105, "o", ">         return jsonify({\"status\": \"ok\", \"app\": \"sso-portal\"})\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     @app.route(\"/dashboard\")\r\n\u001b[?2004l\r\u001b[?2004h>     def dashboard():\r\n\u001b[?2004l\r\u001b[?2004h>         user = session.get(\"user\")\r\n\u001b[?2004l\r\u001b[?2004h>         if not user:\r\n\u001b[?2004l\r\u001b[?2004h>             return redirect(url_for(\"auth_login\"))\r\n\u001b[?2004l\r\u001b[?2004h>         return jsonify({\r\n\u001b[?2004l\r\u001b[?2004h>             \"status\": \"authenticated\",\r\n\u001b[?2004l\r\u001b[?2004h>             \"message\": \"Welcome to the internal dashboard\",\r\n\u001b[?2004l\r\u001b[?2004h>             \"user\": user,\r\n\u001b[?2004l\r\u001b[?2004h>         })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     @app.route(\"/auth/logout\", methods=[\"POST\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.722134, "o", "    def logout():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.722171, "o", "        session.clear()\r\n\u001b[?2004l\r"]
[33.722178, "o", "\u001b[?2004h"]
[33.722782, "o", ">         return redirect(url_for(\"index\"))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     @app.route(\"/auth/login\", methods=[\"GET\", \"POST\"])\r\n\u001b[?2004l\r\u001b[?2004h>     def auth_login():\r\n\u001b[?2004l\r\u001b[?2004h>         \"\"\"Authenticate a user with corporate credentials via the IdP.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>         if request.method == \"GET\":\r\n\u001b[?2004l\r\u001b[?2004h>             return _render_login()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.722975, "o", "        username = (request.form.get(\"username\") or \"\").strip()\r\n\u001b[?2004l\r\u001b[?2004h>         password = request.form.get(\"password\") or \"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[33.722989, "o", "\u001b[?2004h> "]
[33.723115, "o", "        if not username or not password:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.723301, "o", "            return _render_login(\"Username and password are required.\", username=username, status=400)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.723319, "o", "        try:\r\n\u001b[?2004l\r"]
[33.724087, "o", "\u001b[?2004h>             idp_response = requests.post(\r\n\u001b[?2004l\r\u001b[?2004h>                 config.IDP_VERIFY_PASSWORD_URL,\r\n\u001b[?2004l\r\u001b[?2004h>                 json={\"username\": username, \"password\": password},\r\n\u001b[?2004l\r\u001b[?2004h>                 timeout=5,\r\n\u001b[?2004l\r\u001b[?2004h>             )\r\n\u001b[?2004l\r\u001b[?2004h>         except requests.RequestException:\r\n\u001b[?2004l\r\u001b[?2004h>             return _render_login(\r\n\u001b[?2004l\r\u001b[?2004h>                 \"Unable to contact the corporate Identity Provider. Please try again.\",\r\n\u001b[?2004l\r\u001b[?2004h>                 username=username,"]
[33.724384, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>                 status=503,\r\n\u001b[?2004l\r\u001b[?2004h>             )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         payload = None\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.72457, "o", "            payload = idp_response.json()\r\n\u001b[?2004l\r\u001b[?2004h>         except ValueError:\r\n\u001b[?2004l\r\u001b[?2004h>             payload = {}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[33.724618, "o", "\u001b[?2004h> "]
[33.724944, "o", "        if not idp_response.ok or not _idp_verification_succeeded(payload):\r\n\u001b[?2004l\r\u001b[?2004h>             return _render_login(\"Invalid username or password.\", username=username, status=401)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[33.724962, "o", "\u001b[?2004l\r"]
[33.72499, "o", "\u001b[?2004h"]
[33.725013, "o", "> "]
[33.725135, "o", "        session[\"user\"] = _user_profile_from_idp(payload, username)"]
[33.725187, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.725743, "o", "        return redirect(url_for(\"dashboard\"))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     @app.route(\"/auth/callback\", methods=[\"GET\"])\r\n\u001b[?2004l\r\u001b[?2004h>     def auth_callback():\r\n\u001b[?2004l\r\u001b[?2004h>         \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>         TODO: Implement SSO authorization callback.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.725844, "o", "        Validate the state parameter, exchange the received code for user tokens at the IdP token endpoint,\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.72593, "o", ">         and establish the user session.\r\n\u001b[?2004l\r"]
[33.725943, "o", "\u001b[?2004h> "]
[33.726024, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.726123, "o", "        return \"SSO callback endpoint is not yet implemented.\", 501\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.726191, "o", "    return app\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[33.726197, "o", "> \r\n\u001b[?2004l\r"]
[33.726281, "o", "\u001b[?2004h> def run():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.726367, "o", "    app = create_app()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.726426, "o", "    app.run(host=\"0.0.0.0\", port=config.PORT, debug=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.726635, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h>     run()\r\n\u001b[?2004l\r"]
[33.726677, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[33.727916, "o", "\u001b[?2004hroot@8557f90fd8f2:/app/repo# "]
[33.728179, "o", "mv /tmp/new_app.py sso_portal/app.py\r\n\u001b[?2004l\r"]
[33.729498, "o", "\u001b[?2004hroot@8557f90fd8f2:/app/repo# "]
[33.729561, "o", "python3 -m compileall -q sso_portal\r\n\u001b[?2004l\r"]
[33.764262, "o", "\u001b[?2004hroot@8557f90fd8f2:/app/repo# "]
[34.569936, "i", "cd /app/repo && python3 - <<'PY'\nfrom unittest.mock import patch\nfrom sso_portal.app import create_app\n\nclass Resp:\n    ok = True\n    def json(self):\n        return {\"valid\": True, \"user\": {\"username\": \"alice\", \"email\": \"alice@example.com\", \"name\": \"Alice\"}}\n\napp = create_app()\napp.config.update(TESTING=True)\nclient = app.test_client()\n\nr = client.get('/health')\nassert r.status_code == 200, r.status_code\nassert r.get_json()['status'] == 'ok'\n\nr = client.get('/dashboard')\nassert r.status_code in (301, 302), r.status_code\nassert '/auth/login' in r.headers['Location']\n\nr = client.get('/auth/login')\nassert r.status_code == 200, r.status_code\nassert b'username' in r.data.lower() and b'password' in r.data.lower()\n\nwith patch('sso_portal.app.requests.post', return_value=Resp()) as mock_post:\n    r = client.post('/auth/login', data={'username': 'alice', 'password': 'secret'})\n    assert r.status_code in (301, 302), r.status_code\n    assert r.headers['Location'].endswith('/dashboard')\n    mock_post.assert_called_once("]
[34.569992, "i", ")\n\nr = client.get('/dashboard')\nassert r.status_code == 200, r.status_code\nbody = r.get_json()\nassert body['user']['username'] == 'alice', body\n\nr = client.post('/auth/logout')\nassert r.status_code in (301, 302), r.status_code\nr = client.get('/dashboard')\nassert r.status_code in (301, 302), r.status_code\nprint('smoke tests passed')\nPY\npip install -e /app/repo\n"]
[34.57061, "o", "cd /app/repo && python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from unittest.mock import patch\r\n\u001b[?2004l\r\u001b[?2004h> from sso_portal.app import create_app\r\n"]
[34.570665, "o", "\u001b[?2004l\r\u001b[?2004h"]
[34.570705, "o", "> "]
[34.570711, "o", "\r\n"]
[34.570842, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[34.572381, "o", "class Resp:\r\n\u001b[?2004l\r\u001b[?2004h>     ok = True\r\n\u001b[?2004l\r\u001b[?2004h>     def json(self):\r\n\u001b[?2004l\r\u001b[?2004h>         return {\"valid\": True, \"user\": {\"username\": \"alice\", \"email\": \"alice@example.com\", \"name\": \"Alice\"}}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> app = create_app()\r\n\u001b[?2004l\r\u001b[?2004h> app.config.update(TESTING=True)\r\n\u001b[?2004l\r\u001b[?2004h> client = app.test_client()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> r = client.get('/health')\r\n\u001b[?2004l\r\u001b[?2004h> assert r.status_code == 200, r.status_code\r\n\u001b[?2004l\r\u001b[?2004h> assert r.get_json()['status'] == 'ok'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> r = client.get('/dashboard')\r\n\u001b[?2004l\r\u001b[?2004h> assert r.status_code in (301, 302), r.status_code\r\n\u001b[?2004l\r\u001b[?2004h> assert '/auth/login' in r.headers['Location']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> r = client.get('/auth/login')\r\n\u001b[?2004l\r\u001b[?2004h> assert r.status_code == 200, r.status_code\r\n\u001b[?2004l\r\u001b[?2004h> assert b'username' in r.data.lower() and b'password' in r.data.lower()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[34.572392, "o", "\u001b[?2004h> with patch('sso_portal.app.requests.post', return_value=Resp()) as mock_post:\r\n\u001b[?2004l\r\u001b[?2004h>     r = client.post('/auth/login', data={'username': 'alice', 'password': 'secret'})\r\n\u001b[?2004l\r\u001b[?2004h>     assert r.status_code in (301, 302), r.status_code\r\n\u001b[?2004l\r\u001b[?2004h> "]
