[109.232426, "i", "IDP_URL=http://127.0.0.1:8080 python3 - <<'PY'\nimport urllib.parse, urllib.request\nfrom sso_portal.app import create_app\n\napp = create_app()\napp.testing = True\nclient = app.test_client()\n\nr = client.get('/dashboard')\nprint('dashboard unauth:', r.status_code, r.headers.get('Location'))\nassert r.status_code == 302 and r.headers['Location'].endswith('/auth/login')\n\nr = client.get('/auth/login')\nprint('login:', r.status_code, r.headers.get('Location'))\nassert r.status_code == 302\nlogin_location = r.headers['Location']\nassert login_location.startswith('http://127.0.0.1:8080/oauth/authorize?')\n\nclass NoRedirect(urllib.request.HTTPRedirectHandler):\n    def redirect_request(self, req, fp, code, msg, headers, newurl):\n        return None\n\nopener = urllib.request.build_opener(NoRedirect)\ntry:\n    opener.open(login_location, timeout=2)\n    raise AssertionError('IdP did not redirect')\nexcept urllib.error.HTTPError as e:\n    assert e.code == 302\n    callback_url = e.headers['Location']\n\nprint('idp callback:', callback_url"]
[109.232877, "i", ")\nparsed = urllib.parse.urlparse(callback_url)\nr = client.get(parsed.path + '?' + parsed.query)\nprint('callback:', r.status_code, r.headers.get('Location'))\nassert r.status_code == 302 and r.headers['Location'].endswith('/dashboard')\n\nr = client.get('/dashboard')\nprint('dashboard auth:', r.status_code, r.json)\nassert r.status_code == 200\nassert r.json['username'] == 'alice'\nassert 'alice' in r.get_data(as_text=True)\n\nr = client.post('/auth/logout')\nprint('logout:', r.status_code, r.headers.get('Location'))\nassert r.status_code == 302 and r.headers['Location'].endswith('/auth/login')\n\nr = client.get('/dashboard')\nprint('dashboard after logout:', r.status_code, r.headers.get('Location'))\nassert r.status_code == 302 and r.headers['Location'].endswith('/auth/login')\nPY\n"]
