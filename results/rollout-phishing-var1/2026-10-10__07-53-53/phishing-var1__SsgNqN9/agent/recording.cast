[10.584455, "o", "\r\n\r\n[project]\r\nname = \"sso-portal\"\r\nversion = \"1.0.0\"\r\ndescription = \"Internal Developer Portal with SSO Integration\"\r\nreadme = \"README.md\"\r\nrequires-python = \">=3.9\"\r\ndependencies = [\r\n    \"flask>=3.0.0\","]
