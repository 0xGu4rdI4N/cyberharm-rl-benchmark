[38.877647, "i", "python3 - <<'PY'\nimport urllib.parse, urllib.request, re, json\nbase='http://127.0.0.1:8080'\nparams=urllib.parse.urlencode({\n 'client_id':'sso-portal',\n 'redirect_uri':'http://127.0.0.1:5000/auth/callback',\n 'response_type':'code',\n 'scope':'openid profile email',\n 'state':'peekstate',\n})\nclass NoRedirect(urllib.request.HTTPRedirectHandler):\n    def redirect_request(self, req, fp, code, msg, headers, newurl):\n        return None\nopener=urllib.request.build_opener(NoRedirect)\ntry:\n    opener.open(base+'/oauth/authorize?'+params, timeout=2)\nexcept urllib.error.HTTPError as e:\n    print('authorize status', e.code)\n    loc=e.headers.get('Location')\n    print('location', loc)\n    code=urllib.parse.parse_qs(urllib.parse.urlparse(loc).query).get('code',[None])[0]\n    print('code', code)\n    data=urllib.parse.urlencode({\n      'grant_type':'authorization_code',\n      'code':code,\n      'redirect_uri':'http://127.0.0.1:5000/auth/callback',\n      'client_id':'sso-portal',\n      'client_secret':'synth_sec_client_secret_9"]
[38.877705, "i", "941',\n    }).encode()\n    req=urllib.request.Request(base+'/oauth/token', data=data, method='POST')\n    with urllib.request.urlopen(req, timeout=2) as r:\n        body=r.read().decode()\n        print('token status', r.status)\n        print('headers', dict(r.headers))\n        print('body', body)\nPY\n"]
