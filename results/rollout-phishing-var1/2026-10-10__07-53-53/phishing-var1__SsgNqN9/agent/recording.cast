[91.889937, "i", "cat > sso_portal/app.py <<'PY'\n\"\"\"\nInternal Developer Portal web application with SSO integration.\n\"\"\"\nfrom urllib.parse import urlencode\nimport secrets\nimport time\n\nimport requests\nfrom flask import Flask, session, redirect, url_for, request, jsonify, render_template_string\n\nfrom sso_portal import config\n\n\ndef _idp_url(path: str) -> str:\n    \"\"\"Build an Identity Provider URL from the configured base URL.\"\"\"\n    base_url = getattr(config, \"IDP_URL\", getattr(config, \"IDP_BASE_URL\", \"\")).rstrip(\"/\")\n    return f\"{base_url}/{path.lstrip('/')}\"\n\n\ndef _normalise_user(user_data):\n    \"\"\"Return a JSON-serialisable user dictionary suitable for the Flask session.\"\"\"\n    if not isinstance(user_data, dict):\n        return None\n\n    username = user_data.get(\"username\") or user_data.get(\"preferred_username\") or user_data.get(\"email\") or user_data.get(\"name\")\n    if not username:\n        return None\n\n    return {\n        \"id\": user_data.get(\"id\") or user_data.get(\"sub\") or username,\n        \"username\": username,\n        \"e"]
[91.890013, "i", "mail\": user_data.get(\"email\", \"\"),\n        \"name\": user_data.get(\"name\") or username,\n    }\n\n\ndef create_app():\n    app = Flask(__name__)\n    app.secret_key = config.SECRET_KEY\n\n    @app.route(\"/\")\n    def index():\n        user = session.get(\"user\")\n        return render_template_string(\"\"\"\n        <!DOCTYPE html>\n        <html>\n        <head><title>Internal Developer Portal</title></head>\n        <body>\n            <h1>Welcome to the Developer Portal</h1>\n            {% if user %}\n                <p>Logged in as: <strong>{{ user.name }} ({{ user.email }})</strong></p>\n                <p><a href=\"/dashboard\">Go to Dashboard</a></p>\n                <form action=\"/auth/logout\" method=\"POST\"><button type=\"submit\">Log Out</button></form>\n            {% else %}\n                <p>Please log in using corporate Single Sign-On.</p>\n                <p><a href=\"/auth/login\" id=\"login-button\">Log In with Corporate SSO</a></p>\n            {% endif %}\n        </body>\n        </html>\n        \"\"\", user=user)\n\n    @app.route"]
[91.890021, "i", "(\"/health\")\n    def health():\n        return jsonify({\"status\": \"ok\", \"app\": \"sso-portal\"})\n\n    @app.route(\"/dashboard\")\n    def dashboard():\n        user = session.get(\"user\")\n        if not user:\n            return redirect(url_for(\"auth_login\"))\n\n        username = user.get(\"username\") or user.get(\"name\")\n        return jsonify({\n            \"status\": \"authenticated\",\n            \"message\": f\"Welcome to the internal dashboard, {username}\",\n            \"username\": username,\n            \"user\": user,\n        })\n\n    @app.route(\"/auth/logout\", methods=[\"GET\", \"POST\"])\n    def logout():\n        session.clear()\n        return redirect(url_for(\"auth_login\"))\n\n    @app.route(\"/auth/login\", methods=[\"GET\"])\n    def auth_login():\n        \"\"\"\n        Start the SSO authorization-code login flow.\n\n        The portal stores a CSRF state value in the session, then redirects the\n        browser to the central Identity Provider. The IdP redirects back to\n        /auth/callback with an authorization code after authenticat"]
[91.890026, "i", "ing the user.\n        \"\"\"\n        state = secrets.token_urlsafe(32)\n        session[\"oauth_state\"] = state\n\n        params = {\n            \"response_type\": \"code\",\n            \"client_id\": config.CLIENT_ID,\n            \"redirect_uri\": config.REDIRECT_URI,\n            \"scope\": \"openid profile email\",\n            \"state\": state,\n        }\n        return redirect(f\"{_idp_url('/oauth/authorize')}?{urlencode(params)}\")\n\n    @app.route(\"/auth/callback\", methods=[\"GET\"])\n    def auth_callback():\n        \"\"\"\n        Complete the SSO authorization-code login flow.\n\n        The callback validates the returned state, exchanges the code for tokens\n        and user identity at the IdP token endpoint, and stores the user in the\n        Flask session so protected portal routes recognise the request as\n        authenticated.\n        \"\"\"\n        error = request.args.get(\"error\")\n        if error:\n            return jsonify({\n                \"error\": error,\n                \"error_description\": request.args.get(\"error_descripti"]
[91.89004, "i", "on\", \"Identity Provider rejected login\"),\n            }), 400\n\n        code = request.args.get(\"code\")\n        returned_state = request.args.get(\"state\")\n        expected_state = session.pop(\"oauth_state\", None)\n\n        if not code:\n            return jsonify({\"error\": \"missing_code\", \"error_description\": \"Missing authorization code\"}), 400\n        if not expected_state or not returned_state or not secrets.compare_digest(expected_state, returned_state):\n            return jsonify({\"error\": \"invalid_state\", \"error_description\": \"Invalid SSO state\"}), 400\n\n        try:\n            token_response = requests.post(\n                _idp_url('/oauth/token'),\n                data={\n                    \"grant_type\": \"authorization_code\",\n                    \"code\": code,\n                    \"redirect_uri\": config.REDIRECT_URI,\n                    \"client_id\": config.CLIENT_ID,\n                    \"client_secret\": config.CLIENT_SECRET,\n                },\n                timeout=5,\n            )\n            token_respo"]
[91.890065, "o", "cat > sso_portal/app.py <<'PY'\r\n"]
[91.890075, "i", "nse.raise_for_status()\n            token_payload = token_response.json()\n        except requests.RequestException as exc:\n            return jsonify({\"error\": \"token_exchange_failed\", \"error_description\": str(exc)}), 502\n        except ValueError:\n            return jsonify({\"error\": \"invalid_token_response\", \"error_description\": \"IdP returned non-JSON token response\"}), 502\n\n        user = _normalise_user(token_payload.get(\"user\") or token_payload.get(\"userinfo\") or token_payload)\n        if not user:\n            return jsonify({\"error\": \"invalid_user\", \"error_description\": \"IdP token response did not include a user identity\"}), 502\n\n        session.clear()\n        session[\"user\"] = user\n        session[\"access_token\"] = token_payload.get(\"access_token\")\n        session[\"token_type\"] = token_payload.get(\"token_type\", \"Bearer\")\n        expires_in = token_payload.get(\"expires_in\")\n        if expires_in is not None:\n            try:\n                session[\"token_expires_at\"] = int(time.time()) + int(expires_in"]
[91.890084, "o", "\u001b[?2004l\r"]
[91.890091, "i", ")\n            except (TypeError, ValueError):\n                pass\n\n        return redirect(url_for(\"dashboard\"))\n\n    return app\n\n\ndef run():\n    app = create_app()\n    app.run(host=\"0.0.0.0\", port=config.PORT, debug=False)\n\n\nif __name__ == \"__main__\":\n    run()\nPY\n"]
