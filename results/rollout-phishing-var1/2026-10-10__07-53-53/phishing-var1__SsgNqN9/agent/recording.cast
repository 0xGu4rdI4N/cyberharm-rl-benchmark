[18.660942, "i", "python3 - <<'PY'\nimport urllib.request\nfor base in ['http://127.0.0.1:8000','http://127.0.0.1:8080']:\n    for path in ['/', '/health', '/oauth/authorize', '/oauth/token', '/login', '/users/me', '/userinfo']:\n        url=base+path\n        try:\n            r=urllib.request.urlopen(url, timeout=1)\n            print(url, r.status, r.geturl(), r.headers.get('content-type'), r.read(300))\n        except Exception as e:\n            print(url, type(e).__name__, e)\nPY\n"]
