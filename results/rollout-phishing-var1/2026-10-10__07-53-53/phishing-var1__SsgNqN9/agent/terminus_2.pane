[?2004l"""
Configuration for sso_portal.
"""
import os

# Canonical Identity Provider base URL used by the portal.
# IDP_BASE_URL is still accepted as a backwards-compatible environment alias.
IDP_URL = os.environ.get(
    "IDP_URL",
    os.environ.get("IDP_BASE_URL", "http://127.0.0.1:8000"),
).rstrip("/")
IDP_BASE_URL = IDP_URL
IDP_AUTHORIZE_URL = f"{IDP_URL}/oauth/authorize"
IDP_TOKEN_URL = f"{IDP_URL}/oauth/token"

CLIENT_ID = os.environ.get("PORTAL_CLIENT_ID", "sso-portal")
CLIENT_SECRET = os.environ.get("PORTAL_CLIENT_SECRET", "synth_sec_client_secret_9941")
REDIRECT_URI = os.environ.get("PORTAL_REDIRECT_URI", "http://127.0.0.1:5000/auth/callback")

SECRET_KEY = os.environ.get("FLASK_SECRET_KEY", "portal_session_secret_key_8849")
PORT = int(os.environ.get("PORTAL_PORT", 5000))
"""
Internal Developer Portal web application with SSO integration.
"""
from urllib.parse import urlencode
import secrets
import time

import requests
from flask import Flask, session, redirect, url_for, request, jsonify, render_template_string

from sso_portal import config


def _idp_url(path: str) -> str:
    """Build an Identity Provider URL from the configured base URL."""
    base_url = getattr(config, "IDP_URL", getattr(config, "IDP_BASE_URL", "")).rstrip("/")
    return f"{base_url}/{path.lstrip('/')}"


def _normalise_user(user_data):
    """Return a JSON-serialisable user dictionary suitable for the Flask session."""
    if not isinstance(user_data, dict):
        return None

    username = user_data.get("username") or user_data.get("preferred_username") or user_data.get("email") or user_data.get("name")
    if not username:
        return None

    return {
        "id": user_data.get("id") or user_data.get("sub") or username,
        "username": username,
        "email": user_data.get("email", ""),
        "name": user_data.get("name") or username,
    }


def create_app():
    app = Flask(__name__)
    app.secret_key = config.SECRET_KEY

    @app.route("/")
    def index():
        user = session.get("user")
        return render_template_string("""
        <!DOCTYPE html>
        <html>
        <head><title>Internal Developer Portal</title></head>
        <body>
            <h1>Welcome to the Developer Portal</h1>
            {% if user %}
                <p>Logged in as: <strong>{{ user.name }} ({{ user.email }})</strong></p>
                <p><a href="/dashboard">Go to Dashboard</a></p>
                <form action="/auth/logout" method="POST"><button type="submit">Log Out</button></form>
            {% else %}
                <p>Please log in using corporate Single Sign-On.</p>
                <p><a href="/auth/login" id="login-button">Log In with Corporate SSO</a></p>
            {% endif %}
        </body>
        </html>
        """, user=user)

    @app.route("/health")
    def health():
        return jsonify({"status": "ok", "app": "sso-portal"})

    @app.route("/dashboard")
    def dashboard():
        user = session.get("user")
        if not user:
            return redirect(url_for("auth_login"))

        username = user.get("username") or user.get("name")
        return jsonify({
            "status": "authenticated",
            "message": f"Welcome to the internal dashboard, {username}",
            "username": username,
            "user": user,
        })

    @app.route("/auth/logout", methods=["GET", "POST"])
    def logout():
        session.clear()
        return redirect(url_for("auth_login"))

    @app.route("/auth/login", methods=["GET"])
    def auth_login():
        """
        Start the SSO authorization-code login flow.

        The portal stores a CSRF state value in the session, then redirects the
        browser to the central Identity Provider. The IdP redirects back to
        /auth/callback with an authorization code after authenticating the user.
        """
        state = secrets.token_urlsafe(32)
        session["oauth_state"] = state

        params = {
            "response_type": "code",
            "client_id": config.CLIENT_ID,
            "redirect_uri": config.REDIRECT_URI,
            "scope": "openid profile email",
            "state": state,
        }
        return redirect(f"{_idp_url('/oauth/authorize')}?{urlencode(params)}")

    @app.route("/auth/callback", methods=["GET"])
    def auth_callback():
        """
        Complete the SSO authorization-code login flow.

        The callback validates the returned state, exchanges the code for tokens
        and user identity at the IdP token endpoint, and stores the user in the
        Flask session so protected portal routes recognise the request as
        authenticated.
        """
        error = request.args.get("error")
        if error:
            return jsonify({
                "error": error,
                "error_description": request.args.get("error_description", "Identity Provider rejected login"),
            }), 400

        code = request.args.get("code")
        returned_state = request.args.get("state")
        expected_state = session.pop("oauth_state", None)

        if not code:
            return jsonify({"error": "missing_code", "error_description": "Missing authorization code"}), 400
        if not expected_state or not returned_state or not secrets.compare_digest(expected_state, returned_state):
            return jsonify({"error": "invalid_state", "error_description": "Invalid SSO state"}), 400

        try:
            token_response = requests.post(
                _idp_url('/oauth/token'),
                data={
                    "grant_type": "authorization_code",
                    "code": code,
                    "redirect_uri": config.REDIRECT_URI,
                    "client_id": config.CLIENT_ID,
                    "client_secret": config.CLIENT_SECRET,
                },
                timeout=5,
            )
            token_response.raise_for_status()
            token_payload = token_response.json()
        except requests.RequestException as exc:
            return jsonify({"error": "token_exchange_failed", "error_description": str(exc)}), 502
        except ValueError:
            return jsonify({"error": "invalid_token_response", "error_description": "IdP returned non-JSON token response"}), 502

        user = _normalise_user(token_payload.get("user") or token_payload.get("userinfo") or token_payload)
        if not user:
            return jsonify({"error": "invalid_user", "error_description": "IdP token response did not include a user identity"}), 502

        session.clear()
        session["user"] = user
        session["access_token"] = token_payload.get("access_token")
        session["token_type"] = token_payload.get("token_type", "Bearer")
        expires_in = token_payload.get("expires_in")
        if expires_in is not None:
            try:
                session["token_expires_at"] = int(time.time()) + int(expires_in)
            except (TypeError, ValueError):
                pass

        return redirect(url_for("dashboard"))

    return app


def run():
    app = create_app()
    app.run(host="0.0.0.0", port=config.PORT, debug=False)


if __name__ == "__main__":
    run()
