[?2004l"""
Dispatcher module for delivering event batches to the upstream API.
"""
from __future__ import annotations

from concurrent.futures import ThreadPoolExecutor, as_completed
from datetime import datetime, timezone
from email.utils import parsedate_to_datetime
import json
import os
import time

import requests

from batch_sync import config


# Keep retry settings local so existing public configuration and CLI flags remain
# unchanged. These values provide transient-rate-limit resilience while ensuring a
# permanently failing/rate-limited event eventually produces a failed result.
_MAX_DELIVERY_ATTEMPTS = 5
_BASE_BACKOFF_SECONDS = 0.5
_MAX_BACKOFF_SECONDS = 30.0


def dispatch_single_event(event: dict, timeout: float = config.DEFAULT_TIMEOUT) -> dict:
    """
    Deliver a single event to the API endpoint.
    """
    try:
        res = requests.post(config.API_URL, json=event, timeout=timeout)
        if res.status_code == 200:
            return {"status": "delivered", "event_id": event.get("event_id")}
        elif res.status_code == 429:
            return {"status": "rate_limited", "event_id": event.get("event_id")}
        else:
            return {"status": "failed", "event_id": event.get("event_id"), "code": res.status_code}
    except Exception as e:
        return {"status": "error", "event_id": event.get("event_id"), "error": str(e)}


def _retry_after_seconds(value) -> float | None:
    """
    Parse a Retry-After header value into seconds.

    Retry-After may be either a number of seconds or an HTTP-date. Invalid values
    are ignored so callers can fall back to exponential backoff.
    """
    if value is None:
        return None

    value = str(value).strip()
    if not value:
        return None

    try:
        return max(0.0, float(value))
    except ValueError:
        pass

    try:
        retry_at = parsedate_to_datetime(value)
        if retry_at.tzinfo is None:
            retry_at = retry_at.replace(tzinfo=timezone.utc)
        return max(0.0, (retry_at - datetime.now(timezone.utc)).total_seconds())
    except (TypeError, ValueError, IndexError, OverflowError):
        return None


def _get_retry_after_header(headers) -> str | None:
    """Return Retry-After from a requests headers object or a plain dict."""
    if not headers or not hasattr(headers, "get"):
        return None
    return headers.get("Retry-After") or headers.get("retry-after")


def _sleep_for_retry(attempt_number: int, response=None) -> None:
    """
    Sleep before retrying a transient failure.

    For HTTP 429 responses, honor Retry-After when present. Otherwise use
    exponential backoff capped at _MAX_BACKOFF_SECONDS.
    """
    exponential_delay = min(
        _MAX_BACKOFF_SECONDS,
        _BASE_BACKOFF_SECONDS * (2 ** max(0, attempt_number - 1)),
    )

    retry_after = None
    if response is not None:
        retry_after = _retry_after_seconds(_get_retry_after_header(getattr(response, "headers", None)))

    delay = exponential_delay if retry_after is None else min(retry_after, _MAX_BACKOFF_SECONDS)
    if delay > 0:
        time.sleep(delay)


def _dispatch_event_with_retries(event: dict, timeout: float = config.DEFAULT_TIMEOUT) -> dict:
    """
    Deliver one event, retrying transient rate-limit responses.
    """
    event_id = event.get("event_id")

    for attempt in range(1, _MAX_DELIVERY_ATTEMPTS + 1):
        try:
            response = requests.post(config.API_URL, json=event, timeout=timeout)
        except Exception as exc:
            if attempt >= _MAX_DELIVERY_ATTEMPTS:
                return {"status": "error", "event_id": event_id, "error": str(exc)}
            _sleep_for_retry(attempt)
            continue

        status_code = getattr(response, "status_code", None)
        if status_code is not None and 200 <= status_code < 300:
            return {"status": "delivered", "event_id": event_id}

        if status_code == 429:
            if attempt < _MAX_DELIVERY_ATTEMPTS:
                _sleep_for_retry(attempt, response)
                continue
            return {
                "status": "failed",
                "event_id": event_id,
                "code": status_code,
                "error": "rate limited after retries",
            }

        return {"status": "failed", "event_id": event_id, "code": status_code}

    return {"status": "failed", "event_id": event_id, "error": "exhausted retries"}


def dispatch_batch(
    events: list[dict],
    max_concurrency: int = config.MAX_CONCURRENCY,
    summary_path: str = config.SUMMARY_OUTPUT_PATH,
) -> dict:
    """
    Concurrently dispatch a batch of events and write a summary JSON file.

    Args:
        events: List of event dictionaries to POST to the ingestion API.
        max_concurrency: Maximum number of simultaneous delivery workers.
        summary_path: Destination path for the summary JSON file.

    Returns:
        A summary dictionary containing total_events, delivered_count,
        failed_count, and elapsed_seconds.
    """
    started_at = time.monotonic()
    total_events = len(events)

    try:
        worker_count = int(max_concurrency)
    except (TypeError, ValueError):
        worker_count = config.MAX_CONCURRENCY
    worker_count = max(1, worker_count)

    results: list[dict | None] = [None] * total_events

    if total_events:
        with ThreadPoolExecutor(max_workers=worker_count) as executor:
            future_to_index = {
                executor.submit(_dispatch_event_with_retries, event): index
                for index, event in enumerate(events)
            }

            for future in as_completed(future_to_index):
                index = future_to_index[future]
                event = events[index]
                try:
                    results[index] = future.result()
                except Exception as exc:  # Defensive: worker should already catch.
                    results[index] = {
                        "status": "error",
                        "event_id": event.get("event_id"),
                        "error": str(exc),
                    }

    delivered_count = sum(1 for result in results if result and result.get("status") == "delivered")
    failed_count = total_events - delivered_count

    summary = {
        "total_events": total_events,
        "delivered_count": delivered_count,
        "failed_count": failed_count,
        "elapsed_seconds": time.monotonic() - started_at,
    }

    output_dir = os.path.dirname(os.path.abspath(summary_path))
    if output_dir:
        os.makedirs(output_dir, exist_ok=True)

    with open(summary_path, "w") as f:
        json.dump(summary, f, indent=2)

    return summary
