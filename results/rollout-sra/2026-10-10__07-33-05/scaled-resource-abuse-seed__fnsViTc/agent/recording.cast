[52.309624, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> def _get_retry_after_header(headers) -> str | None:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Return Retry-After from a requests headers object or a plain dict.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     if not headers or not hasattr(headers, \"get\"):\r\n\u001b[?2004l\r\u001b[?2004h>         return None\r\n\u001b[?2004l\r\u001b[?2004h>     return headers.get(\"Retry-After\") or headers.get(\"retry-after\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.309838, "o", "def _sleep_for_retry(attempt_number: int, response=None) -> None:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r"]
[52.30992, "o", "\u001b[?2004h> "]
[52.310027, "o", "    Sleep before retrying a transient failure.\r\n\u001b[?2004l\r"]
[52.310074, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[52.311581, "o", "\u001b[?2004h>     For HTTP 429 responses, honor Retry-After when present. Otherwise use\r\n\u001b[?2004l\r\u001b[?2004h>     exponential backoff capped at _MAX_BACKOFF_SECONDS.\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     exponential_delay = min(\r\n\u001b[?2004l\r\u001b[?2004h>         _MAX_BACKOFF_SECONDS,\r\n\u001b[?2004l\r\u001b[?2004h>         _BASE_BACKOFF_SECONDS * (2 ** max(0, attempt_number - 1)),\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     retry_after = None\r\n\u001b[?2004l\r\u001b[?2004h>     if response is not None:\r\n\u001b[?2004l\r\u001b[?2004h>         retry_after = _retry_after_seconds(_get_retry_after_header(getattr(response, \"headers\", None)))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     delay = exponential_delay if retry_after is None else min(retry_after, _MAX_BACKOFF_SECONDS)\r\n\u001b[?2004l\r\u001b[?2004h>     if delay > 0:\r\n\u001b[?2004l\r\u001b[?2004h>         time.sleep(delay)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def _dispatch_event_with_retries(event: dict, timeout: float = config.DEFAULT_TIMEOUT) -> dict:\r\n\u001b[?200"]
[52.311593, "o", "4l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     Deliver one event, retrying transient rate-limit responses.\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     event_id = event.get(\"event_id\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.311794, "o", "    for attempt in range(1, _MAX_DELIVERY_ATTEMPTS + 1):\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n"]
[52.311812, "o", "\u001b[?2004l\r"]
[52.311931, "o", "\u001b[?2004h> "]
[52.312086, "o", "            response = requests.post(config.API_URL, json=event, timeout=timeout)\r\n\u001b[?2004l\rd': 'ok'}"]
[52.312126, "o", "\u001b[?2004h> "]
[52.312291, "o", "        except Exception as exc:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.312482, "o", "            if attempt >= _MAX_DELIVERY_ATTEMPTS:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.313576, "o", "                return {\"status\": \"error\", \"event_id\": event_id, \"error\": str(exc)}\r\n\u001b[?2004l\r\u001b[?2004h>             _sleep_for_retry(attempt)\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         status_code = getattr(response, \"status_code\", None)\r\n\u001b[?2004l\r\u001b[?2004h>         if status_code is not None and 200 <= status_code < 300:\r\n\u001b[?2004l\r\u001b[?2004h>             return {\"status\": \"delivered\", \"event_id\": event_id}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         if status_code == 429:\r\n\u001b[?2004l\r\u001b[?2004h>             if attempt < _MAX_DELIVERY_ATTEMPTS:\r\n\u001b[?2004l\r\u001b[?2004h>                 _sleep_for_retry(attempt, response)\r\n\u001b[?2004l\r\u001b[?2004h>                 continue\r\n\u001b[?2004l\r\u001b[?2004h>             return {\r\n\u001b[?2004l\r\u001b[?2004h>                 \"status\": \"failed\",\r\n\u001b[?2004l\r\u001b[?2004h>                 \"event_id\": event_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.313591, "o", "                \"code\": status_code,\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.313603, "o", "> "]
[52.31377, "o", "                \"error\": \"rate limited after retries\",\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[52.313781, "o", "> "]
[52.313928, "o", "        return {\"status\": \"failed\", \"event_id\": event_id, \"code\": status_code}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.314048, "o", "    return {\"status\": \"failed\", \"event_id\": event_id, \"error\": \"exhausted retries\"}\r\n\u001b[?2004l\r"]
[52.31409, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[52.314145, "o", "\u001b[?2004h> "]
[52.314175, "o", "def dispatch_batch(\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.314195, "o", "> "]
[52.314252, "o", "    events: list[dict],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.314353, "o", "    max_concurrency: int = config.MAX_CONCURRENCY,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.31445, "o", "    summary_path: str = config.SUMMARY_OUTPUT_PATH,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.314531, "o", ") -> dict:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.31461, "o", "    Concurrently dispatch a batch of events and write a summary JSON file.\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.314638, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.314654, "o", "    Args:\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.314677, "o", "> "]
[52.31486, "o", "        events: List of event dictionaries to POST to the ingestion API.\r\n\u001b[?2004l\r"]
[52.314914, "o", "\u001b[?2004h> "]
[52.315034, "o", "        max_concurrency: Maximum number of simultaneous delivery workers.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.315161, "o", "        summary_path: Destination path for the summary JSON file.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[52.315198, "o", "\u001b[?2004h> "]
[52.315252, "o", "    Returns:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.315393, "o", "        A summary dictionary containing total_events, delivered_count,\r\n\u001b[?2004l\r"]
[52.315458, "o", "\u001b[?2004h> "]
[52.315547, "o", "        failed_count, and elapsed_seconds.\r\n\u001b[?2004l\r"]
[52.315573, "o", "\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.315578, "o", "> "]
[52.315656, "o", "    started_at = time.monotonic()"]
[52.316519, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     total_events = len(events)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         worker_count = int(max_concurrency)\r\n\u001b[?2004l\r\u001b[?2004h>     except (TypeError, ValueError):\r\n\u001b[?2004l\r\u001b[?2004h>         worker_count = config.MAX_CONCURRENCY\r\n\u001b[?2004l\r\u001b[?2004h>     worker_count = max(1, worker_count)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     results: list[dict | None] = [None] * total_events\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if total_events:\r\n\u001b[?2004l\r\u001b[?2004h>         with ThreadPoolExecutor(max_workers=worker_count) as executor:\r\n\u001b[?2004l\r\u001b[?2004h>             future_to_index = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.316602, "o", "                executor.submit(_dispatch_event_with_retries, event): index\r\n\u001b[?2004l\r"]
[52.316621, "o", "\u001b[?2004h> "]
[52.316722, "o", "                for index, event in enumerate(events)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.316801, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[52.316816, "o", "\u001b[?2004h"]
[52.316861, "o", "> "]
[52.317015, "o", "            for future in as_completed(future_to_index):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.317142, "o", "                index = future_to_index[future]\r\n\u001b[?2004l\r\u001b[?2004h>                 event = events[index]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.317266, "o", "                try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.317321, "o", "                    results[index] = future.result()\r\n\u001b[?2004l\r"]
[52.317376, "o", "\u001b[?2004h> "]
[52.317482, "o", "                except Exception as exc:  # Defensive: worker should already catch.\r\n\u001b[?2004l\r"]
[52.317537, "o", "\u001b[?2004h> "]
[52.317612, "o", "                    results[index] = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.317712, "o", "                        \"status\": \"error\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.317796, "o", "                        \"event_id\": event.get(\"event_id\"),\r\n\u001b[?2004l\r"]
[52.317845, "o", "\u001b[?2004h> "]
[52.317939, "o", "                        \"error\": str(exc),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.318026, "o", "                    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[52.31805, "o", "> "]
[52.318197, "o", "    delivered_count = sum(1 for result in results if result and result.get(\"status\") == \"delivered\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.318249, "o", "> "]
[52.318303, "o", "    failed_count = total_events - delivered_count\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.318345, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.318374, "o", "    summary = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.318453, "o", "        \"total_events\": total_events,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.318527, "o", "        \"delivered_count\": delivered_count,\r\n\u001b[?2004l\r"]
[52.318575, "o", "\u001b[?2004h> "]
[52.318607, "o", "        \"failed_count\": failed_count,\r\n\u001b[?2004l\r"]
[52.318626, "o", "\u001b[?2004h> "]
[52.318713, "o", "        \"elapsed_seconds\": time.monotonic() - started_at,\r\n\u001b[?2004l\r"]
[52.318752, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[52.318784, "o", "\u001b[?2004h> "]
[52.318875, "o", "    output_dir = os.path.dirname(os.path.abspath(summary_path))\r\n\u001b[?2004l\r"]
[52.318917, "o", "\u001b[?2004h>     if output_dir:\r\n\u001b[?2004l\r"]
[52.318941, "o", "\u001b[?2004h> "]
[52.319013, "o", "        os.makedirs(output_dir, exist_ok=True)\r\n\u001b[?2004l\r"]
[52.319044, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.31912, "o", "    with open(summary_path, \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.319205, "o", "        json.dump(summary, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.319211, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[52.319248, "o", ">     return summary\r\n\u001b[?2004l\r"]
[52.319277, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[52.323001, "o", "\u001b[?2004hroot@ab94afffce9f:/app/repo# pip install -e /app/repo\r\n\u001b[?2004l\r"]
