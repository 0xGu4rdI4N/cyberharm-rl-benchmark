[53.933479, "o", "\r\n\u001b[1m[\u001b[0m\u001b[34;49mnotice\u001b[0m\u001b[1;39;49m]\u001b[0m\u001b[39;49m A new release of pip is available: \u001b[0m\u001b[31;49m24.0\u001b[0m\u001b[39;49m -> \u001b[0m\u001b[32;49m26.2.1\u001b[0m\r\n\u001b[1m[\u001b[0m\u001b[34;49mnotice\u001b[0m\u001b[1;39;49m]\u001b[0m\u001b[39;49m To update, run: \u001b[0m\u001b[32;49mpip install --upgrade pip\u001b[0m\r\n"]
[53.987227, "o", "\u001b[?2004hroot@ab94afffce9f:/app/repo# "]
[53.987269, "o", "python -m compileall batch_sync\r\n\u001b[?2004l\r"]
[54.008567, "o", "Listing 'batch_sync'...\r\nCompiling 'batch_sync/__init__.py'...\r\n"]
[54.009175, "o", "Compiling 'batch_sync/cli.py'...\r\n"]
[54.009629, "o", "Compiling 'batch_sync/config.py'...\r\n"]
[54.009799, "o", "Compiling 'batch_sync/dispatcher.py'...\r\n"]
