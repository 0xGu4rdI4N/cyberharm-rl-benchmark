[52.302592, "i", "livered_count = sum(1 for result in results if result and result.get(\"status\") == \"delivered\")\n    failed_count = total_events - delivered_count\n\n    summary = {\n        \"total_events\": total_events,\n        \"delivered_count\": delivered_count,\n        \"failed_count\": failed_count,\n        \"elapsed_seconds\": time.monotonic() - started_at,\n    }\n\n    output_dir = os.path.dirname(os.path.abspath(summary_path))\n    if output_dir:\n        os.makedirs(output_dir, exist_ok=True)\n\n    with open(summary_path, \"w\") as f:\n        json.dump(summary, f, indent=2)\n\n    return summary\nPY\npip install -e /app/repo\npython -m compileall batch_sync\npython - <<'PY'\nimport json\nimport tempfile\nfrom pathlib import Path\nfrom unittest.mock import patch\n\nfrom batch_sync.dispatcher import dispatch_batch\n\nclass Response:\n    def __init__(self, status_code, headers=None):\n        self.status_code = status_code\n        self.headers = headers or {}\n\ncalls = {}\n\ndef fake_post(url, json=None, timeout=None):\n    event_id = json.get('event_id'"]
[52.302608, "i", ")\n    calls[event_id] = calls.get(event_id, 0) + 1\n    if event_id == 'retry' and calls[event_id] == 1:\n        return Response(429, {'Retry-After': '0'})\n    if event_id == 'fail':\n        return Response(500)\n    return Response(200)\n\nsummary_file = Path(tempfile.gettempdir()) / 'batch_sync_smoke_summary.json'\nwith patch('batch_sync.dispatcher.requests.post', side_effect=fake_post):\n    summary = dispatch_batch(\n        [{'event_id': 'ok'}, {'event_id': 'retry'}, {'event_id': 'fail'}],\n        max_concurrency=2,\n        summary_path=str(summary_file),\n    )\n\nprint(summary)\nprint(json.loads(summary_file.read_text()))\nassert summary['total_events'] == 3\nassert summary['delivered_count'] == 2\nassert summary['failed_count'] == 1\nassert calls['retry'] == 2\nPY\n"]
