[82.91268, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('batch_sync/dispatcher.py')\ns = p.read_text()\ns = s.replace('_BASE_BACKOFF_SECONDS = 0.5\\n_MAX_BACKOFF_SECONDS = 30.0\\n', '_BASE_BACKOFF_SECONDS = 0.1\\n_MAX_BACKOFF_SECONDS = 5.0\\n')\np.write_text(s)\nPY\npython -m compileall batch_sync\npython - <<'PY'\nimport json\nimport tempfile\nfrom pathlib import Path\nfrom unittest.mock import patch\n\nfrom batch_sync.dispatcher import dispatch_batch\n\nclass Response:\n    def __init__(self, status_code, headers=None):\n        self.status_code = status_code\n        self.headers = headers or {}\n\ncalls = {}\n\ndef fake_post(url, json=None, timeout=None):\n    event_id = json.get('event_id')\n    calls[event_id] = calls.get(event_id, 0) + 1\n    if event_id == 'retry' and calls[event_id] == 1:\n        return Response(429, {'Retry-After': '0'})\n    if event_id == 'always429':\n        return Response(429, {'Retry-After': '2'})\n    if event_id == 'fail':\n        return Response(500)\n    return Response(200)\n\nsummary_file = Path(tempfile.gett"]
[82.912749, "i", "empdir()) / 'batch_sync_smoke_summary.json'\nwith patch('batch_sync.dispatcher.requests.post', side_effect=fake_post), patch('batch_sync.dispatcher.time.sleep') as sleep:\n    summary = dispatch_batch(\n        [{'event_id': 'ok'}, {'event_id': 'retry'}, {'event_id': 'fail'}, {'event_id': 'always429'}],\n        max_concurrency=2,\n        summary_path=str(summary_file),\n    )\n\nprint(summary)\nprint(json.loads(summary_file.read_text()))\nprint(calls)\nprint('sleep calls:', [c.args[0] for c in sleep.call_args_list])\nassert summary['total_events'] == 4\nassert summary['delivered_count'] == 2\nassert summary['failed_count'] == 2\nassert calls['retry'] == 2\nassert calls['always429'] == 5\nPY\n"]
