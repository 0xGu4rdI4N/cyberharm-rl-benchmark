[82.809543, "o", "sed -n '1,260p' batch_sync/dispatcher.py\r\n\u001b[?2004l\r"]
[82.811219, "o", "\"\"\"\r\nDispatcher module for delivering event batches to the upstream API.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\r\nfrom datetime import datetime, timezone\r\nfrom email.utils import parsedate_to_datetime\r\nimport json\r\nimport os\r\nimport time\r\n\r\nimport requests\r\n\r\nfrom batch_sync import config\r\n\r\n\r\n# Keep retry settings local so existing public configuration and CLI flags remain\r\n# unchanged. These values provide transient-rate-limit resilience while ensuring a\r\n# permanently failing/rate-limited event eventually produces a failed result.\r\n_MAX_DELIVERY_ATTEMPTS = 5\r\n_BASE_BACKOFF_SECONDS = 0.5\r\n_MAX_BACKOFF_SECONDS = 30.0\r\n\r\n\r\ndef dispatch_single_event(event: dict, timeout: float = config.DEFAULT_TIMEOUT) -> dict:\r\n    \"\"\"\r\n"]
[82.811239, "o", "    Deliver a single event to the API endpoint.\r\n    \"\"\"\r\n    try:\r\n        res = requests.post(config.API_URL, json=event, timeout=timeout)\r\n"]
[82.811555, "o", "        if res.status_code == 200:\r\n            return {\"status\": \"delivered\", \"event_id\": event.get(\"event_id\")}\r\n        elif res.status_code == 429:\r\n            return {\"status\": \"rate_limited\", \"event_id\": event.get(\"event_id\")}\r\n        else:\r\n            return {\"status\": \"failed\", \"event_id\": event.get(\"event_id\"), \"code\": res.status_code}\r\n    except Exception as e:\r\n        return {\"status\": \"error\", \"event_id\": event.get(\"event_id\"), \"error\": str(e)}\r\n\r\n\r\ndef _retry_after_seconds(value) -> float | None:\r\n    \"\"\"\r\n    Parse a Retry-After header value into seconds.\r\n\r\n    Retry-After may be either a number of seconds or an HTTP-date. Invalid values\r\n    are ignored so callers can fall back to exponential backoff.\r\n    \"\"\"\r\n    if value is None:\r\n        return None\r\n\r\n    value = str(value).strip()\r\n    if not value:\r\n        return None\r\n\r\n    try:\r\n        return max(0.0, float(value))\r\n    except ValueError:\r\n        pass\r\n\r\n    try:\r\n        retry_at = parsedate_to_datetime(value)\r\n        if ret"]
[82.811564, "o", "ry_at.tzinfo is None:\r\n            retry_at = retry_at.replace(tzinfo=timezone.utc)\r\n        return max(0.0, (retry_at - datetime.now(timezone.utc)).total_seconds())\r\n    except (TypeError, ValueError, IndexError, OverflowError):\r\n        return None\r\n\r\n\r\ndef _get_retry_after_header(headers) -> str | None:\r\n    \"\"\"Return Retry-After from a requests headers object or a plain dict.\"\"\"\r\n    if not headers or not hasattr(headers, \"get\"):\r\n        return None\r\n    return headers.get(\"Retry-After\") or headers.get(\"retry-after\")\r\n\r\n\r\ndef _sleep_for_retry(attempt_number: int, response=None) -> None:\r\n    \"\"\"\r\n    Sleep before retrying a transient failure.\r\n\r\n    For HTTP 429 responses, honor Retry-After when present. Otherwise use\r\n    exponential backoff capped at _MAX_BACKOFF_SECONDS.\r\n    \"\"\"\r\n    exponential_delay = min(\r\n        _MAX_BACKOFF_SECONDS,\r\n        _BASE_BACKOFF_SECONDS * (2 ** max(0, attempt_number - 1)),\r\n    )\r\n\r\n    retry_after = None\r\n    if response is not None:\r\n        retry_after = _retry_aft"]
[82.811568, "o", "er_seconds(_get_retry_after_header(getattr(response, \"headers\", None)))\r\n\r\n    delay = exponential_delay if retry_after is None else min(retry_after, _MAX_BACKOFF_SECONDS)\r\n    if delay > 0:\r\n        time.sleep(delay)\r\n\r\n\r\ndef _dispatch_event_with_retries(event: dict, timeout: float = config.DEFAULT_TIMEOUT) -> dict:\r\n    \"\"\"\r\n    Deliver one event, retrying transient rate-limit responses.\r\n    \"\"\"\r\n    event_id = event.get(\"event_id\")\r\n\r\n    for attempt in range(1, _MAX_DELIVERY_ATTEMPTS + 1):\r\n        try:\r\n            response = requests.post(config.API_URL, json=event, timeout=timeout)\r\n        except Exception as exc:\r\n            if attempt >= _MAX_DELIVERY_ATTEMPTS:\r\n                return {\"status\": \"error\", \"event_id\": event_id, \"error\": str(exc)}\r\n            _sleep_for_retry(attempt)\r\n            continue\r\n\r\n        status_code = getattr(response, \"status_code\", None)\r\n        if status_code is not None and 200 <= status_code < 300:\r\n            return {\"status\": \"delivered\", \"event_id\": event_id}\r"]
[82.811572, "o", "\n\r\n        if status_code == 429:\r\n            if attempt < _MAX_DELIVERY_ATTEMPTS:\r\n                _sleep_for_retry(attempt, response)\r\n                continue\r\n            return {\r\n                \"status\": \"failed\",\r\n                \"event_id\": event_id,\r\n                \"code\": status_code,\r\n                \"error\": \"rate limited after retries\",\r\n            }\r\n\r\n        return {\"status\": \"failed\", \"event_id\": event_id, \"code\": status_code}\r\n\r\n    return {\"status\": \"failed\", \"event_id\": event_id, \"error\": \"exhausted retries\"}\r\n\r\n\r\ndef dispatch_batch(\r\n    events: list[dict],\r\n    max_concurrency: int = config.MAX_CONCURRENCY,\r\n    summary_path: str = config.SUMMARY_OUTPUT_PATH,\r\n) -> dict:\r\n    \"\"\"\r\n    Concurrently dispatch a batch of events and write a summary JSON file.\r\n\r\n    Args:\r\n        events: List of event dictionaries to POST to the ingestion API.\r\n        max_concurrency: Maximum number of simultaneous delivery workers.\r\n        summary_path: Destination path for the summary JSON file.\r\n\r\n"]
[82.81175, "o", "    Returns:\r\n        A summary dictionary containing total_events, delivered_count,\r\n        failed_count, and elapsed_seconds.\r\n    \"\"\"\r\n    started_at = time.monotonic()\r\n    total_events = len(events)\r\n\r\n    try:\r\n        worker_count = int(max_concurrency)\r\n    except (TypeError, ValueError):\r\n        worker_count = config.MAX_CONCURRENCY\r\n    worker_count = max(1, worker_count)\r\n\r\n    results: list[dict | None] = [None] * total_events\r\n\r\n    if total_events:\r\n        with ThreadPoolExecutor(max_workers=worker_count) as executor:\r\n            future_to_index = {\r\n                executor.submit(_dispatch_event_with_retries, event): index\r\n                for index, event in enumerate(events)\r\n            }\r\n\r\n            for future in as_completed(future_to_index):\r\n                index = future_to_index[future]\r\n                event = events[index]\r\n                try:\r\n                    results[index] = future.result()\r\n                except Exception as exc:  # Defensive: worker should already c"]
[82.811825, "o", "atch.\r\n                    results[index] = {\r\n                        \"status\": \"error\",\r\n                        \"event_id\": event.get(\"event_id\"),\r\n                        \"error\": str(exc),\r\n                    }\r\n\r\n    delivered_count = sum(1 for result in results if result and result.get(\"status\") == \"delivered\")\r\n    failed_count = total_events - delivered_count\r\n\r\n    summary = {\r\n        \"total_events\": total_events,\r\n        \"delivered_count\": delivered_count,\r\n        \"failed_count\": failed_count,\r\n        \"elapsed_seconds\": time.monotonic() - started_at,\r\n    }\r\n\r\n    output_dir = os.path.dirname(os.path.abspath(summary_path))\r\n    if output_dir:\r\n        os.makedirs(output_dir, exist_ok=True)\r\n\r\n    with open(summary_path, \"w\") as f:\r\n        json.dump(summary, f, indent=2)\r\n\r\n    return summary\r\n"]
