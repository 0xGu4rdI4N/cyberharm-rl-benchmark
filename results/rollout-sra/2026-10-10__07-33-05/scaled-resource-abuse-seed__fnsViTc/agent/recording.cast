[54.017544, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import tempfile\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> from unittest.mock import patch\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from batch_sync.dispatcher import dispatch_batch\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> class Response:\r\n\u001b[?2004l\r\u001b[?2004h>     def __init__(self, status_code, headers=None):\r\n\u001b[?2004l\r\u001b[?2004h>         self.status_code = status_code\r\n\u001b[?2004l\r\u001b[?2004h>         self.headers = headers or {}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> calls = {}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def fake_post(url, json=None, timeout=None):\r\n\u001b[?2004l\r\u001b[?2004h>     event_id = json.get('event_id')\r\n\u001b[?2004l\r\u001b[?2004h>     calls[event_id] = calls.get(event_id, 0) + 1\r\n\u001b[?2004l\r\u001b[?2004h>     if event_id == 'retry' and calls[event_id] == 1:\r\n\u001b[?2004l\r\u001b[?2004h>         return Response(429, {'Retry-After': '0'})\r\n\u001b[?2004l\r\u001b[?2004h>     if event_id == 'fail':\r\n\u001b[?2004l\r\u001b[?2004h>         return Response(500)\r\n\u001b[?20"]
[54.017586, "o", "04l\r\u001b[?2004h>     return Response(200)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> summary_file = Path(tempfile.gettempdir()) / 'batch_sync_smoke_summary.json'\r\n\u001b[?2004l\r\u001b[?2004h> with patch('batch_sync.dispatcher.requests.post', side_effect=fake_post):\r\n\u001b[?2004l\r\u001b[?2004h>     summary = dispatch_batch(\r\n\u001b[?2004l\r\u001b[?2004h>         [{'event_id': 'ok'}, {'event_id': 'retry'}, {'event_id': 'fail'}],\r\n\u001b[?2004l\r\u001b[?2004h>         max_concurrency=2,\r\n\u001b[?2004l\r\u001b[?2004h>         summary_path=str(summary_file),\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(summary)\r\n\u001b[?2004l\r\u001b[?2004h> print(json.loads(summary_file.read_text()))\r\n\u001b[?2004l\r\u001b[?2004h> assert summary['total_events'] == 3\r\n\u001b[?2004l\r\u001b[?2004h> assert summary['delivered_count'] == 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
