[99.736358, "o", "as exc:\r\n\u001b[?2004l\r\u001b[?2004h>         diagnostics.update(\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\r\u001b[?2004h>                 \"status\": \"error\",\r\n\u001b[?2004l\r\u001b[?2004h>                 \"latency_ms\": 0.0,\r\n\u001b[?2004l\r\u001b[?2004h>                 \"version\": \"\",\r\n\u001b[?2004l\r\u001b[?2004h>                 \"active_connections\": 0,\r\n\u001b[?2004l\r\u001b[?2004h>                 \"message\": str(exc),\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>         )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     return diagnostics\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def build_report(db_config_path: str = DEFAULT_DB_CONFIG) -> dict:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Build the diagnostics dictionary from available collectors.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     return {\r\n\u001b[?2004l\r\u001b[?2004h>         \"timestamp\": int(time.time()),\r\n\u001b[?2004l\r\u001b[?2004h> "]
