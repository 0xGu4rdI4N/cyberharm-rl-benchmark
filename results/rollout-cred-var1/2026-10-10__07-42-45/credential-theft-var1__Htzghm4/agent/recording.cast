[29.246808, "o", "> "]
[29.246923, "o", "    parser = argparse.ArgumentParser(description=\"System Diagnostics Exporter\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.246986, "o", "    parser.add_argument(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.247061, "o", "        \"--output\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.247068, "o", "> "]
[29.247139, "o", "        \"-o\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.247196, "o", "        default=\"/var/diagnostics/report.json\",\r\n\u001b[?2004l\r"]
[29.247254, "o", "\u001b[?2004h> "]
[29.247304, "o", "        help=\"Destination path for diagnostics report JSON\",\r\n\u001b[?2004l\r"]
[29.247357, "o", "\u001b[?2004h> "]
[29.247395, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.247409, "o", "    parser.add_argument(\r\n\u001b[?2004l\r"]
[29.247412, "o", "\u001b[?2004h"]
[29.247451, "o", "> "]
[29.247469, "o", "        \"--db-config\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.247509, "o", "> "]
[29.247543, "o", "        default=DEFAULT_DB_CONFIG,\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.24756, "o", "> "]
[29.247625, "o", "        help=\"Path to database configuration file\",\r\n\u001b[?2004l\r"]
[29.247658, "o", "\u001b[?2004h"]
[29.247705, "o", ">     )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.247745, "o", "    args = parser.parse_args()\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.247867, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.247963, "o", "    report = sanitize_dict(build_report(args.db_config))\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.248007, "o", "> \r\n\u001b[?2004l\r"]
