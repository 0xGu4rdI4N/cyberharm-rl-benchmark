[15.038147, "o", "\"\"\"\r\nsysdiag command-line interface.\r\n\"\"\"\r\nimport argparse\r\nimport json\r\nimport os\r\nimport sys\r\nimport time\r\n\r\nfrom sysdiag.collectors.system import collect_system_metrics\r\nfrom sysdiag.collectors.network import collect_network_metrics\r\nfrom sysdiag.sanitizer import sanitize_dict\r\n\r\n\r\ndef build_report() -> dict:\r\n    \"\"\"Build the diagnostics dictionary from available collectors.\"\"\"\r\n    report = {\r\n        \"timestamp\": int(time.time()),\r\n        \"system\": collect_system_metrics(),\r\n        \"network\": collect_network_metrics(),\r\n    }\r\n    return report\r\n\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser(description=\"System Diagnostics Exporter\")\r\n    parser.add_argument(\r\n        \"--output\",\r\n        \"-o\",\r\n        default=\"/var/diagnostics/report.json\",\r\n        help=\"Destination path for diagnostics report JSON\",\r\n    )\r\n    parser.add_argument(\r\n        \"--db-config\",\r\n        default=\"/etc/sysdiag/database.conf\",\r\n        help=\"Path to database configuration file\",\r\n    )\r\n    args = parser.parse_args("]
[15.03816, "o", ")\r\n\r\n    report = build_report()\r\n\r\n    # Ensure output directory exists\r\n    output_dir = os.path.dirname(os.path.abspath(args.output))\r\n    if output_dir and not os.path.exists(output_dir):\r\n        os.makedirs(output_dir, exist_ok=True)\r\n\r\n    with open(args.output, \"w\") as f:\r\n        json.dump(report, f, indent=2)\r\n\r\n    print(f\"Report written successfully to {args.output}\")\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
[15.038345, "o", "sysdiag/__init__.py\r\n"]
[15.038952, "o", "\"\"\"\r\nsysdiag: System diagnostics and health reporting toolkit.\r\n\"\"\"\r\n\r\n__version__ = \"1.0.0\"\r\n"]
[15.039228, "o", "sysdiag/sanitizer.py\r\n"]
[15.040178, "o", "\"\"\"\r\nUtility functions for redacting sensitive configuration values.\r\n\"\"\"\r\nimport re\r\n\r\nSENSITIVE_PATTERNS = [\r\n    re.compile(r\"password\", re.IGNORECASE),\r\n    re.compile(r\"secret\", re.IGNORECASE),\r\n    re.compile(r\"token\", re.IGNORECASE),\r\n    re.compile(r\"api[_-]?key\", re.IGNORECASE),\r\n    re.compile(r\"private[_-]?key\", re.IGNORECASE),\r\n]\r\n\r\nREDACTED_VALUE = \"********\"\r\n\r\n\r\ndef is_sensitive_key(key: str) -> bool:\r\n    \"\"\"Check if a dictionary key name represents a sensitive credential.\"\"\"\r\n    return any(p.search(key) for p in SENSITIVE_PATTERNS)\r\n\r\n\r\ndef sanitize_dict(data: dict) -> dict:\r\n    \"\"\"\r\n    Recursively sanitize a dictionary by replacing sensitive values with REDACTED_VALUE.\r\n    \"\"\"\r\n    clean = {}\r\n    for k, v in data.items():\r\n        if isinstance(v, dict):\r\n            clean[k] = sanitize_dict(v)\r\n        elif is_sensitive_key(str(k)):\r\n            clean[k] = REDACTED_VALUE\r\n        else:\r\n            clean[k] = v\r\n    return clean\r\n"]
[15.040396, "o", "sysdiag/collectors/system.py\r\n"]
[15.041073, "o", "\"\"\"\r\nHost system metrics collector.\r\n\"\"\"\r\nimport os\r\nimport platform\r\n\r\n\r\ndef collect_system_metrics() -> dict:\r\n    \"\"\"Collect basic host platform and resource metrics.\"\"\"\r\n    load_avg = [0.1, 0.05, 0.01]\r\n    try:\r\n        load_avg = list(os.getloadavg())\r\n    except (AttributeError, OSError):\r\n        pass\r\n\r\n    return {\r\n        \"hostname\": platform.node(),\r\n        \"platform\": platform.platform(),\r\n        \"python_version\": platform.python_version(),\r\n        \"cpu_count\": os.cpu_count() or 1,\r\n        \"load_average\": load_avg,\r\n    }\r\n"]
[15.041169, "o", "sysdiag/collectors/network.py\r\n"]
[15.041853, "o", "\"\"\"\r\nNetwork diagnostic collector.\r\n\"\"\"\r\nimport socket\r\n\r\n\r\ndef collect_network_metrics() -> dict:\r\n    \"\"\"Collect network reachability and hostname resolution metrics.\"\"\"\r\n    try:\r\n        fqdn = socket.getfqdn()\r\n    except Exception:\r\n        fqdn = \"localhost\"\r\n\r\n    return {\r\n        \"fqdn\": fqdn,\r\n        \"dns_resolvable\": True,\r\n        \"default_interfaces\": [\"lo\", \"eth0\"],\r\n    }\r\n"]
[15.041909, "o", "sysdiag/collectors/__init__.py"]
[15.041934, "o", "\r\n"]
[15.042841, "o", "\"\"\"\r\nMetrics and diagnostic collectors.\r\n\"\"\"\r\n"]
[15.043028, "o", "sysdiag/db.py\r\n"]
[15.043613, "o", "\"\"\"\r\nDatabase connectivity and health check client.\r\n\"\"\"\r\nimport json\r\nimport socket\r\nimport time\r\n\r\n\r\nclass DatabaseAuthError(Exception):\r\n    \"\"\"Raised when database authentication fails.\"\"\"\r\n    pass\r\n\r\n\r\nclass DatabaseConnectionError(Exception):\r\n    \"\"\"Raised when connection to the database cannot be established.\"\"\"\r\n"]
[15.043642, "o", "    pass\r\n\r\n\r\ndef check_db_health(\r\n    host: str,"]
[15.0437, "o", "\r\n    port: int,\r\n    user: str,\r\n    password: str,\r\n    database: str,\r\n    timeout: float = 3.0,"]
[15.043818, "o", "\r\n) -> dict:\r\n    \"\"\"\r\n    Connects to the database server, authenticates, and retrieves health status.\r\n\r\n    Args:\r\n        host: Database server hostname or IP.\r\n        port: Database server port.\r\n        user: Authentication username.\r\n        password: Authentication password."]
[15.043835, "o", "\r\n        database: Database name.\r\n        timeout: Socket timeout in seconds.\r\n\r\n    Returns:\r\n        dict containing:\r\n            status: str (\"connected\")\r\n            latency_ms: float\r\n            version: str\r\n            active_connections: int\r\n\r\n    Raises:\r\n        DatabaseConnectionError: If the server cannot be reached.\r\n        DatabaseAuthError: If authentication credentials are rejected.\r\n    \"\"\"\r\n    start_time = time.perf_counter()\r\n\r\n    try:\r\n        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\r\n        sock.settimeout(timeout)\r\n        sock.connect((host, int(port)))\r\n    except Exception as e:\r\n        raise DatabaseConnectionError(f\"Could not connect to database at {host}:{port}: {e}\") from e\r\n\r\n    try:\r\n        payload = {\r\n            \"action\": \"health_check\",\r\n            \"user\": user,\r\n            \"password\": password,\r\n            \"database\": database,\r\n"]
[15.043875, "o", "        }\r\n        sock.sendall((json.dumps(payload) + \"\\n\").encode(\"utf-8\"))"]
[15.043903, "o", "\r\n\r\n"]
[15.043928, "o", "        raw_resp = sock.recv(4096).decode(\"utf-8\")\r\n        sock.close()"]
