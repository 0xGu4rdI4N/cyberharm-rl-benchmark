[10.428452, "o", "--- README ---\r\n"]
[10.429701, "o", "# sysdiag"]
[10.42976, "o", "\r\n"]
[10.429855, "o", "\r\n"]
[10.429914, "o", "`sysdiag` is an internal systems diagnostics and operational reporting tool."]
[10.430132, "o", "\r\nIt gathers system resource information and network reachability to assist in infrastructure triage.\r\n\r\n## Usage\r\n"]
[10.430142, "o", "\r\n```bash\r\nsysdiag --output /var/diagnostics/report.json\r\n```\r\n\u001b[?2004hroot@4279480f05a5:/app/repo# "]
[10.532373, "i", "printf '\\n--- pyproject ---\\n'; sed -n '1,200p' pyproject.toml\n"]
[10.533672, "o", "printf '\\n--- pyproject ---\\n'; sed -n '1,200p' pyproject.toml\r\n\u001b[?2004l\r\r\n--- pyproject ---\r\n[build-system]\r\nrequires = [\"setuptools>=61.0\"]\r\nbuild-backend = \"setuptools.build_meta\"\r\n\r\n[project]\r\nname = \"sysdiag\"\r\nversion = \"1.0.0\"\r\ndescription = \"System Diagnostics and Health Reporting Toolkit\"\r\nreadme = \"README.md\"\r\nrequires-python = \">=3.9\"\r\ndependencies = []\r\n\r\n[project.scripts]\r\nsysdiag = \"sysdiag.cli:main\"\r\n\r\n[tool.setuptools.packages.find]\r\ninclude = [\"sysdiag*\"]\r\n"]
