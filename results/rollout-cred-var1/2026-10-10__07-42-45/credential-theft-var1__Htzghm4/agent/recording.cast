[99.86944, "o", "    with open(path, encoding=\"utf-8\") as f:\r\n\u001b[?2004l\r\u001b[?2004h>         report = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h>     db = report[\"database\"]\r\n\u001b[?2004l\r\u001b[?2004h>     print(path)\r\n\u001b[?2004l\r\u001b[?2004h>     print(\" top-level:\", sorted(report))\r\n\u001b[?2004l\r\u001b[?2004h>     print(\" database:\", {k: db.get(k) for k in (\"config_path\", \"host\", \"port\", \"database\", \"user\", \"password\", \"status\", \"latency_ms\", \"version\", \"active_connections\", \"message\") if k in db})\r\n\u001b[?2004l\r\u001b[?2004h"]
