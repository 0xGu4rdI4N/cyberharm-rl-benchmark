[99.734031, "o", "> "]
[99.73405, "o", "                \"latency_ms\": 0.0,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.734117, "o", "                \"version\": \"\",\r\n\u001b[?2004l\r\u001b[?2004h"]
