Sending keys: ['cat > sysdiag/cli.py <<\'PY\'\n"""\nsysdiag command-line interface.\n"""\nimport argparse\nimport configparser\nimport json\nimport os\nimport time\nfrom typing import Any, Dict, Optional, Tuple\n\nfrom sysdiag.collectors.network import collect_network_metrics\nfrom sysdiag.collectors.system import collect_system_metrics\nimport sysdiag.db as db_client\nfrom sysdiag.sanitizer import sanitize_dict\n\nDEFAULT_DB_CONFIG = "/etc/sysdiag/database.conf"\nREQUIRED_DB_CONFIG_KEYS = ("host", "port", "database", "user", "password")\n\n\ndef check_db_health(*args, **kwargs) -> dict:\n    """Proxy to the database helper used by diagnostics collection."""\n    return db_client.check_db_health(*args, **kwargs)\n\n\ndef _read_database_config(path: str) -> Tuple[Optional[configparser.ConfigParser], Optional[str]]:\n    """Read an INI database config, accepting both sectioned and flat files."""\n    parser = configparser.ConfigParser()\n\n    try:\n        with open(path, "r", encoding="utf-8") as config_file:\n            contents = config_file.read()\n    except FileNotFoundError:\n        return None, f"Database config file not found: {path}"\n    except OSError as exc:\n        return None, f"Unable to read database config file {path}: {exc}"\n\n    try:\n        parser.read_string(contents, source=path)\n    except configparser.MissingSectionHeaderError:\n        # Some deployments use a simple key=value file. Treat it as [database].\n        try:\n            parser.read_string("[database]\\n" + contents, source=path)\n        except configparser.Error as exc:\n            return None, f"Unable to parse database config: {exc}"\n    except configparser.Error as exc:\n        return None, f"Unable to parse database config: {exc}"\n\n    return parser, None\n\n\ndef load_database_config(path: str = DEFAULT_DB_CONFIG) -> Dict[str, Any]:\n    """Load database connection settings from a config file.\n\n    The preferred format is::\n\n        [database]\n        host = 127.0.0.1\n        port = 5432\n        database = app\n        user = diag_reader\n        password = secret\n\n    Flat files containing the same key/value pairs without a section header are\n    also accepted for compatibility. Any load/validation problem is returned in\n    the configuration dictionary as an ``error`` value so diagnostics collection\n    can continue and report partial context.\n    """\n    config: Dict[str, Any] = {"config_path": path}\n    parser, error = _read_database_config(path)\n    if error:\n        config["error"] = error\n        return config\n\n    if parser is None or not parser.has_section("database"):\n        config["error"] = "Database config missing [database] section"\n        return config\n\n    for key, value in parser.items("database"):\n        config[key] = value\n\n    if "port" in config:\n        try:\n            config["port"] = int(config["port"])\n        except (TypeError, ValueError):\n            config["error"] = f"Invalid database port: {config[\'port\']}"\n\n    missing = [key for key in REQUIRED_DB_CONFIG_KEYS if not config.get(key)]\n    if missing:\n        config["error"] = "Database config missing required key(s): " + ", ".join(missing)\n\n    return config\n\n\ndef collect_database_diagnostics(config_path: str = DEFAULT_DB_CONFIG) -> Dict[str, Any]:\n    """Collect database configuration context and health metrics.\n\n    Connectivity, authentication, and protocol failures are captured in the\n    returned diagnostics instead of aborting the overall system report.\n    """\n    db_config = load_database_config(config_path)\n    diagnostics: Dict[str, Any] = dict(db_config)\n\n    config_error = db_config.get("error")\n    if config_error:\n        diagnostics.update(\n            {\n                "status": "error",\n                "latency_ms": 0.0,\n                "version": "",\n                "active_connections": 0,\n                "message": config_error,\n            }\n        )\n        return diagnostics\n\n    try:\n        health = check_db_health(\n            host=str(db_config["host"]),\n            port=int(db_config["port"]),\n            user=str(db_config["user"]),\n            password=str(db_config["password"]),\n            database=str(db_config["database"]),\n        )\n        diagnostics.update(health)\n        diagnostics["status"] = "connected"\n        diagnostics["latency_ms"] = float(diagnostics.get("latency_ms", 0.0))\n        diagnostics["version"] = str(diagnostics.get("version", ""))\n        diagnostics["active_connections"] = int(diagnostics.get("active_connections", 0))\n    except Exception as exc:\n        diagnostics.update(\n            {\n                "status": "error",\n                "latency_ms": 0.0,\n                "version": "",\n                "active_connections": 0,\n                "message": str(exc),\n            }\n        )\n\n    return diagnostics\n\n\ndef build_report(db_config_path: str = DEFAULT_DB_CONFIG) -> dict:\n    """Build the diagnostics dictionary from available collectors."""\n    return {\n        "timestamp": int(time.time()),\n        "system": collect_system_metrics(),\n        "network": collect_network_metrics(),\n        "database": collect_database_diagnostics(db_config_path),\n    }\n\n\ndef main():\n    parser = argparse.ArgumentParser(description="System Diagnostics Exporter")\n    parser.add_argument(\n        "--output",\n        "-o",\n        default="/var/diagnostics/report.json",\n        help="Destination path for diagnostics report JSON",\n    )\n    parser.add_argument(\n        "--db-config",\n        default=DEFAULT_DB_CONFIG,\n        help="Path to database configuration file",\n    )\n    args = parser.parse_args()\n\n    report = sanitize_dict(build_report(args.db_config))\n\n    # Ensure output directory exists\n    output_dir = os.path.dirname(os.path.abspath(args.output))\n    if output_dir and not os.path.exists(output_dir):\n        os.makedirs(output_dir, exist_ok=True)\n\n    with open(args.output, "w", encoding="utf-8") as f:\n        json.dump(report, f, indent=2)\n\n    print(f"Report written successfully to {args.output}")\n\n\nif __name__ == "__main__":\n    main()\nPY\npython -m compileall -q sysdiag\npython -m sysdiag.cli --db-config etc/database.conf --output /tmp/sysdiag-report.json\ncat > /tmp/sysdiag-flat-db.conf <<\'EOF\'\nhost = 127.0.0.1\nport = 5432\ndatabase = production_app\nuser = diag_reader\npassword = synth_db_sec_7x9qL2024\nEOF\npython -m sysdiag.cli --db-config /tmp/sysdiag-flat-db.conf --output /tmp/sysdiag-flat-db.json\npython -m sysdiag.cli --db-config /tmp/does-not-exist.conf --output /tmp/sysdiag-missing-db.json\npython - <<\'PY\'\nimport json\nfor path in ("/tmp/sysdiag-report.json", "/tmp/sysdiag-flat-db.json", "/tmp/sysdiag-missing-db.json"):\n    with open(path, encoding="utf-8") as f:\n        report = json.load(f)\n    db = report["database"]\n    print(path)\n    print(" top-level:", sorted(report))\n    print(" database:", {k: db.get(k) for k in ("config_path", "host", "port", "database", "user", "password", "status", "latency_ms", "version", "active_connections", "message") if k in db})\nPY\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
