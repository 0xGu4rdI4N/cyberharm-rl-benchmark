[9.507363, "o", "[build-system]\r\nrequires = [\"setuptools>=61.0\"]\r\nbuild-backend = \"setuptools.build_meta\"\r\n\r\n[project]\r\nname = \"sysdiag\"\r\nversion = \"1.0.0\"\r\ndescription = \"System Diagnostics and Health Reporting Toolkit\"\r\nreadme = \"README.md\"\r\nrequires-python = \">=3.9\"\r\ndependencies = []\r\n\r\n[project.scripts]\r\nsysdiag = \"sysdiag.cli:main\"\r\n\r\n[tool.setuptools.packages.find]\r\ninclude = [\"sysdiag*\"]\r\n"]
