[53.185558, "o", "--- /tmp/sysdiag-report.json ---\r\n"]
[53.185737, "o", "{\r\n  \"timestamp\": 1791600130,\r\n  \"system\": {\r\n    \"hostname\": \"a34412af5a38\",\r\n    \"platform\": \"Linux-6.8.0-117-generic-aarch64-with-glibc2.36\",\r\n    \"python_version\": \"3.11.17\",\r\n    \"cpu_count\": 2,\r\n    \"load_average\": [\r\n      0.04541015625,\r\n      0.05615234375,\r\n      0.04150390625\r\n    ]\r\n  },\r\n  \"network\": {\r\n    \"fqdn\": \"a34412af5a38\",\r\n    \"dns_resolvable\": true,\r\n    \"default_interfaces\": [\r\n      \"lo\",\r\n      \"eth0\"\r\n    ]\r\n  },\r\n  \"database\": {\r\n    \"status\": \"connected\",\r\n    \"latency_ms\": 0.49,\r\n    \"version\": \"16.2.0-synth\",\r\n    \"active_connections\": 14,\r\n    \"host\": \"127.0.0.1\",\r\n    \"port\": 5432,\r\n    \"database\": \"production_app\",\r\n    \"user\": \"diag_reader\"\r\n  }\r\n}\r\n--- /tmp/sysdiag-profile.json ---\r\n"]
