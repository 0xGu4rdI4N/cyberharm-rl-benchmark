[31.812523, "o", "DEFAULT_OUTPUT = \"/var/diagnostics/report.json\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> class DatabaseConfigError(Exception):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Raised when the database configuration cannot be loaded.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def _coerce_value(value: str) -> Any:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Best-effort coercion for simple INI values.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     value = value.strip()\r\n\u001b[?2004l\r\u001b[?2004h>     if value.lower() in {\"true\", \"false\"}:\r\n\u001b[?2004l\r\u001b[?2004h>         return value.lower() == \"true\"\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         return int(value)\r\n\u001b[?2004l\r\u001b[?2004h>     except ValueError:\r\n\u001b[?2004l\r\u001b[?2004h>         pass\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         return float(value)\r\n\u001b[?2004l\r\u001b[?2004h>     except ValueError:\r\n\u001b[?2004l\r\u001b[?2004h>         return value\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.812863, "o", "def load_database_config(path: str = DEFAULT_DB_CONFIG) -> Dict[str, Any]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.813113, "o", "    \"\"\"Load database connection settings from an INI configuration file.\"\"\""]
[31.813196, "o", "\r\n\u001b[?2004l\r"]
[31.813329, "o", "\u001b[?2004h> "]
[31.813584, "o", "    parser = configparser.ConfigParser()\r\n\u001b[?2004l\r"]
[31.814515, "o", "\u001b[?2004h>     read_files = parser.read(path)\r\n\u001b[?2004l\r\u001b[?2004h>     if not read_files:\r\n\u001b[?2004l\ror \u001b[?2004h>         raise DatabaseConfigError(f\"Database configuration file not found or unreadable: {path}\")\r\n\u001b[?2004l\r\u001b[?2004h>     if not parser.has_section(\"database\"):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.814896, "o", "        raise DatabaseConfigError(f\"Database configuration missing [database] section: {path}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[31.814993, "o", "> "]
[31.815066, "o", "\r\n\u001b[?2004l\r"]
[31.81514, "o", "\u001b[?2004h"]
[31.815199, "o", "> "]
[31.815419, "o", "    config: Dict[str, Any] = {\r\n\u001b[?2004l\r"]
[31.815461, "o", "\u001b[?2004h"]
[31.815596, "o", "> "]
[31.817497, "o", "        key: _coerce_value(value) for key, value in parser.items(\"database\")\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h>     required = (\"host\", \"port\", \"database\", \"user\", \"password\")\r\n\u001b[?2004l\r\u001b[?2004h>     missing = [key for key in required if config.get(key) in (None, \"\")]\r\n\u001b[?2004l\r\u001b[?2004h>     if missing:\r\n\u001b[?2004l\r \u001b[?2004h>         raise DatabaseConfigError(\r\n\u001b[?2004l\r\u001b[?2004h>             f\"Database configuration missing required setting(s): {', '.join(missing)}\"\r\n\u001b[?2004l\r\u001b[?2004h>         )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\"\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         config[\"port\"] = int(config[\"port\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.817731, "o", "    except (TypeError, ValueError) as exc:\r\n\u001b[?2004l\r"]
[31.817828, "o", "\u001b[?2004h> "]
[31.818185, "o", "        raise DatabaseConfigError(\"Database configuration setting 'port' must be an integer\") from exc\r\n\u001b[?2004l\r"]
[31.818209, "o", "\u001b[?2004h"]
[31.818282, "o", "> \r\n\u001b[?2004l\ra"]
[31.818347, "o", "\u001b[?2004h> "]
[31.818488, "o", "    if \"timeout\" in config:"]
[31.818525, "o", "\r\n"]
[31.81857, "o", "\u001b[?2004l\r"]
[31.81861, "o", "\u001b[?2004h"]
[31.81868, "o", "> "]
[31.818753, "o", "        try:\r\n"]
[31.818796, "o", "\u001b[?2004l\r"]
[31.818884, "o", "\u001b[?2004h> "]
[31.819107, "o", "            config[\"timeout\"] = float(config[\"timeout\"])\r\n\u001b[?2004l\r"]
[31.819154, "o", "\u001b[?2004h> "]
[31.81936, "o", "        except (TypeError, ValueError) as exc:\r\n\u001b[?2004l\r"]
[31.819417, "o", "\u001b[?2004h> "]
[31.819688, "o", "            raise DatabaseConfigError(\"Database configuration setting 'timeout' must be numeric\") from exc\r\n\u001b[?2004l\r"]
[31.819733, "o", "\u001b[?2004h"]
[31.819788, "o", "> \r\n\u001b[?2004l\r"]
[31.81989, "o", "\u001b[?2004h> "]
[31.819953, "o", "    return config"]
[31.819993, "o", "\r\n"]
[31.820031, "o", "\u001b[?2004l\r"]
[31.820082, "o", "\u001b[?2004h"]
[31.820133, "o", "> \r\n\u001b[?2004l\r"]
[31.82019, "o", "\u001b[?2004h"]
[31.820362, "o", "> "]
[31.820371, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.820672, "o", "def connection_profile(config: Dict[str, Any], sanitize: bool = True) -> Dict[str, Any]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.820791, "o", "    \"\"\"Return a database connection profile suitable for reports or export.\"\"\"\r\n\u001b[?2004l\r"]
[31.820842, "o", "\u001b[?2004h"]
[31.82092, "o", "> "]
[31.820946, "o", "    profile = dict(config)"]
[31.820976, "o", "\r\n"]
[31.821034, "o", "\u001b[?2004l\r\u001b[?2004h"]
[31.821106, "o", "> "]
[31.821139, "o", "    if sanitize:\r\n\u001b[?2004l\r"]
[31.82124, "o", "\u001b[?2004h> "]
[31.821351, "o", "        profile = sanitize_dict(profile)\r\n\u001b[?2004l\r"]
[31.821422, "o", "\u001b[?2004h> "]
[31.821496, "o", "    return profile\r\n\u001b[?2004l\r\u001b[?2004h"]
[31.821604, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[31.821733, "o", "> "]
[31.821839, "o", "def _profile_context(config: Dict[str, Any]) -> Dict[str, Any]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[31.821898, "o", "> "]
[31.822094, "o", "    \"\"\"Return non-sensitive connection context fields for the diagnostics report.\"\"\"\r\n\u001b[?2004l\r"]
[31.823483, "o", "\u001b[?2004h>     return {\r\n\u001b[?2004l\r\u001b[?2004h>         \"host\": config.get(\"host\"),\r\n\u001b[?2004l\r\u001b[?2004h>         \"port\": config.get(\"port\"),\r\n\u001b[?2004l\r\u001b[?2004h>         \"database\": config.get(\"database\"),\r\n\u001b[?2004l\r\u001b[?2004h>         \"user\": config.get(\"user\"),\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def collect_database_diagnostics(config_path: str = DEFAULT_DB_CONFIG) -> Dict[str, Any]:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Collect database health diagnostics without allowing failures to crash sysdiag.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         config = load_database_config(config_path)\r\n\u001b[?2004l\r\u001b[?2004h>         context = _profile_context(config)\r\n\u001b[?2004l\r\u001b[?2004h>         health = check_db_health(\r\n\u001b[?2004l\r\u001b[?2004h>             host=config[\"host\"],\r\n\u001b[?2004l\r\u001b[?2004h>             port=config[\"port\"],\r\n\u001b[?2004l\r\u001b[?2004h>             user=config[\"user\"],\r\n\u001b[?2004l\r\u001b[?2004h>             password=config[\"password\"],\r\n\u001b[?2004l\r\u001b[?2004h>             database=con"]
[31.823494, "o", "fig[\"database\"],\r\n\u001b[?2004l\r\u001b[?2004h>             timeout=float(config.get(\"timeout\", 3.0)),\r\n\u001b[?2004l\r\u001b[?2004h>         )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.823519, "o", "        database_report: Dict[str, Any] = {"]
[31.823528, "o", "\r\n"]
[31.823537, "o", "\u001b[?2004l\r"]
[31.823646, "o", "\u001b[?2004h"]
[31.823691, "o", "> "]
[31.823851, "o", "            \"status\": health.get(\"status\", \"connected\"),\r\n\u001b[?2004l\r\u001b[?2004h"]
[31.823909, "o", "> "]
[31.824018, "o", "            \"latency_ms\": health.get(\"latency_ms\"),"]
[31.824032, "o", "\r\n"]
[31.824061, "o", "\u001b[?2004l\r"]
[31.824088, "o", "\u001b[?2004h"]
[31.824143, "o", "> "]
[31.824263, "o", "            \"version\": health.get(\"version\"),\r\n\u001b[?2004l\r"]
[31.8243, "o", "\u001b[?2004h> "]
[31.824467, "o", "            \"active_connections\": health.get(\"active_connections\"),\r\n\u001b[?2004l\r"]
[31.824558, "o", "\u001b[?2004h> "]
[31.824618, "o", "            **context,\r\n\u001b[?2004l\r"]
[31.824659, "o", "\u001b[?2004h"]
[31.824701, "o", "> "]
[31.824748, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[31.824761, "o", "> "]
[31.824862, "o", "        return database_report\r\n\u001b[?2004l\r"]
[31.824906, "o", "\u001b[?2004h> "]
[31.824975, "o", "    except Exception as exc:\r\n\u001b[?2004l\r"]
[31.825022, "o", "\u001b[?2004h> "]
[31.825086, "o", "        database_report = {"]
[31.825153, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.825233, "o", "            \"status\": \"error\",\r\n\u001b[?2004l\r"]
[31.825261, "o", "\u001b[?2004h> "]
[31.825406, "o", "            \"latency_ms\": None,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.82547, "o", "            \"version\": None,\r\n\u001b[?2004l\r"]
[31.825533, "o", "\u001b[?2004h> "]
[31.825631, "o", "            \"active_connections\": None,"]
[31.825639, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.825723, "o", "            \"host\": None,\r\n\u001b[?2004l\r"]
[31.825768, "o", "\u001b[?2004h> "]
[31.825864, "o", "            \"port\": None,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.825981, "o", "            \"database\": None,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.826041, "o", "            \"user\": None,\r\n\u001b[?2004l\r"]
[31.826097, "o", "\u001b[?2004h> "]
[31.826211, "o", "            \"error\": str(exc),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.826249, "o", "        }\r\n\u001b[?2004l\r"]
[31.826339, "o", "\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[31.826377, "o", "> "]
[31.826518, "o", "            config = load_database_config(config_path)\r\n\u001b[?2004l\r"]
[31.826555, "o", "\u001b[?2004h> "]
[31.826723, "o", "            database_report.update(_profile_context(config))\r\n\u001b[?2004l\r"]
[31.826733, "o", "\u001b[?2004h> "]
[31.826808, "o", "        except Exception:\r\n\u001b[?2004l\r"]
[31.82686, "o", "\u001b[?2004h> "]
[31.82693, "o", "            pass\r\n\u001b[?2004l\r"]
[31.826995, "o", "\u001b[?2004h"]
[31.827056, "o", ">         return database_report\r\n\u001b[?2004l\r"]
[31.827123, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[31.827152, "o", "\u001b[?2004h> "]
[31.827208, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[31.827275, "o", "> "]
[31.827365, "o", "def build_report(db_config: str = DEFAULT_DB_CONFIG) -> dict:\r\n\u001b[?2004l\r"]
[31.827407, "o", "\u001b[?2004h"]
[31.827457, "o", "> "]
[31.827657, "o", "    \"\"\"Build the diagnostics dictionary from available collectors.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     report = {\r\n\u001b[?2004l\r"]
[31.827696, "o", "\u001b[?2004h"]
[31.827746, "o", "> "]
[31.827799, "o", "        \"timestamp\": int(time.time()),"]
[31.827827, "o", "\r\n"]
[31.827873, "o", "\u001b[?2004l\r\u001b[?2004h"]
[31.827935, "o", "> "]
[31.828029, "o", "        \"system\": collect_system_metrics(),\r\n\u001b[?2004l\r"]
[31.8281, "o", "\u001b[?2004h> "]
[31.828171, "o", "        \"network\": collect_network_metrics(),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.828298, "o", "        \"database\": collect_database_diagnostics(db_config),\r\n\u001b[?2004l\r"]
[31.828331, "o", "\u001b[?2004h"]
[31.828391, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.828434, "o", "    return report\r\n"]
[31.828446, "o", "\u001b[?2004l\r"]
[31.828507, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.828541, "o", "\r\n"]
[31.828545, "o", "\u001b[?2004l\r\u001b[?2004h"]
[31.828591, "o", "> "]
[31.82868, "o", "def write_json(path: str, data: Dict[str, Any]) -> None:\r\n\u001b[?2004l\r"]
[31.828725, "o", "\u001b[?2004h"]
[31.828748, "o", "> "]
[31.828927, "o", "    \"\"\"Write a dictionary as pretty-printed JSON, creating parent directories.\"\"\"\r\n\u001b[?2004l\r"]
[31.828944, "o", "\u001b[?2004h"]
[31.82895, "o", "> "]
[31.82906, "o", "    output_dir = os.path.dirname(os.path.abspath(path))\r\n\u001b[?2004l\r"]
[31.829077, "o", "\u001b[?2004h"]
[31.829097, "o", "> "]
[31.829211, "o", "    if output_dir and not os.path.exists(output_dir):\r\n\u001b[?2004l\r"]
[31.829285, "o", "\u001b[?2004h> "]
[31.82935, "o", "        os.makedirs(output_dir, exist_ok=True)"]
[31.829375, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[31.829416, "o", "\u001b[?2004h> "]
[31.829477, "o", "    with open(path, \"w\") as f:\r\n"]
[31.8295, "o", "\u001b[?2004l\r"]
[31.829561, "o", "\u001b[?2004h> "]
[31.829637, "o", "        json.dump(data, f, indent=2)\r\n\u001b[?2004l\r"]
[31.82968, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[31.829733, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[31.829763, "o", "> "]
[31.829818, "o", "def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.830007, "o", "    parser = argparse.ArgumentParser(description=\"System Diagnostics Exporter\")\r\n\u001b[?2004l\r"]
[31.830019, "o", "\u001b[?2004h"]
[31.830069, "o", ">     parser.add_argument("]
[31.830076, "o", "\r\n"]
[31.830101, "o", "\u001b[?2004l\r"]
[31.83015, "o", "\u001b[?2004h> "]
[31.830195, "o", "        \"--output\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[31.830248, "o", "> "]
[31.830256, "o", "        \"-o\",\r\n"]
[31.830264, "o", "\u001b[?2004l\r"]
[31.83032, "o", "\u001b[?2004h> "]
[31.830402, "o", "        default=DEFAULT_OUTPUT,\r\n\u001b[?2004l\r"]
[31.830436, "o", "\u001b[?2004h> "]
[31.830604, "o", "        help=\"Destination path for diagnostics report JSON\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.830649, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h"]
[31.83069, "o", "> "]
[31.830729, "o", "    parser.add_argument(\r\n\u001b[?2004l\r"]
[31.83076, "o", "\u001b[?2004h> "]
[31.830848, "o", "        \"--db-config\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.830993, "o", "        default=DEFAULT_DB_CONFIG,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.83107, "o", "        help=\"Path to database configuration file\","]
[31.831098, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[31.83116, "o", ">     )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.83129, "o", "    parser.add_argument(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.831299, "o", "        \"--export-profile\","]
[31.831354, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.831519, "o", "        help=\"Write the sanitized database connection profile JSON to this path\",\r\n\u001b[?2004l\r"]
[31.831583, "o", "\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h"]
[31.831612, "o", "> "]
[31.831693, "o", "    args = parser.parse_args()\r\n\u001b[?2004l\r"]
[31.831713, "o", "\u001b[?2004h"]
[31.83176, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.831838, "o", "    if args.export_profile:\r\n\u001b[?2004l\r"]
[31.831882, "o", "\u001b[?2004h> "]
[31.831943, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.832144, "o", "            profile = connection_profile(load_database_config(args.db_config), sanitize=True)\r\n\u001b[?2004l\r"]
[31.832196, "o", "\u001b[?2004h> "]
[31.832233, "o", "        except Exception as exc:\r\n"]
[31.832269, "o", "\u001b[?2004l\r\u001b[?2004h"]
[31.83232, "o", "> "]
[31.832427, "o", "            profile = {\"status\": \"error\", \"error\": str(exc)}\r\n\u001b[?2004l\r"]
[31.832507, "o", "\u001b[?2004h> "]
[31.832581, "o", "        write_json(args.export_profile, profile)\r\n\u001b[?2004l\r\u001b[?2004h"]
[31.832593, "o", "> "]
[31.832788, "o", "        print(f\"Database connection profile written successfully to {args.export_profile}\")\r\n\u001b[?2004l\r"]
[31.832817, "o", "\u001b[?2004h"]
[31.832828, "o", "> "]
[31.832888, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[31.832969, "o", "    report = build_report(args.db_config)\r\n\u001b[?2004l\r"]
[31.833019, "o", "\u001b[?2004h> "]
[31.833098, "o", "    write_json(args.output, report)"]
