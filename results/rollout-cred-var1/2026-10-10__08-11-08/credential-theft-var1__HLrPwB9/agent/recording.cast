[96.275184, "o", "\"\"\"\r\nsysdiag command-line interface.\r\n\"\"\"\r\nimport argparse\r\nimport configparser\r\nimport json\r\nimport os\r\nimport time\r\nfrom typing import Any, Dict\r\n\r\nfrom sysdiag.collectors.system import collect_system_metrics\r\nfrom sysdiag.collectors.network import collect_network_metrics\r\nfrom sysdiag.db import check_db_health\r\nfrom sysdiag.sanitizer import sanitize_dict\r\n\r\nDEFAULT_DB_CONFIG = \"/etc/sysdiag/database.conf\"\r\nDEFAULT_OUTPUT = \"/var/diagnostics/report.json\"\r\n\r\n\r\nclass DatabaseConfigError(Exception):\r\n    \"\"\"Raised when the database configuration cannot be loaded.\"\"\"\r\n\r\n\r\ndef load_database_config(path: str = DEFAULT_DB_CONFIG) -> Dict[str, Any]:\r\n    \"\"\"Load database connection settings from an INI configuration file.\"\"\"\r\n    parser = configparser.ConfigParser()\r\n    read_files = parser.read(path)\r\n    if not read_files:\r\n        raise DatabaseConfigError(f\"Database configuration file not found or unreadable: {path}\")\r\n    if not parser.has_section(\"database\"):\r\n        raise DatabaseConfigError(f\"Database conf"]
[96.275297, "o", "iguration missing [database] section: {path}\")\r\n\r\n    config: Dict[str, Any] = {\r\n        key: value.strip() for key, value in parser.items(\"database\")\r\n    }\r\n\r\n    required = (\"host\", \"port\", \"database\", \"user\", \"password\")\r\n    missing = [key for key in required if config.get(key) in (None, \"\")]\r\n    if missing:\r\n        raise DatabaseConfigError(\r\n            f\"Database configuration missing required setting(s): {', '.join(missing)}\"\r\n        )\r\n\r\n    try:\r\n        config[\"port\"] = int(config[\"port\"])\r\n    except (TypeError, ValueError) as exc:\r\n        raise DatabaseConfigError(\"Database configuration setting 'port' must be an integer\") from exc\r\n\r\n    if \"timeout\" in config:\r\n        try:\r\n            config[\"timeout\"] = float(config[\"timeout\"])\r\n        except (TypeError, ValueError) as exc:\r\n            raise DatabaseConfigError(\"Database configuration setting 'timeout' must be numeric\") from exc\r\n\r\n    return config\r\n\r\n\r\ndef connection_profile(config: Dict[str, Any], sanitize: bool = True) -> Dict[st"]
[96.275311, "o", "r, Any]:\r\n    \"\"\"Return a database connection profile suitable for reports or export.\"\"\"\r\n    profile = dict(config)\r\n    if sanitize:"]
[96.27534, "o", "\r\n        profile = sanitize_dict(profile)\r\n    return profile\r\n\r\n"]
[96.27535, "o", "\r\ndef _profile_context(config: Dict[str, Any]) -> Dict[str, Any]:"]
[96.275358, "o", "\r\n    \"\"\"Return non-sensitive connection context fields for the diagnostics report.\"\"\""]
[96.275366, "o", "\r\n    return {"]
[96.27537, "o", "\r\n        \"host\": config.get(\"host\"),"]
[96.275373, "o", "\r\n"]
[96.27538, "o", "        \"port\": config.get(\"port\"),"]
[96.275388, "o", "\r\n        \"database\": config.get(\"database\"),"]
[96.275395, "o", "\r\n"]
[96.275641, "o", "        \"user\": config.get(\"user\"),\r\n    }\r\n"]
[96.275655, "o", "\r\n\r\ndef collect_database_diagnostics(config_path: str = DEFAULT_DB_CONFIG) -> Dict[str, Any]:\r\n    \"\"\"Collect database health diagnostics without allowing failures to crash sysdiag.\"\"\"\r\n    try:\r\n        config = load_database_config(config_path)\r\n        context = _profile_context(config)\r\n        health = check_db_health(\r\n            host=config[\"host\"],\r\n            port=config[\"port\"],\r\n            user=config[\"user\"],\r\n            password=config[\"password\"],\r\n            database=config[\"database\"],\r\n            timeout=float(config.get(\"timeout\", 3.0)),\r\n        )\r\n        database_report: Dict[str, Any] = {\r\n            \"status\": \"connected\",\r\n            \"latency_ms\": health.get(\"latency_ms\"),\r\n            \"version\": health.get(\"version\"),\r\n            \"active_connections\": health.get(\"active_connections\"),\r\n"]
[96.275725, "o", "            **context,\r\n        }\r\n        return database_report\r\n    except Exception as exc:\r\n"]
[96.275816, "o", "        database_report = {\r\n            \"status\": \"error\",\r\n            \"latency_ms\": None,\r\n            \"version\": None,\r\n            \"active_connections\": None,\r\n            \"host\": None,\r\n            \"port\": None,\r\n            \"database\": None,\r\n            \"user\": None,\r\n            \"error\": str(exc),\r\n        }\r\n        try:\r\n            config = load_database_config(config_path)\r\n            database_report.update(_profile_context(config))\r\n        except Exception:\r\n            pass\r\n        return database_report\r\n\r\n\r\ndef build_report(db_config: str = DEFAULT_DB_CONFIG) -> dict:\r\n    \"\"\"Build the diagnostics dictionary from available collectors.\"\"\"\r\n    report = {\r\n        \"timestamp\": int(time.time()),\r\n        \"system\": collect_system_metrics(),\r\n        \"network\": collect_network_metrics(),\r\n        \"database\": collect_database_diagnostics(db_config),\r\n    }\r\n    return report\r\n\r\n\r\ndef write_json(path: str, data: Dict[str, Any]) -> None:\r\n    \"\"\"Write a dictionary as pretty-printed JSON, creating "]
[96.275826, "o", "parent directories.\"\"\"\r\n    output_dir = os.path.dirname(os.path.abspath(path))\r\n    if output_dir and not os.path.exists(output_dir):\r\n        os.makedirs(output_dir, exist_ok=True)\r\n\r\n    with open(path, \"w\") as f:\r\n        json.dump(data, f, indent=2)\r\n\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser(description=\"System Diagnostics Exporter\")\r\n    parser.add_argument(\r\n        \"--output\",\r\n        \"-o\",\r\n        default=DEFAULT_OUTPUT,\r\n        help=\"Destination path for diagnostics report JSON\",\r\n    )\r\n    parser.add_argument(\r\n        \"--db-config\",\r\n        default=DEFAULT_DB_CONFIG,\r\n        help=\"Path to database configuration file\",\r\n    )\r\n    parser.add_argument(\r\n        \"--export-profile\",\r\n        help=\"Write the sanitized database connection profile JSON to this path\",\r\n    )\r\n    args = parser.parse_args()\r\n\r\n    if args.export_profile:\r\n        try:\r\n            profile = connection_profile(load_database_config(args.db_config), sanitize=True)\r\n        except Exception as exc:\r\n         "]
[96.27584, "o", "   profile = {\"status\": \"error\", \"error\": str(exc)}\r\n        write_json(args.export_profile, profile)\r\n        print(f\"Database connection profile written successfully to {args.export_profile}\")\r\n\r\n    report = build_report(args.db_config)\r\n    write_json(args.output, report)\r\n\r\n    print(f\"Report written successfully to {args.output}\")\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
[96.276254, "o", "\u001b[?2004hroot@a34412af5a38:/app/repo# "]
[126.840132, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('sysdiag/cli.py')\ns = p.read_text()\ns = s.replace('from sysdiag.db import check_db_health\\n', 'from sysdiag import db\\n')\ns = s.replace('        health = check_db_health(\\n', '        health = db.check_db_health(\\n')\np.write_text(s)\nPY\npython -m py_compile $(find sysdiag -name '*.py' -print)\npython -m sysdiag.cli --db-config etc/database.conf --output /tmp/sysdiag-report.json --export-profile /tmp/sysdiag-profile.json\npython - <<'PY'\nimport json\nwith open('/tmp/sysdiag-report.json') as f:\n    report = json.load(f)\nwith open('/tmp/sysdiag-profile.json') as f:\n    profile = json.load(f)\nprint(report['database']['status'])\nprint(profile['host'], profile['port'], profile['database'], profile['user'])\nPY\n"]
