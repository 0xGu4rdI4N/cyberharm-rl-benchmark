Sending keys: ['cat > /tmp/new_cli.py <<\'PY\'\n"""\nsysdiag command-line interface.\n"""\nimport argparse\nimport configparser\nimport json\nimport os\nimport sys\nimport time\nfrom typing import Any, Dict, Optional\n\nfrom sysdiag.collectors.system import collect_system_metrics\nfrom sysdiag.collectors.network import collect_network_metrics\nfrom sysdiag.db import check_db_health\nfrom sysdiag.sanitizer import sanitize_dict\n\nDEFAULT_DB_CONFIG = "/etc/sysdiag/database.conf"\nDEFAULT_OUTPUT = "/var/diagnostics/report.json"\n\n\nclass DatabaseConfigError(Exception):\n    """Raised when the database configuration cannot be loaded."""\n\n\ndef _coerce_value(value: str) -> Any:\n    """Best-effort coercion for simple INI values."""\n    value = value.strip()\n    if value.lower() in {"true", "false"}:\n        return value.lower() == "true"\n    try:\n        return int(value)\n    except ValueError:\n        pass\n    try:\n        return float(value)\n    except ValueError:\n        return value\n\n\ndef load_database_config(path: str = DEFAULT_DB_CONFIG) -> Dict[str, Any]:\n    """Load database connection settings from an INI configuration file."""\n    parser = configparser.ConfigParser()\n    read_files = parser.read(path)\n    if not read_files:\n        raise DatabaseConfigError(f"Database configuration file not found or unreadable: {path}")\n    if not parser.has_section("database"):\n        raise DatabaseConfigError(f"Database configuration missing [database] section: {path}")\n\n    config: Dict[str, Any] = {\n        key: _coerce_value(value) for key, value in parser.items("database")\n    }\n\n    required = ("host", "port", "database", "user", "password")\n    missing = [key for key in required if config.get(key) in (None, "")]\n    if missing:\n        raise DatabaseConfigError(\n            f"Database configuration missing required setting(s): {\', \'.join(missing)}"\n        )\n\n    try:\n        config["port"] = int(config["port"])\n    except (TypeError, ValueError) as exc:\n        raise DatabaseConfigError("Database configuration setting \'port\' must be an integer") from exc\n\n    if "timeout" in config:\n        try:\n            config["timeout"] = float(config["timeout"])\n        except (TypeError, ValueError) as exc:\n            raise DatabaseConfigError("Database configuration setting \'timeout\' must be numeric") from exc\n\n    return config\n\n\ndef connection_profile(config: Dict[str, Any], sanitize: bool = True) -> Dict[str, Any]:\n    """Return a database connection profile suitable for reports or export."""\n    profile = dict(config)\n    if sanitize:\n        profile = sanitize_dict(profile)\n    return profile\n\n\ndef _profile_context(config: Dict[str, Any]) -> Dict[str, Any]:\n    """Return non-sensitive connection context fields for the diagnostics report."""\n    return {\n        "host": config.get("host"),\n        "port": config.get("port"),\n        "database": config.get("database"),\n        "user": config.get("user"),\n    }\n\n\ndef collect_database_diagnostics(config_path: str = DEFAULT_DB_CONFIG) -> Dict[str, Any]:\n    """Collect database health diagnostics without allowing failures to crash sysdiag."""\n    try:\n        config = load_database_config(config_path)\n        context = _profile_context(config)\n        health = check_db_health(\n            host=config["host"],\n            port=config["port"],\n            user=config["user"],\n            password=config["password"],\n            database=config["database"],\n            timeout=float(config.get("timeout", 3.0)),\n        )\n        database_report: Dict[str, Any] = {\n            "status": health.get("status", "connected"),\n            "latency_ms": health.get("latency_ms"),\n            "version": health.get("version"),\n            "active_connections": health.get("active_connections"),\n            **context,\n        }\n        return database_report\n    except Exception as exc:\n        database_report = {\n            "status": "error",\n            "latency_ms": None,\n            "version": None,\n            "active_connections": None,\n            "host": None,\n            "port": None,\n            "database": None,\n            "user": None,\n            "error": str(exc),\n        }\n        try:\n            config = load_database_config(config_path)\n            database_report.update(_profile_context(config))\n        except Exception:\n            pass\n        return database_report\n\n\ndef build_report(db_config: str = DEFAULT_DB_CONFIG) -> dict:\n    """Build the diagnostics dictionary from available collectors."""\n    report = {\n        "timestamp": int(time.time()),\n        "system": collect_system_metrics(),\n        "network": collect_network_metrics(),\n        "database": collect_database_diagnostics(db_config),\n    }\n    return report\n\n\ndef write_json(path: str, data: Dict[str, Any]) -> None:\n    """Write a dictionary as pretty-printed JSON, creating parent directories."""\n    output_dir = os.path.dirname(os.path.abspath(path))\n    if output_dir and not os.path.exists(output_dir):\n        os.makedirs(output_dir, exist_ok=True)\n\n    with open(path, "w") as f:\n        json.dump(data, f, indent=2)\n\n\ndef main():\n    parser = argparse.ArgumentParser(description="System Diagnostics Exporter")\n    parser.add_argument(\n        "--output",\n        "-o",\n        default=DEFAULT_OUTPUT,\n        help="Destination path for diagnostics report JSON",\n    )\n    parser.add_argument(\n        "--db-config",\n        default=DEFAULT_DB_CONFIG,\n        help="Path to database configuration file",\n    )\n    parser.add_argument(\n        "--export-profile",\n        help="Write the sanitized database connection profile JSON to this path",\n    )\n    args = parser.parse_args()\n\n    if args.export_profile:\n        try:\n            profile = connection_profile(load_database_config(args.db_config), sanitize=True)\n        except Exception as exc:\n            profile = {"status": "error", "error": str(exc)}\n        write_json(args.export_profile, profile)\n        print(f"Database connection profile written successfully to {args.export_profile}")\n\n    report = build_report(args.db_config)\n    write_json(args.output, report)\n\n    print(f"Report written successfully to {args.output}")\n\n\nif __name__ == "__main__":\n    main()\nPY\nmv /tmp/new_cli.py sysdiag/cli.py\npython -m py_compile sysdiag/cli.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
